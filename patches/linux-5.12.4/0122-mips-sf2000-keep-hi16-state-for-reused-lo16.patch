From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Wed, 13 May 2026 03:35:00 +0000
Subject: [PATCH] mips: sf2000: keep HI16 state for reused LO16 relocs

MIPS code can load one high half once and use several LO16 relocations from that register. Keep the original HI16 instruction until the next HI16 relocation so repeated LO16 entries compute the same unrelocated symbol before binfmt_flat applies the load address.

--- a/arch/mips/include/asm/flat.h	2026-05-13 03:23:31.065217428 +0000
+++ b/arch/mips/include/asm/flat.h	2026-05-13 03:31:57.011159000 +0000
@@ -13,6 +13,7 @@
 #define FLAT_MIPS_R_ADDR	0x3fffffff
 
 static u32 __user *flat_mips_hi16_rp;
+static u32 flat_mips_hi16_insn;
 
 static inline u32 flat_mips_reloc_type(u32 rel)
 {
@@ -42,7 +43,7 @@
 	case FLAT_MIPS_R_LO16:
 		lo = get_unaligned(p);
 		if (flat_mips_hi16_rp) {
-			hi = get_unaligned((__force u32 *)flat_mips_hi16_rp);
+			hi = flat_mips_hi16_insn;
 			*addr = htonl(((hi & 0xffff) << 16) +
 				      (s16)(lo & 0xffff));
 		} else {
@@ -68,6 +69,7 @@
 		return 0;
 	case FLAT_MIPS_R_HI16:
 		flat_mips_hi16_rp = rp;
+		flat_mips_hi16_insn = get_unaligned(p);
 		return 0;
 	case FLAT_MIPS_R_LO16:
 		lo = get_unaligned(p);
@@ -78,7 +80,6 @@
 			hi = (hi & 0xffff0000) |
 			     (((addr + 0x8000) >> 16) & 0xffff);
 			put_unaligned(hi, hi_p);
-			flat_mips_hi16_rp = NULL;
 		}
 		lo = (lo & 0xffff0000) | (addr & 0xffff);
 		put_unaligned(lo, p);
