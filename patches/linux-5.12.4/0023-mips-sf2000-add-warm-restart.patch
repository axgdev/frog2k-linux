From 0000000000000000000000000000000000000023 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 16:25:00 +0000
Subject: [PATCH] mips: sf2000: add watchdog restart

The generic MIPS reboot path halts when no platform restart callback is
registered. SF2000 physical testing needs a way to reboot without removing
power, both for usability and to let the next loader run dump the retained RAM
progress ring to log.txt.

Install an SF2000 restart callback that uses the same watchdog sequence as the
vendor firmware: prime WDT0_COUNT, write 100 to WDT0_CONF, then spin until the
chip resets.
---
 arch/mips/kernel/setup.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -40,6 +40,7 @@
 #include <asm/sections.h>
 #include <asm/setup.h>
 #include <asm/smp-ops.h>
+#include <asm/reboot.h>
 #include <asm/prom.h>
 
 #ifdef CONFIG_MIPS_ELF_APPENDED_DTB
@@ -137,6 +138,29 @@ static unsigned int sf2000_cp0_count(void)
 	return count;
 }
 
+static void sf2000_machine_restart(char *command)
+{
+	volatile u32 *wdt_count = (volatile u32 *)CKSEG1ADDR(0x18818500);
+	volatile u8 *wdt_conf = (volatile u8 *)CKSEG1ADDR(0x18818504);
+
+	(void)command;
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	pr_emerg("sf2000: watchdog restart\n");
+	local_irq_disable();
+	*wdt_count = 0xffffff00;
+	*wdt_conf = 100;
+	while (1)
+		;
+}
+
+static void __init sf2000_restart_init(void)
+{
+	if (IS_ENABLED(CONFIG_MIPS_SF2000))
+		_machine_restart = sf2000_machine_restart;
+}
+
 static int sf2000_rom_handoff_present(void)
 {
 	unsigned int word = *SF2000_ROM_F_MOUNT_KSEG0;
@@ -1095,6 +1119,7 @@ static inline void prefill_possible_map(void) {}
 
 void __init setup_arch(char **cmdline_p)
 {
+	sf2000_restart_init();
 	sf2000_visible_stage("mips-setup-entry", 3);
 	cpu_probe();
 	sf2000_visible_tick("mips-after-cpu-probe");
-- 
2.50.1
