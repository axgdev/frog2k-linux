From 0000000000000000000000000000000000000103 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: keep context fields for nommu

Several MIPS headers use ASID, VDSO and delay-slot emulation fields from
mm_context_t without gating those helpers on CONFIG_MMU. Keep the existing
context layout for NOMMU too and add only the FLAT loader end_brk field.
---
 arch/mips/include/asm/mmu.h | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/arch/mips/include/asm/mmu.h b/arch/mips/include/asm/mmu.h
index 59f8c9d..e00b7f1 100644
--- a/arch/mips/include/asm/mmu.h
+++ b/arch/mips/include/asm/mmu.h
@@ -6,8 +6,6 @@
 #include <linux/spinlock.h>
 #include <linux/wait.h>
 
-#ifdef CONFIG_MMU
-
 typedef struct {
 	union {
 		u64 asid[NR_CPUS];
@@ -21,11 +19,6 @@ typedef struct {
 	unsigned long *bd_emupage_allocmap;
 	/* wait queue for threads requiring an emuframe */
 	wait_queue_head_t bd_emupage_queue;
-} mm_context_t;
-
-#else
-typedef struct {
 	unsigned long end_brk;
 } mm_context_t;
-#endif
 
 #endif /* __ASM_MMU_H */
-- 
2.45.0

