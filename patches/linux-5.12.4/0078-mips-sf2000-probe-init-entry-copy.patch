From 0000000000000000000000000000000000000078 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: probe copied init entry

The physical log reaches the final copied-stub trampoline with the expected
KSEG0 stack and /init target, then watchdogs without any normal exception
trace. Split the remaining failure by instrumenting the copied identity /init
entry itself.

Patch only the copied KSEG0 identity text: replace the first words of /init
with a branch to a probe in the copied stub page. The probe records marker
0x51510009 before executing any original /init instruction, replays the first
eleven original instructions, records marker 0x5151000a after the entry
prologue, then jumps back to the original first syscall. This distinguishes an
instruction-fetch/jump failure from a first-syscall failure in one hardware
run.
---
 fs/binfmt_elf.c | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -219,10 +219,14 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 		unsigned long sp)
 {
 	u32 *stub = (u32 *)CKSEG1ADDR(SF2000_IDENTITY_STUB_ADDR);
+	u32 *entry_text = (u32 *)CKSEG1ADDR(entry);
 	unsigned long target = CKSEG0ADDR(entry);
 	unsigned long stack = CKSEG0ADDR(sp);
+	unsigned long probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
+		96 * sizeof(u32));
 	unsigned long trampoline = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
 		64 * sizeof(u32));
+	unsigned int i;
 
 	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
 		return;
@@ -264,12 +268,37 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 	stub[72] = 0x0000000f; /* sync */
 	stub[73] = 0x03600008; /* jr k1 */
 	stub[74] = 0x00000000; /* nop */
+	stub[96] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[97] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[98] = 0x377b0009; /* ori k1,k1,9 */
+	stub[99] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[100] = 0xaf5d0018; /* sw sp,24(k0) */
+	stub[101] = 0x401b6000; /* mfc0 k1,CP0_STATUS */
+	stub[102] = 0xaf5b001c; /* sw k1,28(k0) */
+	for (i = 0; i < 11; i++)
+		stub[103 + i] = entry_text[i];
+	stub[114] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[115] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[116] = 0x377b000a; /* ori k1,k1,10 */
+	stub[117] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[118] = 0xaf5d0018; /* sw sp,24(k0) */
+	stub[119] = 0xaf45001c; /* sw a1,28(k0) */
+	stub[120] = 0x3c1b0000 | (((target + 44) >> 16) & 0xffff);
+	stub[121] = 0x377b0000 | ((target + 44) & 0xffff);
+	stub[122] = 0x03600008; /* jr k1 */
+	stub[123] = 0x00000000; /* nop */
+	entry_text[0] = 0x3c1b0000 | ((probe >> 16) & 0xffff);
+	entry_text[1] = 0x377b0000 | (probe & 0xffff);
+	entry_text[2] = 0x03600008; /* jr k1 */
+	entry_text[3] = 0x00000000; /* nop */
 	flush_cache_all();
 	flush_icache_all();
 	flush_icache_range(SF2000_IDENTITY_STUB_ADDR,
 		SF2000_IDENTITY_STUB_ADDR + PAGE_SIZE);
+	flush_icache_range(entry, entry + 64);
 	sf2000_elf_value("elf-id-stub", (unsigned int)target);
 	sf2000_elf_value("elf-id-stub-sp", (unsigned int)stack);
+	sf2000_elf_value("elf-id-entry-probe", (unsigned int)probe);
 }
 
 static int sf2000_elf_copy_identity(struct file *file,
-- 
