From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Tue, 12 May 2026 05:05:00 +0000
Subject: [PATCH] mips: sf2000: refresh ErrorEPC on final userspace return

The SF2000 physical device reaches ret-syscall-exit after execing /init but
does not reach the first userspace syscall. The ERL identity-userspace path
sets CP0 ErrorEPC in start_thread(), but the actual return path restores the
saved pt_regs later and then executes eret from assembly.

For SF2000 identity userspace, log the final saved status/EPC and rewrite
CP0 ErrorEPC from pt_regs immediately before RESTORE_SOME/eret. This keeps the
diagnostic path close to the failing transition and makes the ERL return use
the same entry address as the normal EPC restore.
---
 arch/mips/kernel/entry.S   |  4 ++++
 arch/mips/kernel/process.c | 17 +++++++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/arch/mips/kernel/entry.S b/arch/mips/kernel/entry.S
--- a/arch/mips/kernel/entry.S
+++ b/arch/mips/kernel/entry.S
@@ -97,6 +97,10 @@ FEXPORT(syscall_exit)
 	bnez	t0, syscall_exit_work
 
 restore_all:				# restore full frame
+#ifdef CONFIG_MIPS_SF2000
+	move	a0, sp
+	jal	sf2000_ret_before_restore
+#endif
 	.set	noat
 	RESTORE_TEMP
 	RESTORE_AT
diff --git a/arch/mips/kernel/process.c b/arch/mips/kernel/process.c
--- a/arch/mips/kernel/process.c
+++ b/arch/mips/kernel/process.c
@@ -76,6 +76,23 @@ void sf2000_ret_syscall_exit(void)
 		sf2000_progress_mark("ret-syscall-exit", 9, 0);
 }
 
+void sf2000_ret_before_restore(struct pt_regs *regs)
+{
+	if (!sf2000_identity_userspace_enabled())
+		return;
+
+	sf2000_progress_mark("ret-restore-status", 9, regs->cp0_status);
+	sf2000_progress_mark("ret-restore-epc", 9, regs->cp0_epc);
+	if (!(regs->cp0_status & ST0_ERL))
+		return;
+
+	sf2000_progress_mark("ret-restore-errorepc-before", 9,
+		read_c0_errorepc());
+	write_c0_errorepc(regs->cp0_epc);
+	sf2000_progress_mark("ret-restore-errorepc-after", 9,
+		read_c0_errorepc());
+}
+
 void start_thread(struct pt_regs * regs, unsigned long pc, unsigned long sp)
 {
 	unsigned long status;
-- 
