From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: copy low getname strings direct

The device now reaches the first userspace syscall and resolves o32 syscall 5
to sys_open, but the raw marker stops before the syscall returns.  That first
open uses a low userspace pointer into the copied /init image.  On the
physical SF2000 path we are deliberately running /init from the copied identity
image, while normal user string copy still depends on the TLB machinery that
is not usable on this core yet.

For low /init string pointers, copy the pathname directly through the uncached
physical alias of the identity image.  Keep progress markers around sys_open,
do_sys_openat2, and getname so the next physical log shows whether the direct
path was taken and how far the VFS open path proceeds.
---
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -39,10 +39,50 @@
 #include <linux/bitops.h>
 #include <linux/init_task.h>
 #include <linux/uaccess.h>
+#include <linux/errno.h>
 
 #include "internal.h"
 #include "mount.h"
 
+#ifdef CONFIG_MIPS_SF2000
+extern void sf2000_progress_mark(const char *name, unsigned int kind,
+		unsigned int value);
+
+static int sf2000_getname_identity(char *dst, const char __user *filename,
+		int max)
+{
+	unsigned long addr = (unsigned long)filename;
+	const volatile unsigned char *src;
+	int len;
+
+	if (addr < 0x00400000UL || addr >= 0x01000000UL)
+		return -EAGAIN;
+
+	sf2000_progress_mark("getname-id-entry", 13, (unsigned int)addr);
+	src = (const volatile unsigned char *)((addr & 0x1fffffffUL) |
+		0xa0000000UL);
+	for (len = 0; len < max; len++) {
+		unsigned char c = src[len];
+
+		dst[len] = c;
+		if (!c) {
+			sf2000_progress_mark("getname-id-done", 13,
+					(unsigned int)len);
+			return len;
+		}
+	}
+
+	sf2000_progress_mark("getname-id-too-long", 13, (unsigned int)max);
+	return max;
+}
+#else
+static int sf2000_getname_identity(char *dst, const char __user *filename,
+		int max)
+{
+	return -EAGAIN;
+}
+#endif
+
 /* [Feb-1997 T. Schoebel-Theuer]
  * Fundamental changes in the pathname lookup mechanisms (namei)
  * were necessary because of omirr.  The reason is that omirr needs
@@ -146,7 +186,18 @@
 	kname = (char *)result->iname;
 	result->name = kname;
 
-	len = strncpy_from_user(kname, filename, EMBEDDED_NAME_MAX);
+	len = sf2000_getname_identity(kname, filename, EMBEDDED_NAME_MAX);
+	if (len == -EAGAIN) {
+#ifdef CONFIG_MIPS_SF2000
+		sf2000_progress_mark("getname-before-usercopy", 13,
+				(unsigned int)filename);
+#endif
+		len = strncpy_from_user(kname, filename, EMBEDDED_NAME_MAX);
+#ifdef CONFIG_MIPS_SF2000
+		sf2000_progress_mark("getname-after-usercopy", 13,
+				(unsigned int)len);
+#endif
+	}
 	if (unlikely(len < 0)) {
 		__putname(result);
 		return ERR_PTR(len);
--- a/fs/open.c
+++ b/fs/open.c
@@ -35,6 +35,18 @@
 
 #include "internal.h"
 
+#ifdef CONFIG_MIPS_SF2000
+extern void sf2000_progress_mark(const char *name, unsigned int kind,
+		unsigned int value);
+
+static void sf2000_open_mark(const char *name, unsigned int value)
+{
+	sf2000_progress_mark(name, 13, value);
+}
+#else
+static inline void sf2000_open_mark(const char *name, unsigned int value) { }
+#endif
+
 int do_truncate(struct user_namespace *mnt_userns, struct dentry *dentry,
 		loff_t length, unsigned int time_attrs, struct file *filp)
 {
@@ -1175,16 +1187,22 @@
 	int fd = build_open_flags(how, &op);
 	struct filename *tmp;
 
+	sf2000_open_mark("openat2-entry", (unsigned int)filename);
 	if (fd)
 		return fd;
 
+	sf2000_open_mark("openat2-before-getname", (unsigned int)filename);
 	tmp = getname(filename);
+	sf2000_open_mark("openat2-after-getname", (unsigned int)tmp);
 	if (IS_ERR(tmp))
 		return PTR_ERR(tmp);
 
+	sf2000_open_mark("openat2-before-unused-fd", how->flags);
 	fd = get_unused_fd_flags(how->flags);
+	sf2000_open_mark("openat2-after-unused-fd", (unsigned int)fd);
 	if (fd >= 0) {
 		struct file *f = do_filp_open(dfd, tmp, &op);
+		sf2000_open_mark("openat2-after-filp-open", (unsigned int)f);
 		if (IS_ERR(f)) {
 			put_unused_fd(fd);
 			fd = PTR_ERR(f);
@@ -1194,18 +1212,21 @@
 		}
 	}
 	putname(tmp);
+	sf2000_open_mark("openat2-return", (unsigned int)fd);
 	return fd;
 }
 
 long do_sys_open(int dfd, const char __user *filename, int flags, umode_t mode)
 {
 	struct open_how how = build_open_how(flags, mode);
+	sf2000_open_mark("do-sys-open", (unsigned int)filename);
 	return do_sys_openat2(dfd, filename, &how);
 }
 
 
 SYSCALL_DEFINE3(open, const char __user *, filename, int, flags, umode_t, mode)
 {
+	sf2000_open_mark("sys-open-entry", (unsigned int)filename);
 	if (force_o_largefile())
 		flags |= O_LARGEFILE;
 	return do_sys_open(AT_FDCWD, filename, flags, mode);
-- 
