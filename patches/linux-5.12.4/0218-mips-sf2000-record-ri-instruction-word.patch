diff --git a/arch/mips/kernel/traps.c b/arch/mips/kernel/traps.c
--- a/arch/mips/kernel/traps.c
+++ b/arch/mips/kernel/traps.c
@@ -1225,6 +1225,16 @@ asmlinkage void do_ri(struct pt_regs *regs)
 	sf2000_exception_mark("ri-cause", regs->cp0_cause);
 	sf2000_exception_mark("ri-badvaddr", read_c0_badvaddr());
 
+	/*
+	 * An HC15xx warm boot can retain an instruction-cache alias while data
+	 * loads already observe the replacement kernel.  Preserve the word seen
+	 * through the data path so retained logs distinguish that coherency fault
+	 * from a genuinely unsupported instruction.  Kernel EPCs are directly
+	 * mapped and safe to inspect here; user EPCs still use get_user below.
+	 */
+	if (!user_mode(regs))
+		sf2000_exception_mark("ri-insn-data", READ_ONCE(*epc));
+
 	/*
 	 * Avoid any kernel code. Just emulate the R2 instruction
 	 * as quickly as possible.
