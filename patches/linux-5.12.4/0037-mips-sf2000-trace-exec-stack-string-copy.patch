From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 22:00:00 +0000
Subject: [PATCH] mips: sf2000: trace exec stack string copy

The physical log now stops inside copy_string_kernel() while copying the
kernel-provided /init filename into the temporary exec stack. Trace the arg
page lookup and kernel string copy steps and skip the argument flush on SF2000.

--- a/fs/exec.c	2026-05-11 18:26:20.600253260 +0000
+++ b/fs/exec.c	2026-05-11 18:26:06.027198003 +0000
@@ -225,9 +225,11 @@
 	int ret;
 	unsigned int gup_flags = FOLL_FORCE;
 
+	sf2000_exec_value("arg-page-entry", (unsigned int)pos);
 #ifdef CONFIG_STACK_GROWSUP
 	if (write) {
 		ret = expand_downwards(bprm->vma, pos);
+		sf2000_exec_value("arg-page-expand", (unsigned int)ret);
 		if (ret < 0)
 			return NULL;
 	}
@@ -235,6 +237,7 @@
 
 	if (write)
 		gup_flags |= FOLL_WRITE;
+	sf2000_exec_value("arg-page-before-gup", gup_flags);
 
 	/*
 	 * We are doing an exec().  'current' is the process
@@ -242,11 +245,13 @@
 	 */
 	ret = get_user_pages_remote(bprm->mm, pos, 1, gup_flags,
 			&page, NULL, NULL);
+	sf2000_exec_value("arg-page-after-gup", (unsigned int)ret);
 	if (ret <= 0)
 		return NULL;
 
 	if (write)
 		acct_arg_size(bprm, vma_pages(bprm->vma));
+	sf2000_exec_value("arg-page-return", (unsigned int)page);
 
 	return page;
 }
@@ -630,6 +635,8 @@
 	int len = strnlen(arg, MAX_ARG_STRLEN) + 1 /* terminating NUL */;
 	unsigned long pos = bprm->p;
 
+	sf2000_exec_value("copy-kstr-entry", (unsigned int)pos);
+	sf2000_exec_value("copy-kstr-len", (unsigned int)len);
 	if (len == 0)
 		return -EFAULT;
 	if (!valid_arg_len(bprm, len))
@@ -651,17 +658,32 @@
 		arg -= bytes_to_copy;
 		len -= bytes_to_copy;
 
+		sf2000_exec_value("copy-kstr-before-page", (unsigned int)pos);
 		page = get_arg_page(bprm, pos, 1);
+		sf2000_exec_value("copy-kstr-after-page", page ?
+			(unsigned int)page : 0);
 		if (!page)
 			return -E2BIG;
+		sf2000_exec_mark("copy-kstr-before-kmap");
 		kaddr = kmap_atomic(page);
-		flush_arg_page(bprm, pos & PAGE_MASK, page);
+		sf2000_exec_value("copy-kstr-after-kmap", (unsigned int)kaddr);
+		if (!IS_ENABLED(CONFIG_MIPS_SF2000)) {
+			sf2000_exec_mark("copy-kstr-before-flush-arg");
+			flush_arg_page(bprm, pos & PAGE_MASK, page);
+			sf2000_exec_mark("copy-kstr-after-flush-arg");
+		}
+		sf2000_exec_mark("copy-kstr-before-memcpy");
 		memcpy(kaddr + offset_in_page(pos), arg, bytes_to_copy);
+		sf2000_exec_mark("copy-kstr-after-memcpy");
 		flush_kernel_dcache_page(page);
+		sf2000_exec_mark("copy-kstr-after-flush-dcache");
 		kunmap_atomic(kaddr);
+		sf2000_exec_mark("copy-kstr-after-kunmap");
 		put_arg_page(page);
+		sf2000_exec_mark("copy-kstr-after-put-page");
 	}
 
+	sf2000_exec_mark("copy-kstr-done");
 	return 0;
 }
 EXPORT_SYMBOL(copy_string_kernel);

-- 
2.50.1
