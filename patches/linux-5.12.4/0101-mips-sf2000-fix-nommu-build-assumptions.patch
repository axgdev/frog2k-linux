From 0000000000000000000000000000000000000101 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: fix nommu build assumptions

The MIPS fault handler and exec cache flush declarations still assume an MMU
kernel. Avoid compiling the vmalloc page-table synchronization block when
CONFIG_MMU is disabled, and provide the generic user icache flush alias used
by exec code in NOMMU builds.
---
 arch/mips/include/asm/cacheflush.h | 4 ++++
 arch/mips/mm/fault.c               | 4 +++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/arch/mips/include/asm/cacheflush.h b/arch/mips/include/asm/cacheflush.h
index 205fb4d..a491ed3 100644
--- a/arch/mips/include/asm/cacheflush.h
+++ b/arch/mips/include/asm/cacheflush.h
@@ -85,6 +85,10 @@ extern void (*__flush_icache_user_range)(unsigned long start,
 extern void (*__local_flush_icache_user_range)(unsigned long start,
 					       unsigned long end);
 
+#ifndef CONFIG_MMU
+#define flush_icache_user_range flush_icache_range
+#endif
+
 extern void (*__flush_cache_vmap)(void);
 
 static inline void flush_cache_vmap(unsigned long start, unsigned long end)
diff --git a/arch/mips/mm/fault.c b/arch/mips/mm/fault.c
index 295eefb..8b44e34 100644
--- a/arch/mips/mm/fault.c
+++ b/arch/mips/mm/fault.c
@@ -104,8 +104,10 @@ static void __kprobes __do_page_fault(struct pt_regs *regs, unsigned long write,
 	 */
 #ifdef CONFIG_64BIT
 # define VMALLOC_FAULT_TARGET no_context
-#else
+#elif defined(CONFIG_MMU)
 # define VMALLOC_FAULT_TARGET vmalloc_fault
+#else
+# define VMALLOC_FAULT_TARGET no_context
 #endif
 
 	if (unlikely(address >= VMALLOC_START && address <= VMALLOC_END))
@@ -302,7 +304,7 @@ do_sigbus:
 
 	return;
 #ifndef CONFIG_64BIT
-vmalloc_fault:
+#ifdef CONFIG_MMU
 	{
 		/*
 		 * Synchronize this task's top level page-table
@@ -353,6 +355,7 @@ vmalloc_fault:
 		return;
 	}
 #endif
+#endif
 }
 
 asmlinkage void __kprobes do_page_fault(struct pt_regs *regs,
-- 
2.45.0

