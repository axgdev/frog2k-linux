From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 23:00:00 +0000
Subject: [PATCH] mips: sf2000: install exec arg page directly

The physical log stops inside get_user_pages_remote() while faulting in the
first temporary exec stack page for /init. Avoid the generic remote GUP fault
path on SF2000 by allocating and installing the anonymous argument page under
the target mm page tables directly, with breadcrumbs around each step.

--- a/fs/exec.c	2026-05-11 18:41:49.315927880 +0000
+++ b/fs/exec.c	2026-05-11 18:41:24.944404008 +0000
@@ -65,6 +65,7 @@
 #include <linux/vmalloc.h>
 #include <linux/io_uring.h>
 #include <linux/syscall_user_dispatch.h>
+#include <linux/rmap.h>
 
 #include <linux/uaccess.h>
 #include <asm/mmu_context.h>
@@ -218,6 +219,96 @@
 	add_mm_counter(mm, MM_ANONPAGES, diff);
 }
 
+#ifdef CONFIG_MIPS
+static struct page *sf2000_get_arg_page_direct(struct linux_binprm *bprm,
+		unsigned long pos)
+{
+	struct mm_struct *mm = bprm->mm;
+	struct vm_area_struct *vma = bprm->vma;
+	unsigned long addr = pos & PAGE_MASK;
+	struct page *page = NULL;
+	spinlock_t *ptl;
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+	pte_t entry;
+	int ret;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return NULL;
+
+	sf2000_exec_value("arg-direct-entry", (unsigned int)addr);
+	mmap_write_lock(mm);
+	if (addr < vma->vm_start || addr >= vma->vm_end) {
+		sf2000_exec_mark("arg-direct-range-fail");
+		goto out_unlock_mmap;
+	}
+
+	ret = anon_vma_prepare(vma);
+	sf2000_exec_value("arg-direct-anon-vma", (unsigned int)ret);
+	if (ret)
+		goto out_unlock_mmap;
+
+	pgd = pgd_offset(mm, addr);
+	p4d = p4d_alloc(mm, pgd, addr);
+	sf2000_exec_value("arg-direct-p4d", (unsigned int)p4d);
+	if (!p4d)
+		goto out_unlock_mmap;
+	pud = pud_alloc(mm, p4d, addr);
+	sf2000_exec_value("arg-direct-pud", (unsigned int)pud);
+	if (!pud)
+		goto out_unlock_mmap;
+	pmd = pmd_alloc(mm, pud, addr);
+	sf2000_exec_value("arg-direct-pmd", (unsigned int)pmd);
+	if (!pmd)
+		goto out_unlock_mmap;
+	pte = pte_alloc_map_lock(mm, pmd, addr, &ptl);
+	sf2000_exec_value("arg-direct-pte", (unsigned int)pte);
+	if (!pte)
+		goto out_unlock_mmap;
+
+	if (!pte_none(*pte)) {
+		page = pte_page(*pte);
+		get_page(page);
+		sf2000_exec_value("arg-direct-existing", (unsigned int)page);
+		goto out_unlock_pte;
+	}
+
+	page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	sf2000_exec_value("arg-direct-alloc", (unsigned int)page);
+	if (!page)
+		goto out_unlock_pte;
+
+	__SetPageUptodate(page);
+	entry = mk_pte(page, vma->vm_page_prot);
+	if (vma->vm_flags & VM_WRITE)
+		entry = pte_mkwrite(pte_mkdirty(entry));
+	add_mm_counter(mm, MM_ANONPAGES, 1);
+	page_add_new_anon_rmap(page, vma, addr, false);
+	lru_cache_add_inactive_or_unevictable(page, vma);
+	set_pte_at(mm, addr, pte, entry);
+	get_page(page);
+	sf2000_exec_value("arg-direct-installed", (unsigned int)page);
+
+out_unlock_pte:
+	pte_unmap_unlock(pte, ptl);
+out_unlock_mmap:
+	mmap_write_unlock(mm);
+	if (page)
+		acct_arg_size(bprm, vma_pages(vma));
+	sf2000_exec_value("arg-direct-return", (unsigned int)page);
+	return page;
+}
+#else
+static inline struct page *sf2000_get_arg_page_direct(
+		struct linux_binprm *bprm, unsigned long pos)
+{
+	return NULL;
+}
+#endif
+
 static struct page *get_arg_page(struct linux_binprm *bprm, unsigned long pos,
 		int write)
 {
@@ -238,6 +329,8 @@
 	if (write)
 		gup_flags |= FOLL_WRITE;
 	sf2000_exec_value("arg-page-before-gup", gup_flags);
+	if (write && IS_ENABLED(CONFIG_MIPS_SF2000))
+		return sf2000_get_arg_page_direct(bprm, pos);
 
 	/*
 	 * We are doing an exec().  'current' is the process

