+static int sf2000_elf_copy_identity_segment(struct file *file,
+		const struct elf_phdr *phdr)
+{
+	unsigned long vaddr = phdr->p_vaddr;
+	unsigned long filesz = phdr->p_filesz;
+	unsigned long memsz = phdr->p_memsz;
+	unsigned long done = 0;
+	unsigned char *buf;
+	loff_t pos = phdr->p_offset;
+
+	if (vaddr >= KSEG0 || filesz > memsz)
+		return -EINVAL;
+
+	sf2000_elf_value("elf-id-seg-vaddr", (unsigned int)vaddr);
+	sf2000_elf_value("elf-id-seg-filesz", (unsigned int)filesz);
+	sf2000_elf_value("elf-id-seg-memsz", (unsigned int)memsz);
+	buf = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	while (done < filesz) {
+		unsigned long chunk = min_t(unsigned long, PAGE_SIZE,
+			filesz - done);
+		void *dst = (void *)CKSEG1ADDR(vaddr + done);
+		int ret;
+
+		ret = kernel_read(file, buf, chunk, &pos);
+		sf2000_elf_value("elf-id-read-ret", (unsigned int)ret);
+		if (ret < 0) {
+			kfree(buf);
+			return ret;
+		}
+		if (ret == 0) {
+			kfree(buf);
+			return -EIO;
+		}
+		memcpy(dst, buf, ret);
+		done += ret;
+	}
+	kfree(buf);
+
+	if (memsz > filesz)
+		memset((void *)CKSEG1ADDR(vaddr + filesz), 0, memsz - filesz);
+	flush_cache_all();
+	flush_icache_all();
+	flush_icache_range(vaddr, vaddr + memsz);
+	sf2000_elf_value("elf-id-done", (unsigned int)vaddr);
+	return 0;
+}
