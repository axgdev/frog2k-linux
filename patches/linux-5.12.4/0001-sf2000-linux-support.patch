diff --git a/drivers/misc/sf2000-ge.c b/drivers/misc/sf2000-ge.c
new file mode 100644
index 000000000..876915b90
--- /dev/null
+++ b/drivers/misc/sf2000-ge.c
@@ -0,0 +1,441 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* Hichip HC15xx/SF2000 command-queue graphics engine. */
+
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+#include <linux/uaccess.h>
+
+#define SF2000_GE_QUEUE_SIZE	0x3c000u
+#define SF2000_GE_MINOR		243
+#define SF2000_GE_CTRL		0x00
+#define SF2000_GE_START		0x04
+#define SF2000_GE_STATUS		0x08
+#define SF2000_GE_HQ_FIRST	0x10
+#define SF2000_GE_HQ_LAST	0x14
+
+#define SF2000_GE_CTRL_SW_MEMORY	BIT(31)
+#define SF2000_GE_CTRL_HQ_IRQ	BIT(17)
+#define SF2000_GE_START_HQ	BIT(1)
+#define SF2000_GE_STATUS_BUSY	BIT(31)
+
+#define SF2000_SYS_GATE1	0x64
+#define SF2000_SYS_CLK		0x7c
+#define SF2000_SYS_RESET		0x80
+#define SF2000_SYS_GE_GATE	BIT(4)
+#define SF2000_SYS_GE_RESET	BIT(4)
+#define SF2000_SYS_GE_CLK_SHIFT	18
+
+#define HCGE_IOCBASE		35
+#define HCGE_REQUEST_IRQ	_IO(HCGE_IOCBASE, 0x01)
+#define HCGE_FREE_IRQ		_IO(HCGE_IOCBASE, 0x02)
+#define HCGE_RESET		_IO(HCGE_IOCBASE, 0x03)
+#define HCGE_SYNC_TIMEOUT	_IO(HCGE_IOCBASE, 0x04)
+#define HCGE_GET_CMDQ_BUFINFO	_IO(HCGE_IOCBASE, 0x05)
+#define HCGE_SET_CLOCK		_IO(HCGE_IOCBASE, 0x06)
+#define HCGE_GET_GE_REGISTER	_IO(HCGE_IOCBASE, 0x07)
+#define HCGE_SUBMIT		_IO(HCGE_IOCBASE, 0x08)
+#define HCGE_CACHE_CLEAN	_IO(HCGE_IOCBASE, 0x09)
+#define HCGE_CACHE_CLEAN_BATCH	_IO(HCGE_IOCBASE, 0x0a)
+#define HCGE_CACHE_BATCH_MAX	8
+
+struct hcge_cmdq_buf_info {
+	u32 addr;
+	u32 size;
+};
+
+struct hcge_submit {
+	u32 data;
+	u32 length;
+};
+
+struct hcge_cache_range {
+	u32 address;
+	u32 length;
+};
+
+struct hcge_cache_batch {
+	u32 count;
+	struct hcge_cache_range ranges[HCGE_CACHE_BATCH_MAX];
+};
+
+struct hcge_cmdq_node_ctx {
+	u32 phy_addr_min;
+	u32 phy_addr_max;
+	u32 is_finish;
+	u32 serial_num;
+	u32 is_reset;
+	u32 point_wrap_addr;
+	u32 phy_addr_start;
+	u32 reserved;
+	u32 clut_tbl[256];
+} __aligned(8);
+
+struct sf2000_ge {
+	struct device *dev;
+	void __iomem *regs;
+	void __iomem *sys;
+	void *queue;
+	dma_addr_t queue_dma;
+	struct completion done;
+	struct miscdevice misc;
+	struct mutex submit_lock;
+	spinlock_t queue_lock;
+	u32 queue_next;
+	u32 pending_first;
+	u32 pending_last;
+	bool queue_started;
+	int irq;
+	bool irq_requested;
+};
+
+static void sf2000_ge_clock_enable(struct sf2000_ge *ge)
+{
+	u32 value = readl(ge->sys + SF2000_SYS_GATE1);
+
+	/* HC15xx clock gates are active high: clear the bit to enable GE. */
+	writel(value & ~SF2000_SYS_GE_GATE, ge->sys + SF2000_SYS_GATE1);
+	value = readl(ge->sys + SF2000_SYS_CLK);
+	value &= ~(3u << SF2000_SYS_GE_CLK_SHIFT);
+	value |= 3u << SF2000_SYS_GE_CLK_SHIFT;
+	writel(value, ge->sys + SF2000_SYS_CLK);
+}
+
+static void sf2000_ge_hw_reset(struct sf2000_ge *ge)
+{
+	u32 value = readl(ge->sys + SF2000_SYS_RESET);
+
+	sf2000_ge_clock_enable(ge);
+	writel(value | SF2000_SYS_GE_RESET, ge->sys + SF2000_SYS_RESET);
+	udelay(10);
+	writel(value & ~SF2000_SYS_GE_RESET, ge->sys + SF2000_SYS_RESET);
+}
+
+static irqreturn_t sf2000_ge_irq(int irq, void *data)
+{
+	struct sf2000_ge *ge = data;
+	struct hcge_cmdq_node_ctx *ctx = ge->queue;
+	u32 status = readl(ge->regs + SF2000_GE_STATUS);
+	unsigned long flags;
+	u32 value;
+
+	if (!status)
+		return IRQ_NONE;
+	writel(status, ge->regs + SF2000_GE_STATUS);
+	ctx->serial_num++;
+	spin_lock_irqsave(&ge->queue_lock, flags);
+	if (ge->pending_first) {
+		writel(ge->pending_first, ge->regs + SF2000_GE_HQ_FIRST);
+		writel(ge->pending_last, ge->regs + SF2000_GE_HQ_LAST);
+		ge->pending_first = 0;
+		ge->pending_last = 0;
+		value = readl(ge->regs + SF2000_GE_START);
+		writel((value & ~3u) | SF2000_GE_START_HQ,
+		       ge->regs + SF2000_GE_START);
+		spin_unlock_irqrestore(&ge->queue_lock, flags);
+		return IRQ_HANDLED;
+	}
+	spin_unlock_irqrestore(&ge->queue_lock, flags);
+	if (readl(ge->regs + SF2000_GE_HQ_FIRST) ==
+	    (ctx->phy_addr_start & ~1u)) {
+		ctx->is_finish = 1;
+		complete(&ge->done);
+	}
+	return IRQ_HANDLED;
+}
+
+static int sf2000_ge_open(struct inode *inode, struct file *file)
+{
+	struct miscdevice *misc = file->private_data;
+	struct sf2000_ge *ge = container_of(misc, struct sf2000_ge, misc);
+
+	file->private_data = ge;
+	return 0;
+}
+
+static long sf2000_ge_ioctl(struct file *file, unsigned int cmd,
+			    unsigned long arg)
+{
+	struct sf2000_ge *ge = file->private_data;
+	struct hcge_cmdq_node_ctx *ctx = ge->queue;
+	u32 value;
+
+	switch (cmd) {
+	case HCGE_REQUEST_IRQ:
+		if (ge->irq_requested)
+			return 0;
+		value = request_irq(ge->irq, sf2000_ge_irq, 0,
+				    dev_name(ge->dev), ge);
+		if (value)
+			return (int)value;
+		ge->irq_requested = true;
+		return 0;
+	case HCGE_FREE_IRQ:
+		if (ge->irq_requested) {
+			free_irq(ge->irq, ge);
+			ge->irq_requested = false;
+		}
+		return 0;
+	case HCGE_RESET:
+		sf2000_ge_hw_reset(ge);
+		value = readl(ge->regs + SF2000_GE_CTRL);
+		value |= SF2000_GE_CTRL_SW_MEMORY | SF2000_GE_CTRL_HQ_IRQ;
+		writel(value, ge->regs + SF2000_GE_CTRL);
+		memset(ge->queue, 0, SF2000_GE_QUEUE_SIZE);
+		ctx->phy_addr_min = (u32)ge->queue_dma + sizeof(*ctx);
+		ctx->phy_addr_max = (u32)ge->queue_dma + SF2000_GE_QUEUE_SIZE;
+		ctx->phy_addr_start = ctx->phy_addr_min;
+		ctx->is_reset = 1;
+		ge->queue_next = ctx->phy_addr_min;
+		ge->pending_first = 0;
+		ge->pending_last = 0;
+		ge->queue_started = false;
+		writel(ctx->phy_addr_min, ge->regs + SF2000_GE_HQ_FIRST);
+		writel(ctx->phy_addr_min, ge->regs + SF2000_GE_HQ_LAST);
+		return 0;
+	case HCGE_SYNC_TIMEOUT: {
+		unsigned long timeout = msecs_to_jiffies(arg ? arg : 1000);
+		u32 first = readl(ge->regs + SF2000_GE_HQ_FIRST);
+
+		if (ctx->is_finish ||
+		    (!(readl(ge->regs + SF2000_GE_STATUS) & SF2000_GE_STATUS_BUSY) &&
+		     first == (ctx->phy_addr_start & ~1u)))
+			return 0;
+		return wait_for_completion_interruptible_timeout(&ge->done, timeout) > 0 ?
+			0 : -ETIMEDOUT;
+	}
+	case HCGE_GET_CMDQ_BUFINFO: {
+		struct hcge_cmdq_buf_info info = {
+			.addr = (u32)ge->queue_dma,
+			.size = SF2000_GE_QUEUE_SIZE,
+		};
+
+		return copy_to_user((void __user *)arg, &info, sizeof(info)) ?
+			-EFAULT : 0;
+	}
+	case HCGE_SET_CLOCK:
+		value = readl(ge->sys + SF2000_SYS_CLK);
+		value &= ~(3u << SF2000_SYS_GE_CLK_SHIFT);
+		value |= (arg & 3u) << SF2000_SYS_GE_CLK_SHIFT;
+		writel(value, ge->sys + SF2000_SYS_CLK);
+		return 0;
+	case HCGE_GET_GE_REGISTER:
+		value = 0x18806000u;
+		return copy_to_user((void __user *)arg, &value, sizeof(value)) ?
+			-EFAULT : 0;
+	case HCGE_SUBMIT: {
+		struct hcge_submit submit;
+		u32 offset = sizeof(*ctx);
+		u32 first;
+		u32 last;
+		u32 queue_end = (u32)ge->queue_dma + SF2000_GE_QUEUE_SIZE;
+		bool busy;
+		unsigned long flags;
+		long ret = 0;
+
+		if (copy_from_user(&submit, (void __user *)arg, sizeof(submit)))
+			return -EFAULT;
+		if (!submit.data || (submit.length & 3u) || !submit.length ||
+		    submit.length > SF2000_GE_QUEUE_SIZE - offset)
+			return -EINVAL;
+		mutex_lock(&ge->submit_lock);
+		/*
+		 * HQ_FIRST is the queue consumer, not a reusable descriptor base.
+		 * Hardware advances it after each node.  Keep the producer monotonic
+		 * exactly like vendor hcge_feed_nodes()/hcge_start(); rewinding it on
+		 * every submission leaves real HC15xx hardware with no new work.
+		 */
+		busy = readl(ge->regs + SF2000_GE_STATUS) & SF2000_GE_STATUS_BUSY;
+		if (!ge->queue_next || ge->queue_next < (u32)ge->queue_dma + offset ||
+		    ge->queue_next > queue_end)
+			ge->queue_next = (u32)ge->queue_dma + offset;
+		if (submit.length > queue_end - ge->queue_next) {
+			if (busy || READ_ONCE(ge->pending_first)) {
+				ret = -EBUSY;
+				goto submit_out;
+			}
+			ge->queue_next = (u32)ge->queue_dma + offset;
+		}
+		first = ge->queue_next;
+		offset = first - (u32)ge->queue_dma;
+		if (copy_from_user((u8 *)ge->queue + offset,
+				   (void __user *)(unsigned long)submit.data,
+				   submit.length)) {
+			ret = -EFAULT;
+			goto submit_out;
+		}
+		last = first + submit.length - sizeof(u32);
+		ge->queue_next = first + submit.length;
+		reinit_completion(&ge->done);
+		ctx->is_finish = 0;
+		ctx->is_reset = 0;
+		ctx->phy_addr_start = ge->queue_next;
+		wmb();
+		/* HC15xx latches HQ_LAST at start.  Accumulate a second segment while
+		 * busy and launch it from the completion IRQ instead of polling here. */
+		spin_lock_irqsave(&ge->queue_lock, flags);
+		busy = readl(ge->regs + SF2000_GE_STATUS) & SF2000_GE_STATUS_BUSY;
+		if (busy) {
+			if (!ge->pending_first)
+				ge->pending_first = first;
+			ge->pending_last = last;
+		} else {
+			writel(first, ge->regs + SF2000_GE_HQ_FIRST);
+			writel(last, ge->regs + SF2000_GE_HQ_LAST);
+			value = readl(ge->regs + SF2000_GE_START);
+			writel((value & ~3u) | SF2000_GE_START_HQ,
+			       ge->regs + SF2000_GE_START);
+		}
+		spin_unlock_irqrestore(&ge->queue_lock, flags);
+		ge->queue_started = true;
+submit_out:
+		mutex_unlock(&ge->submit_lock);
+		return ret;
+	}
+	case HCGE_CACHE_CLEAN: {
+		struct hcge_cache_range range;
+
+		if (copy_from_user(&range, (void __user *)arg, sizeof(range)))
+			return -EFAULT;
+		if (!range.address || !range.length ||
+		    range.address + range.length < range.address)
+			return -EINVAL;
+		dma_sync_single_for_device(ge->dev, range.address, range.length,
+					   DMA_TO_DEVICE);
+		return 0;
+	}
+	case HCGE_CACHE_CLEAN_BATCH: {
+		struct hcge_cache_batch batch;
+		u32 i;
+
+		if (copy_from_user(&batch, (void __user *)arg, sizeof(batch)))
+			return -EFAULT;
+		if (!batch.count || batch.count > HCGE_CACHE_BATCH_MAX)
+			return -EINVAL;
+		for (i = 0; i < batch.count; ++i) {
+			struct hcge_cache_range *range = &batch.ranges[i];
+
+			if (!range->address || !range->length ||
+			    range->address + range->length < range->address)
+				return -EINVAL;
+		}
+		for (i = 0; i < batch.count; ++i)
+			dma_sync_single_for_device(ge->dev,
+				batch.ranges[i].address, batch.ranges[i].length,
+				DMA_TO_DEVICE);
+		return 0;
+	}
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations sf2000_ge_fops = {
+	.owner = THIS_MODULE,
+	.open = sf2000_ge_open,
+	.unlocked_ioctl = sf2000_ge_ioctl,
+	.llseek = no_llseek,
+};
+
+static int sf2000_ge_probe(struct platform_device *pdev)
+{
+	struct sf2000_ge *ge;
+	struct resource sys_res;
+	struct hcge_cmdq_node_ctx *ctx;
+	u32 ctrl;
+	int ret;
+
+	ge = devm_kzalloc(&pdev->dev, sizeof(*ge), GFP_KERNEL);
+	if (!ge)
+		return -ENOMEM;
+	ge->dev = &pdev->dev;
+	ge->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ge->regs))
+		return PTR_ERR(ge->regs);
+	ret = of_address_to_resource(pdev->dev.of_node, 1, &sys_res);
+	if (ret)
+		return ret;
+	ge->sys = devm_ioremap(&pdev->dev, sys_res.start,
+				resource_size(&sys_res));
+	if (!ge->sys)
+		return -ENOMEM;
+
+	ge->queue = dmam_alloc_coherent(&pdev->dev, SF2000_GE_QUEUE_SIZE,
+					 &ge->queue_dma, GFP_KERNEL);
+	if (!ge->queue)
+		return -ENOMEM;
+	if (upper_32_bits(ge->queue_dma))
+		return -ERANGE;
+
+	ctx = ge->queue;
+	ctx->phy_addr_min = (u32)ge->queue_dma + sizeof(*ctx);
+	ctx->phy_addr_max = (u32)ge->queue_dma + SF2000_GE_QUEUE_SIZE;
+	ctx->phy_addr_start = ctx->phy_addr_min;
+	ctx->is_finish = 1;
+	ge->queue_next = ctx->phy_addr_min;
+	init_completion(&ge->done);
+	mutex_init(&ge->submit_lock);
+	spin_lock_init(&ge->queue_lock);
+
+	ge->irq = platform_get_irq(pdev, 0);
+	if (ge->irq < 0)
+		return ge->irq;
+	sf2000_ge_clock_enable(ge);
+	sf2000_ge_hw_reset(ge);
+	ctrl = readl(ge->regs + SF2000_GE_CTRL);
+	ctrl |= SF2000_GE_CTRL_SW_MEMORY | SF2000_GE_CTRL_HQ_IRQ;
+	writel(ctrl, ge->regs + SF2000_GE_CTRL);
+
+	/* Keep /dev/ge stable on the static-device NOMMU root filesystem. */
+	ge->misc.minor = SF2000_GE_MINOR;
+	ge->misc.name = "ge";
+	ge->misc.fops = &sf2000_ge_fops;
+	ge->misc.parent = &pdev->dev;
+	ret = misc_register(&ge->misc);
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, ge);
+	dev_info(&pdev->dev, "HC15xx GE queue at %pad size %#x\n",
+		 &ge->queue_dma, SF2000_GE_QUEUE_SIZE);
+	return 0;
+}
+
+static int sf2000_ge_remove(struct platform_device *pdev)
+{
+	struct sf2000_ge *ge = platform_get_drvdata(pdev);
+
+	if (ge->irq_requested)
+		free_irq(ge->irq, ge);
+	misc_deregister(&ge->misc);
+	return 0;
+}
