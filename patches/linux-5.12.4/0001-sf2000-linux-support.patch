+
+static void sf2000_exit_task(void)
+{
+	unsigned int word;
+	unsigned int i;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	sf2000_exit_value("exit-pid", (unsigned int)current->pid);
+	for (i = 0; i < TASK_COMM_LEN; i += 4) {
+		memcpy(&word, current->comm + i, sizeof(word));
+		switch (i) {
+		case 0: sf2000_exit_value("exit-comm-w0", word); break;
+		case 4: sf2000_exit_value("exit-comm-w1", word); break;
+		case 8: sf2000_exit_value("exit-comm-w2", word); break;
+		case 12: sf2000_exit_value("exit-comm-w3", word); break;
+		}
+	}
+}
+#else
+static void sf2000_exit_value(const char *name, unsigned int value) {}
+static void sf2000_exit_task(void) {}
+#endif
