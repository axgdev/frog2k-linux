+	sf2000_identity_init_pc = CKSEG0ADDR(*pc);
+	sf2000_identity_init_sp = CKSEG0ADDR(*sp);
+	*pc = sf2000_identity_init_pc;
+	*sp = sf2000_identity_init_sp;
