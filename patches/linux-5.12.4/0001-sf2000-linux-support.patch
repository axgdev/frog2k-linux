+static void __init sf2000_restart_init(void)
+{
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		_machine_restart = sf2000_machine_restart;
+		pm_power_off = sf2000_machine_power_off;
+	}
+}
