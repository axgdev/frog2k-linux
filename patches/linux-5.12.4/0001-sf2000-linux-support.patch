+	{ .compatible = "hichip,hc15xx-ge" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sf2000_ge_of_match);
+
+static struct platform_driver sf2000_ge_driver = {
+	.probe = sf2000_ge_probe,
+	.remove = sf2000_ge_remove,
+	.driver = {
+		.name = "sf2000-ge",
+		.of_match_table = sf2000_ge_of_match,
+	},
+};
+module_platform_driver(sf2000_ge_driver);
