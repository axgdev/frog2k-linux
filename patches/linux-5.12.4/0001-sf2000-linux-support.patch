+static int sf2000_elf_copy_identity_stack(unsigned long *sp)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	struct page *page = NULL;
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+	void *src;
+	void *dst;
+	unsigned long src_phys;
+	unsigned long mapped;
+	unsigned long src_addr = *sp & PAGE_MASK;
+	unsigned long low_sp = SF2000_IDENTITY_STACK_PAGE +
+		(*sp & ~PAGE_MASK);
+	int ret = 0;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return 0;
+
+	sf2000_elf_value("elf-id-stack-src", (unsigned int)*sp);
+	sf2000_elf_value("elf-id-stack-low", (unsigned int)low_sp);
+
+	mmap_read_lock(mm);
+	pgd = pgd_offset(mm, src_addr);
+	if (pgd_none(*pgd) || pgd_bad(*pgd)) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+	p4d = p4d_offset(pgd, src_addr);
+	if (p4d_none(*p4d) || p4d_bad(*p4d)) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+	pud = pud_offset(p4d, src_addr);
+	if (pud_none(*pud) || pud_bad(*pud)) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+	pmd = pmd_offset(pud, src_addr);
+	if (pmd_none(*pmd) || pmd_bad(*pmd)) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+	pte = pte_offset_map(pmd, src_addr);
+	if (!pte) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+	if (!pte_present(*pte)) {
+		ret = -EFAULT;
+		goto out_pte;
+	}
+	sf2000_elf_value("elf-id-stack-pte", (unsigned int)pte_val(*pte));
+	page = pte_page(*pte);
+	get_page(page);
+out_pte:
+	pte_unmap(pte);
+out_unlock:
+	mmap_read_unlock(mm);
+	if (ret)
+		return ret;
+
+	src_phys = (unsigned long)page_to_phys(page);
+	sf2000_elf_value("elf-id-stack-phys", (unsigned int)src_phys);
+	src = (void *)CKSEG1ADDR(src_phys);
+	sf2000_elf_value("elf-id-stack-copy-src", (unsigned int)src);
+	dst = (void *)CKSEG1ADDR(SF2000_IDENTITY_STACK_BASE);
+	memset(dst, 0, SF2000_IDENTITY_STACK_SIZE);
+	dst = (void *)CKSEG1ADDR(SF2000_IDENTITY_STACK_PAGE);
+	memcpy(dst, src, PAGE_SIZE);
+	put_page(page);
+	flush_cache_all();
+	mapped = vm_mmap(NULL, SF2000_IDENTITY_STACK_BASE,
+		SF2000_IDENTITY_STACK_SIZE,
+		PROT_READ | PROT_WRITE,
+		MAP_FIXED | MAP_PRIVATE | MAP_ANONYMOUS, 0);
+	sf2000_elf_value("elf-id-stack-mmap", (unsigned int)mapped);
+	if (IS_ERR_VALUE(mapped))
+		return (int)mapped;
+	mmap_write_lock(mm);
+	vma = find_vma(mm, SF2000_IDENTITY_STACK_BASE);
+	sf2000_elf_value("elf-id-stack-vma", (unsigned int)vma);
+	if (!vma || vma->vm_start > SF2000_IDENTITY_STACK_BASE)
+		ret = -EFAULT;
+	else
+		ret = remap_pfn_range(vma, SF2000_IDENTITY_STACK_BASE,
+			SF2000_IDENTITY_STACK_BASE >> PAGE_SHIFT,
+			SF2000_IDENTITY_STACK_SIZE, vma->vm_page_prot);
+	if (!ret) {
+		pgd = pgd_offset(mm, SF2000_IDENTITY_STACK_PAGE);
+		p4d = p4d_offset(pgd, SF2000_IDENTITY_STACK_PAGE);
+		pud = pud_offset(p4d, SF2000_IDENTITY_STACK_PAGE);
+		pmd = pmd_offset(pud, SF2000_IDENTITY_STACK_PAGE);
+		pte = pte_offset_map(pmd, SF2000_IDENTITY_STACK_PAGE);
+		if (pte) {
+			sf2000_elf_value("elf-stack-pte",
+					(unsigned int)pte_val(*pte));
+			sf2000_elf_mark("elf-stack-skip-random-tlb");
+			pte_unmap(pte);
+		}
+	}
+	mmap_write_unlock(mm);
+	sf2000_elf_value("elf-id-stack-remap", (unsigned int)ret);
+	if (ret)
+		return ret;
+	*sp = CKSEG1ADDR(low_sp);
+	sf2000_identity_init_sp = *sp;
+	sf2000_elf_value("elf-id-stack-global",
+		(unsigned int)sf2000_identity_init_sp);
+	sf2000_elf_value("elf-id-stack-done", (unsigned int)*sp);
+	return 0;
+}
