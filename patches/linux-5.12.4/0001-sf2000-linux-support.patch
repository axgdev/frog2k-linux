+static int sf2000_elf_copy_identity(struct file *file,
+		const struct elf_phdr *phdrs, int phnum, unsigned long entry)
+{
+	int i;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return 0;
+
+	sf2000_elf_mark("elf-id-copy-entry");
+	for (i = 0; i < phnum; i++) {
+		int ret;
+
+		if (phdrs[i].p_type != PT_LOAD)
+			continue;
+		ret = sf2000_elf_copy_identity_segment(file, &phdrs[i]);
+		sf2000_elf_value("elf-id-copy-ret", (unsigned int)ret);
+		if (ret)
+			return ret;
+	}
+	sf2000_elf_mark("elf-id-copy-done");
+	return 0;
+}
