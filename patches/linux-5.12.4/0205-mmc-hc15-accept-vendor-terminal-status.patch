From: SF2000 Linux project
Subject: [PATCH] mmc: hc15: accept the captured terminal command status

Real-device and stock-firmware traces show CMDSTS=0xe4 after a successful
HC15xx command.  The provisional Linux bit decoder treated each set bit as an
independent error and rejected every data command once QEMU learned the real
terminal state.  Preserve the raw status for diagnostics, but recognize 0xe4
as the successful terminal engine state before decoding actual error values.

---
 drivers/mmc/host/hc15_mmc.c | 39 ++++++++++++++++++++++++---------------
 1 file changed, 24 insertions(+), 15 deletions(-)

diff --git a/drivers/mmc/host/hc15_mmc.c b/drivers/mmc/host/hc15_mmc.c
--- a/drivers/mmc/host/hc15_mmc.c
+++ b/drivers/mmc/host/hc15_mmc.c
@@ -372,22 +372,31 @@ static int hc15_wait_irq(struct hc15_mmc *host, struct mmc_command *cmd,
 	status = readb(host->base + HC15_REG_CMDSTS);
 	writeb(irq, host->base + HC15_REG_IRQSTS);
 
-	if (status & 0x01)
-		norm |= 0x01;
-	if (status & 0x02)
-		norm |= 0x02;
-	if (status & 0x08)
-		norm |= 0x04;
-	if (status & 0x10)
-		norm |= 0x08;
-	if (status & 0x40)
-		norm |= 0x10;
-	if (status & 0x04)
-		norm |= 0x20;
-	if (status & 0x20)
-		norm |= 0x40;
-	if (status & 0x80)
-		norm |= 0x80;
+	/*
+	 * The vendor controller reports 0xe4 after a command completes
+	 * successfully.  Those high bits are a terminal engine state, not the
+	 * individual CRC/timeout flags used by the provisional decoder below.
+	 * Keep recording the raw byte, but do not turn the captured success state
+	 * into a synthetic command error.
+	 */
+	if (status != 0xe4) {
+		if (status & 0x01)
+			norm |= 0x01;
+		if (status & 0x02)
+			norm |= 0x02;
+		if (status & 0x08)
+			norm |= 0x04;
+		if (status & 0x10)
+			norm |= 0x08;
+		if (status & 0x40)
+			norm |= 0x10;
+		if (status & 0x04)
+			norm |= 0x20;
+		if (status & 0x20)
+			norm |= 0x40;
+		if (status & 0x80)
+			norm |= 0x80;
+	}
 
 	hc15_mark("hc15-irq", irq);
 	hc15_mark("hc15-cmdctl-wait", cmdctl);
-- 
2.0.0
