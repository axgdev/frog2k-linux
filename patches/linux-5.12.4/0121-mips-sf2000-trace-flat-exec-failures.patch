 			       "errno %d\n", ret);
 			vm_munmap(textpos, text_len);
@@ -613,6 +649,7 @@
 		}
 		if (IS_ERR_VALUE(result)) {
 			ret = result;
+			sf2000_flat_value("flat-read-data-fail", ret);
 			pr_err("Unable to read data+bss, errno %d\n", ret);
 			vm_munmap(textpos, text_len);
 			vm_munmap(realdatastart, len);
@@ -634,6 +671,7 @@
