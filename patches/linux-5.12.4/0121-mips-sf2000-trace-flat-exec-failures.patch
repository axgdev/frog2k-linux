 			vm_munmap(textpos, text_len + data_len + extra +
 				MAX_SHARED_LIBS * sizeof(u32));
@@ -786,6 +825,7 @@
 			if (rp_val) {
 				addr = calc_reloc(rp_val, libinfo, id, 0);
