From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 09:25:00 +0000
Subject: [PATCH] mips: stabilize SF2000 TLB setup

Physical SF2000 hardware now reaches trap_init() and appears to stop in or
immediately after per_cpu_trap_init(). Tighten that path for the bring-up
profile.

Use a fixed 16-entry 4Kc-compatible TLB profile instead of trusting the
vendor Config1 value. That matches the QEMU 4Kc profile used for direct
iteration and avoids walking past the implemented TLB if the real core reports
non-upstream fields.

Also normalize CP0 EBase from Linux itself when a stock ROM handoff is
detected, instead of relying only on the loader. The HC15xx FreeRTOS startup
uses CP0 EBase even in its MIPS32r1 build, so the real core supports the
register even though the bring-up kernel otherwise advertises a conservative
MIPS32r1 CPU profile.

Finally, add sub-ticks inside per_cpu_trap_init() so a single physical test
can tell whether the next stop is IRQ selection, ASID setup, TLB flush/refill
handler generation, TLBMISS_HANDLER_SETUP(), or Status/BEV normalization.
---
 arch/mips/kernel/cpu-probe.c |  4 +--
 arch/mips/kernel/traps.c     | 56 +++++++++++++++++++++++++++++++++++-
 2 files changed, 57 insertions(+), 3 deletions(-)

diff --git a/arch/mips/kernel/cpu-probe.c b/arch/mips/kernel/cpu-probe.c
--- a/arch/mips/kernel/cpu-probe.c
+++ b/arch/mips/kernel/cpu-probe.c
@@ -1993,8 +1993,8 @@ static void cpu_probe_sf2000(struct cpuinfo_mips *c, unsigned int cpu)
 		     MIPS_CPU_COUNTER | MIPS_CPU_LLSC | MIPS_CPU_MCHECK;
 	c->ases = 0;
 	c->scache.flags = MIPS_CACHE_NOT_PRESENT;
-	c->tlbsize = config1 ? ((config1 & MIPS_CONF1_TLBS) >>
-				MIPS_CONF1_TLBS_SHIFT) + 1 : 32;
+	/* The HC15xx bring-up uses the smallest 4Kc-compatible TLB profile. */
+	c->tlbsize = 16;
 	c->tlbsizevtlb = c->tlbsize;
 	c->tlbsizeftlbsets = 0;
 	c->tlbsizeftlbways = 0;
diff --git a/arch/mips/kernel/traps.c b/arch/mips/kernel/traps.c
--- a/arch/mips/kernel/traps.c
+++ b/arch/mips/kernel/traps.c
@@ -108,6 +108,7 @@ void (*board_bind_eic_interrupt)(int irq, int regset);
 void (*board_ebase_setup)(void);
 void(*board_cache_error_setup)(void);
 extern void __init sf2000_visible_tick(const char *name);
+#define SF2000_ROM_F_MOUNT_KSEG0 ((volatile unsigned int *)0x8101f044)
 
 static void __init sf2000_trap_tick(const char *name)
 {
@@ -115,6 +116,33 @@ static void __init sf2000_trap_tick(const char *name)
 		sf2000_visible_tick(name);
 }
 
+static int __init sf2000_rom_handoff_present(void)
+{
+	unsigned int word;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return 0;
+
+	word = *SF2000_ROM_F_MOUNT_KSEG0;
+	return word != 0 && word != 0xffffffffu;
+}
+
+static void __init sf2000_normalize_cp0_ebase(void)
+{
+	unsigned int before;
+	unsigned int after;
+
+	if (!sf2000_rom_handoff_present())
+		return;
+
+	before = read_c0_ebase();
+	write_c0_ebase(ebase & MIPS_EBASE_BASE);
+	back_to_back_c0_hazard();
+	after = read_c0_ebase();
+
+	pr_info("sf2000: CP0 EBase %08x -> %08x\n", before, after);
+}
+
 static void show_raw_backtrace(unsigned long reg29, const char *loglvl)
 {
 	unsigned long *sp = (unsigned long *)(reg29 & ~3);
@@ -2284,9 +2312,12 @@ void per_cpu_trap_init(bool is_boot_cpu)
 
 	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
 		configure_status();
+	sf2000_trap_tick("percpu-entry");
 	configure_hwrena();
+	sf2000_trap_tick("percpu-after-hwrena");
 
 	configure_exception_vector();
+	sf2000_trap_tick("percpu-after-vector");
 
 	/*
 	 * Before R2 both interrupt numbers were fixed to 7, so on R2 only:
@@ -2309,25 +2340,36 @@ void per_cpu_trap_init(bool is_boot_cpu)
 		cp0_perfcount_irq = -1;
 		cp0_fdc_irq = -1;
 	}
+	sf2000_trap_tick("percpu-after-irq-select");
 
 	if (cpu_has_mmid)
 		cpu_data[cpu].asid_cache = 0;
 	else if (!cpu_data[cpu].asid_cache)
 		cpu_data[cpu].asid_cache = asid_first_version(cpu);
+	sf2000_trap_tick("percpu-after-asid");
 
 	mmgrab(&init_mm);
 	current->active_mm = &init_mm;
 	BUG_ON(current->mm);
+	sf2000_trap_tick("percpu-after-mmgrab");
+
 	enter_lazy_tlb(&init_mm, current);
+	sf2000_trap_tick("percpu-after-lazy-tlb");
 
 	/* Boot CPU's cache setup in setup_arch(). */
 	if (!is_boot_cpu)
 		cpu_cache_init();
+	sf2000_trap_tick("percpu-before-tlb-init");
 	tlb_init();
+	sf2000_trap_tick("percpu-after-tlb-init");
+
 	TLBMISS_HANDLER_SETUP();
+	sf2000_trap_tick("percpu-after-tlbmiss-setup");
 
-	if (IS_ENABLED(CONFIG_MIPS_SF2000))
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
 		configure_status();
+		sf2000_trap_tick("percpu-after-status");
+	}
 }
 
 /* Install CPU exception handler */
@@ -2413,6 +2455,9 @@ void __init trap_init(void)
 	}
 	sf2000_trap_tick("trap-after-ebase");
 
+	sf2000_normalize_cp0_ebase();
+	sf2000_trap_tick("trap-after-cp0-ebase");
+
 	if (cpu_has_mmips) {
 		unsigned int config3 = read_c0_config3();
 
@@ -2425,8 +2470,12 @@ void __init trap_init(void)
 	if (board_ebase_setup)
 		board_ebase_setup();
 
-	if (IS_ENABLED(CONFIG_MIPS_SF2000))
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
 		set_handler(0x180, &except_vec3_generic, 0x80);
+		/* Fallback for a stale 0x80002000 bootloader EBase. */
+		if (sf2000_rom_handoff_present())
+			set_handler(0x2180, &except_vec3_generic, 0x80);
+	}
 	sf2000_trap_tick("trap-after-pre-vector");
 
 	per_cpu_trap_init(true);
-- 
2.50.1
