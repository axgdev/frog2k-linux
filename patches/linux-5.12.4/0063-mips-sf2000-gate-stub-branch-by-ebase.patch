From 0000000000000000000000000000000000000063 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: gate stub branch by ROM handoff

The physical gated-identity-epc image still reports marker 0x51510001 at the
final restore point. The first /init start_thread path clearly prepared the
identity handoff, but the assembly-side RAM flag was read as zero before the
branch.

Use the ROM handoff word plus CP0 EBase as the physical-device gate instead
of a RAM flag. Direct ASD QEMU can share the physical EBase value, but it does
not have the ROM handoff function table. Check the same handoff word used by
sf2000_rom_handoff_present(), then match the low EBase page number and saved
/init EPC before jumping to the copied stub.
---
 arch/mips/kernel/entry.S | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/arch/mips/kernel/entry.S b/arch/mips/kernel/entry.S
--- a/arch/mips/kernel/entry.S
+++ b/arch/mips/kernel/entry.S
@@ -152,9 +152,18 @@ restore_partial:		# restore partial frame
 	MFC0	k1, CP0_EPC
 	sw	k1, 28(k0)
 	sync
-	PTR_LA	k0, sf2000_identity_branch_enabled
-	lw	k1, 0(k0)
-	beqz	k1, 1f
+	li	k0, 0x8101f044
+	lw	k1, 0(k0)
+	beqz	k1, 1f
+	 nop
+	li	k0, -1
+	beq	k1, k0, 1f
+	 nop
+	mfc0	k1, CP0_EBASE
+	srl	k1, k1, 12
+	andi	k1, k1, 0x1fff
+	li	k0, 0x1002
+	bne	k1, k0, 1f
 	 nop
 	LONG_L	k1, PT_EPC(sp)
 	li	k0, 0x004002f0
-- 
2.45.0
