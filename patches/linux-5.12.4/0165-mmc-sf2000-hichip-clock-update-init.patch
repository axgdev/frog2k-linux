 	dw_mci_sf2000_mark(host, "dw-send-arg", arg);
+	if (hichip)
+		mci_writel(host, RINTSTS, 0xffffffff);
 	mci_writel(host, CMDARG, arg);
 	wmb(); /* drain writebuffer */
