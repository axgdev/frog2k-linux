From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Wed, 13 May 2026 05:06:00 +0000
Subject: [PATCH] binfmt_flat: log decoded bad relocation addresses

diff --git a/fs/binfmt_flat.c b/fs/binfmt_flat.c
index e19749e..2ec287b 100644
--- a/fs/binfmt_flat.c
+++ b/fs/binfmt_flat.c
@@ -848,7 +848,7 @@ static int load_flat_file(struct linux_binprm *bprm,
 	 */
 	if (rev > OLD_FLAT_VERSION) {
 		for (i = 0; i < relocs; i++) {
-			u32 addr, relval;
+			u32 addr, raw_addr, relval;
 			__be32 tmp;
 
 			/*
@@ -886,9 +886,11 @@ static int load_flat_file(struct linux_binprm *bprm,
 					 */
 					addr = ntohl((__force __be32)addr);
 				}
+				raw_addr = addr;
 				addr = calc_reloc(addr, libinfo, id, 0);
 				if (addr == RELOC_FAILED) {
 					sf2000_flat_value("flat-reloc-addr-fail", relval);
+					sf2000_flat_value("flat-reloc-bad-addr", raw_addr);
 					ret = -ENOEXEC;
 					goto err;
 				}
