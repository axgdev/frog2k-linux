From 0000000000000000000000000000000000000024 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 18:10:00 +0000
Subject: [PATCH] mips: sf2000: arm early watchdog

Physical bring-up can still hang before /init reaches userspace. Arm WDT0 as
soon as SF2000 setup_arch starts, then pet it from every RAM progress marker
with a near-overflow counter value. If the kernel stops before userspace
disables the watchdog, the chip reboots and the next loader run dumps the
retained progress ring to log.txt.

Add a built-in cmdline test hook so QEMU can prove the pre-userspace timeout
path without changing normal boot behaviour.
---
 arch/mips/kernel/setup.c | 58 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -109,9 +109,16 @@ static const char builtin_cmdline[] __initconst = "";
 #define SF2000_PROGRESS_VERSION 1u
 #define SF2000_PROGRESS_ENTRIES 96u
 #define SF2000_PROGRESS_NAME_LEN 32u
+#define SF2000_WDT_COUNT_KSEG1 ((volatile u32 *)CKSEG1ADDR(0x18818500))
+#define SF2000_WDT_CONF_KSEG1 ((volatile u8 *)CKSEG1ADDR(0x18818504))
+#define SF2000_WDT_BOOT_COUNT 0xff000000u
+#define SF2000_WDT_BOOT_CONF 100u
 
 static unsigned int sf2000_screen_seq;
 
+void sf2000_progress_mark(const char *name, unsigned int kind,
+	unsigned int value);
+
 struct sf2000_progress_entry {
 	unsigned int seq;
 	unsigned int kind;
@@ -327,6 +334,55 @@ static void sf2000_progress_copy_name(volatile char *dst, const char *src)
 	dst[i] = '\0';
 }
 
+static void sf2000_watchdog_pet(void)
+{
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	*SF2000_WDT_COUNT_KSEG1 = SF2000_WDT_BOOT_COUNT;
+}
+
+static void sf2000_watchdog_arm(const char *name)
+{
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	*SF2000_WDT_COUNT_KSEG1 = SF2000_WDT_BOOT_COUNT;
+	*SF2000_WDT_CONF_KSEG1 = SF2000_WDT_BOOT_CONF;
+	pr_info("sf2000: early watchdog armed\n");
+	sf2000_progress_mark(name, 3, SF2000_WDT_BOOT_COUNT);
+}
+
+static int __init sf2000_builtin_cmdline_has(const char *needle)
+{
+	unsigned int i;
+	unsigned int j;
+
+	for (i = 0; builtin_cmdline[i] != '\0'; i++) {
+		for (j = 0; needle[j] != '\0' &&
+		     builtin_cmdline[i + j] == needle[j]; j++)
+			;
+		if (needle[j] == '\0')
+			return 1;
+	}
+
+	return 0;
+}
+
+static void __init sf2000_watchdog_test_hang(void)
+{
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+	if (!sf2000_builtin_cmdline_has("sf2000_early_wdt_test=1"))
+		return;
+
+	pr_emerg("sf2000: early watchdog test hang\n");
+	sf2000_progress_mark("early-watchdog-test-hang", 3,
+		SF2000_WDT_BOOT_COUNT);
+	while (1)
+		asm volatile("nop");
+}
+
 void sf2000_progress_mark(const char *name, unsigned int kind,
 	unsigned int value)
 {
@@ -360,6 +416,7 @@ void sf2000_progress_mark(const char *name, unsigned int kind,
 	}
 	log->write_index = index;
 	log->seq = seq;
+	sf2000_watchdog_pet();
 }
 EXPORT_SYMBOL(sf2000_progress_mark);
 
@@ -1120,6 +1177,8 @@ static inline void prefill_possible_map(void) {}
 void __init setup_arch(char **cmdline_p)
 {
 	sf2000_restart_init();
+	sf2000_watchdog_arm("early-watchdog-armed");
+	sf2000_watchdog_test_hang();
 	sf2000_visible_stage("mips-setup-entry", 3);
 	cpu_probe();
 	sf2000_visible_tick("mips-after-cpu-probe");
-- 
2.50.1
