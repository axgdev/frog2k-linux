From 0000000000000000000000000000000000000079 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: probe copied init syscall wrapper

The copied /init entry probe reaches marker 0x5151000a with the expected
KSEG0 stack and first argument pointer, then watchdogs. That puts the failure
after the entry prologue, at the first call into the tiny syscall wrapper used
by the static init binary.

Patch the copied wrapper at entry - 0x1fc to branch through another probe in
the identity stub page. The probe records entry to the wrapper, replays the
register shuffle, records the syscall number and first argument immediately
before the CPU syscall instruction, then records the result if the syscall
returns. This splits the next hardware run between branch/fetch failure and
exception/syscall-return failure without changing the kernel-side exec path.
---
 fs/binfmt_elf.c | 37 +++++++++++++++++++++++++++++++++++--
 1 file changed, 35 insertions(+), 2 deletions(-)

--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -220,10 +220,14 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 {
 	u32 *stub = (u32 *)CKSEG1ADDR(SF2000_IDENTITY_STUB_ADDR);
 	u32 *entry_text = (u32 *)CKSEG1ADDR(entry);
+	u32 *syscall_text = (u32 *)CKSEG1ADDR(entry - 0x1fc);
 	unsigned long target = CKSEG0ADDR(entry);
+	unsigned long syscall_target = CKSEG0ADDR(entry - 0x1fc);
 	unsigned long stack = CKSEG0ADDR(sp);
 	unsigned long probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
 		96 * sizeof(u32));
+	unsigned long syscall_probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
+		128 * sizeof(u32));
 	unsigned long trampoline = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
 		64 * sizeof(u32));
 	unsigned int i;
@@ -287,18 +291,49 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 	stub[121] = 0x377b0000 | ((target + 44) & 0xffff);
 	stub[122] = 0x03600008; /* jr k1 */
 	stub[123] = 0x00000000; /* nop */
+	stub[128] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[129] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[130] = 0x377b000b; /* ori k1,k1,11 */
+	stub[131] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[132] = 0xaf5d0018; /* sw sp,24(k0) */
+	stub[133] = 0xaf5f001c; /* sw ra,28(k0) */
+	stub[134] = 0x00801025; /* move v0,a0 */
+	stub[135] = 0x00a02025; /* move a0,a1 */
+	stub[136] = 0x00c02825; /* move a1,a2 */
+	stub[137] = 0x00e03025; /* move a2,a3 */
+	stub[138] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[139] = 0x377b000c; /* ori k1,k1,12 */
+	stub[140] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[141] = 0xaf420018; /* sw v0,24(k0) */
+	stub[142] = 0xaf44001c; /* sw a0,28(k0) */
+	stub[143] = 0x0000000c; /* syscall */
+	stub[144] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[145] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[146] = 0x377b000d; /* ori k1,k1,13 */
+	stub[147] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[148] = 0xaf420018; /* sw v0,24(k0) */
+	stub[149] = 0xaf47001c; /* sw a3,28(k0) */
+	stub[150] = 0x3c1b0000 | (((syscall_target + 20) >> 16) & 0xffff);
+	stub[151] = 0x377b0000 | ((syscall_target + 20) & 0xffff);
+	stub[152] = 0x03600008; /* jr k1 */
+	stub[153] = 0x00000000; /* nop */
 	entry_text[0] = 0x3c1b0000 | ((probe >> 16) & 0xffff);
 	entry_text[1] = 0x377b0000 | (probe & 0xffff);
 	entry_text[2] = 0x03600008; /* jr k1 */
 	entry_text[3] = 0x00000000; /* nop */
+	syscall_text[0] = 0x3c1b0000 | ((syscall_probe >> 16) & 0xffff);
+	syscall_text[1] = 0x377b0000 | (syscall_probe & 0xffff);
+	syscall_text[2] = 0x03600008; /* jr k1 */
+	syscall_text[3] = 0x00000000; /* nop */
 	flush_cache_all();
 	flush_icache_all();
 	flush_icache_range(SF2000_IDENTITY_STUB_ADDR,
 		SF2000_IDENTITY_STUB_ADDR + PAGE_SIZE);
-	flush_icache_range(entry, entry + 64);
+	flush_icache_range(entry - 0x200, entry + 64);
 	sf2000_elf_value("elf-id-stub", (unsigned int)target);
 	sf2000_elf_value("elf-id-stub-sp", (unsigned int)stack);
 	sf2000_elf_value("elf-id-entry-probe", (unsigned int)probe);
+	sf2000_elf_value("elf-id-syscall-probe", (unsigned int)syscall_probe);
 }
 
 static int sf2000_elf_copy_identity(struct file *file,
-- 
