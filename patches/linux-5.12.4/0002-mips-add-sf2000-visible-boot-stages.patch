From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000_linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 04:15:00 +0000
Subject: [PATCH] mips: add SF2000 visible boot stages

The SF2000 bring-up target currently has no reliable UART access on real
hardware. Add temporary early backlight stage markers to the MIPS setup path so
hardware tests can distinguish "kernel did not enter setup_arch" from later
kernel or initramfs failures.
---
 arch/mips/kernel/setup.c | 74 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
index bbca24faad70..c79fe4d237a9 100644
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -69,6 +69,80 @@ static const char builtin_cmdline[] __initconst = CONFIG_CMDLINE;
 static const char builtin_cmdline[] __initconst = "";
 #endif
 
+#define SF2000_SYSIO_KSEG1 ((volatile unsigned char *)CKSEG1ADDR(0x18800000))
+#define SF2000_PINMUX_R_OFF 0x4e0
+#define SF2000_GPIO_R_OUT_OFF 0xf4
+#define SF2000_GPIO_R_DIR_OFF 0xf8
+#define SF2000_PIN_R05 5
+#define SF2000_BACKLIGHT_R05 (1u << SF2000_PIN_R05)
+#define SF2000_STAGE_OFF_TICKS 0x20000000u
+#define SF2000_STAGE_ON_TICKS 0x08000000u
+#define SF2000_STAGE_GAP_TICKS 0x18000000u
+
+static unsigned int __init sf2000_cp0_count(void)
+{
+	unsigned int count;
+
+	asm volatile("mfc0 %0, $9" : "=r"(count));
+	return count;
+}
+
+static void __init sf2000_stage_delay(unsigned int ticks)
+{
+	unsigned int start = sf2000_cp0_count();
+
+	while ((unsigned int)(sf2000_cp0_count() - start) < ticks)
+		asm volatile("nop");
+}
+
+static unsigned int __init sf2000_read32(unsigned int off)
+{
+	return *(volatile unsigned int *)(SF2000_SYSIO_KSEG1 + off);
+}
+
+static void __init sf2000_write32(unsigned int off, unsigned int value)
+{
+	*(volatile unsigned int *)(SF2000_SYSIO_KSEG1 + off) = value;
+}
+
+static void __init sf2000_write8(unsigned int off, unsigned char value)
+{
+	*(volatile unsigned char *)(SF2000_SYSIO_KSEG1 + off) = value;
+}
+
+static void __init sf2000_backlight_set(int on)
+{
+	unsigned int out;
+	unsigned int dir;
+
+	sf2000_write8(SF2000_PINMUX_R_OFF + SF2000_PIN_R05, 0);
+	dir = sf2000_read32(SF2000_GPIO_R_DIR_OFF);
+	sf2000_write32(SF2000_GPIO_R_DIR_OFF, dir | SF2000_BACKLIGHT_R05);
+
+	out = sf2000_read32(SF2000_GPIO_R_OUT_OFF);
+	if (on)
+		out &= ~SF2000_BACKLIGHT_R05;
+	else
+		out |= SF2000_BACKLIGHT_R05;
+	sf2000_write32(SF2000_GPIO_R_OUT_OFF, out);
+}
+
+static void __init sf2000_visible_stage(const char *name, unsigned int pulses)
+{
+	unsigned int i;
+
+	pr_info("sf2000: visible stage %s pulses=%u\n", name, pulses);
+	sf2000_backlight_set(1);
+	sf2000_stage_delay(SF2000_STAGE_GAP_TICKS);
+	for (i = 0; i < pulses; i++) {
+		sf2000_backlight_set(0);
+		sf2000_stage_delay(SF2000_STAGE_OFF_TICKS);
+		sf2000_backlight_set(1);
+		sf2000_stage_delay(SF2000_STAGE_ON_TICKS);
+	}
+	sf2000_stage_delay(SF2000_STAGE_GAP_TICKS);
+}
+
 /*
  * mips_io_port_base is the begin of the address space to which x86 style
  * I/O ports are mapped.
@@ -751,6 +825,7 @@ static inline void prefill_possible_map(void) {}
 
 void __init setup_arch(char **cmdline_p)
 {
+	sf2000_visible_stage("mips-setup-entry", 3);
 	cpu_probe();
 	mips_cm_probe();
 	prom_init();
@@ -777,6 +852,8 @@ void __init setup_arch(char **cmdline_p)
 	paging_init();
 
 	memblock_dump_all();
+
+	sf2000_visible_stage("mips-setup-done", 4);
 }
 
 unsigned long kernelsp[NR_CPUS];
-- 
2.50.1
