From 0000000000000000000000000000000000000065 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: return to init stub via EPC

The physical errorepc-init-stub image reached the first /init return and
recorded that ErrorEPC was rewritten to the copied KSEG0 stub, but the stub's
retained markers were still absent after the watchdog reboot. That means this
core's final return is still effectively following the saved EPC path, or the
normal RESTORE_SOME EPC write wins over the ErrorEPC-only handoff.

Point both the saved EPC and ErrorEPC at the copied stub for the first /init
return. Also make the stub's ERL clear idempotent, because the final eret may
clear ERL before entering the stub; an xor-only clear would then set ERL again.
---
 arch/mips/kernel/process.c | 5 +++++
 fs/binfmt_elf.c            | 5 +++--
 2 files changed, 8 insertions(+), 2 deletions(-)

--- a/arch/mips/kernel/process.c
+++ b/arch/mips/kernel/process.c
@@ -98,12 +98,16 @@ void sf2000_ret_before_restore(struct pt_regs *regs)
 	sf2000_progress_mark("ret-restore-errorepc-before", 9,
 		read_c0_errorepc());
 	if (regs->cp0_epc == SF2000_INIT_ENTRY) {
+		sf2000_progress_mark("ret-restore-stub-epc", 9,
+			SF2000_IDENTITY_STUB_KSEG0);
+		regs->cp0_epc = SF2000_IDENTITY_STUB_KSEG0;
 		sf2000_progress_mark("ret-restore-stub-errorepc", 9,
 			SF2000_IDENTITY_STUB_KSEG0);
 		write_c0_errorepc(SF2000_IDENTITY_STUB_KSEG0);
 	} else {
 		write_c0_errorepc(regs->cp0_epc);
 	}
+	sf2000_progress_mark("ret-restore-epc-after", 9, regs->cp0_epc);
 	sf2000_progress_mark("ret-restore-errorepc-after", 9,
 		read_c0_errorepc());
 }
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -228,9 +228,9 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry)
 	stub[3] = 0xaf5b0014; /* sw k1,20(k0) */
 	stub[4] = 0x401b6000; /* mfc0 k1,CP0_STATUS */
 	stub[5] = 0xaf5b0018; /* sw k1,24(k0) */
-	stub[6] = 0x3b7b0004; /* xori k1,k1,ST0_ERL */
-	stub[7] = 0x409b6000; /* mtc0 k1,CP0_STATUS */
-	stub[8] = 0x00000000; /* nop */
+	stub[6] = 0x377b0004; /* ori k1,k1,ST0_ERL */
+	stub[7] = 0x3b7b0004; /* xori k1,k1,ST0_ERL */
+	stub[8] = 0x409b6000; /* mtc0 k1,CP0_STATUS */
 	stub[9] = 0x00000000; /* nop */
 	stub[10] = 0x3c1b5151; /* lui k1,0x5151 */
 	stub[11] = 0x377b0005; /* ori k1,k1,5 */
-- 
