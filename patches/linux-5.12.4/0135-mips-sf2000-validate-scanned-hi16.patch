From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000 linux port <sf2000@local>
Date: Wed, 13 May 2026 07:05:00 +0000
Subject: [PATCH] mips: sf2000: validate scanned HI16 pairs

The 0096 hardware log showed BusyBox failing at a LO16 relocation whose
matching HI16 relocation appears later in the bFLT relocation stream. The
previous cache-only scan avoided false matches against ordinary constants,
but it also rejected this valid out-of-order pair and left the low half as
0xffff9ee0.

Keep the protection against unrelated LUI constants by validating uncached
scan hits against the current bFLT image size. A scanned LUI is accepted only
when combining it with the LO16 immediate reconstructs an address that can
belong to the loaded text/data/bss image. This accepts the real BusyBox
0x000a/0x9ee0 pair while still rejecting the earlier bogus 0x3500 match.
---
 arch/mips/include/asm/flat.h | 29 ++++++++++++++++++++++++++---
 fs/binfmt_flat.c             |  5 +++++
 2 files changed, 31 insertions(+), 3 deletions(-)

diff --git a/arch/mips/include/asm/flat.h b/arch/mips/include/asm/flat.h
--- a/arch/mips/include/asm/flat.h
+++ b/arch/mips/include/asm/flat.h
@@ -18,6 +18,7 @@ static u32 __user *flat_mips_hi16_rp;
 static u32 flat_mips_hi16_insn;
 static u32 __user *flat_mips_hi16_rps[FLAT_MIPS_HI16_SLOTS];
 static u32 flat_mips_hi16_insns[FLAT_MIPS_HI16_SLOTS];
+static u32 flat_mips_image_limit;
 
 static inline u32 flat_mips_reloc_type(u32 rel)
 {
@@ -34,6 +35,23 @@ static inline u32 flat_mips_lo16_rs(u32 insn)
 	return (insn >> 21) & 0x1f;
 }
 
+static inline void mips_flat_reloc_set_image_limit(u32 limit)
+{
+	flat_mips_image_limit = limit;
+}
+
+static inline int flat_mips_addr_plausible(u32 addr)
+{
+	if (!flat_mips_image_limit)
+		return 0;
+	if (addr <= flat_mips_image_limit)
+		return 1;
+	if (addr >= 0x10000 && addr - 0x10000 <= flat_mips_image_limit)
+		return 1;
+
+	return 0;
+}
+
 static inline void flat_mips_remember_hi16(u32 __user *rp, u32 insn)
 {
 	unsigned long slot = ((unsigned long)rp >> 2) &
@@ -98,8 +116,15 @@ static inline int flat_mips_find_hi16_for_lo16(u32 __user *rp, u32 lo,
 		if ((insn & 0xffe00000) != 0x3c000000 ||
 		    flat_mips_lui_rt(insn) != rs)
 			continue;
-		if (!flat_mips_lookup_hi16((__force u32 __user *)scan, hi_insn))
-			continue;
+		if (!flat_mips_lookup_hi16((__force u32 __user *)scan, hi_insn)) {
+			u32 candidate = ((insn & 0xffff) << 16) +
+					(s16)(lo & 0xffff);
+
+			if (!flat_mips_addr_plausible(candidate))
+				continue;
+			*hi_insn = insn;
+			flat_mips_remember_hi16((__force u32 __user *)scan, insn);
+		}
 
 		*hi_rp = (__force u32 __user *)scan;
 		return 1;
@@ -192,6 +217,8 @@ static inline u32 mips_flat_reloc_addr_fixup(u32 relval, u32 addr, u32 limit)
 
 #define flat_reloc_addr_fixup(rel, addr, limit) \
 	mips_flat_reloc_addr_fixup(rel, addr, limit)
+#define flat_reloc_set_image_limit(limit) \
+	mips_flat_reloc_set_image_limit(limit)
 
 /*
  * elf2flt stores the MIPS relocation kind in the top two bits. Keep the
diff --git a/fs/binfmt_flat.c b/fs/binfmt_flat.c
--- a/fs/binfmt_flat.c
+++ b/fs/binfmt_flat.c
@@ -68,6 +68,10 @@ static inline void sf2000_flat_value(const char *name, unsigned int value) { }
 #define flat_reloc_addr_fixup(rel, addr, limit)	(addr)
 #endif
 
+#ifndef flat_reloc_set_image_limit
+#define flat_reloc_set_image_limit(limit)	do { } while (0)
+#endif
+
 /****************************************************************************/
 
 /*
@@ -806,6 +810,7 @@ static int load_flat_file(struct linux_binprm *bprm,
 	libinfo->lib_list[id].loaded = 1;
 	libinfo->lib_list[id].entry = (0x00ffffff & ntohl(hdr->entry)) + textpos;
 	libinfo->lib_list[id].build_date = ntohl(hdr->build_date);
+	flat_reloc_set_image_limit(text_len + data_len + bss_len);
 
 	/*
 	 * We just load the allocations into some temporary memory to
