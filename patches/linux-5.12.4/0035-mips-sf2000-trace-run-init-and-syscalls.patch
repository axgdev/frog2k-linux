From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 20:00:00 +0000
Subject: [PATCH] mips: sf2000: trace run-init and early syscalls

The SF2000 hardware now reaches the final kernel_init handoff and stops after
kernel-init-before-run-init. A successful kernel_execve() does not return, so
that marker alone cannot distinguish a failed exec from PID 1 entering user
mode and hanging immediately.

Record the init filename pointer before kernel_execve(), record any exec
return value, and add a small o32 syscall-entry breadcrumb for the first 64
userspace syscalls. The syscall hook restores the syscall number and argument
registers before normal dispatch.
---
 arch/mips/kernel/scall32-o32.S | 10 ++++++++++
 arch/mips/kernel/setup.c       | 14 ++++++++++++++
 init/main.c                    |  8 +++++++-
 3 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/arch/mips/kernel/scall32-o32.S b/arch/mips/kernel/scall32-o32.S
index 18dc9b1b0..781015273 100644
--- a/arch/mips/kernel/scall32-o32.S
+++ b/arch/mips/kernel/scall32-o32.S
@@ -71,6 +71,16 @@ loads_done:
 	sw	t8, 28(sp)		# argument #8 to ksp
 	.set	pop
 
+#ifdef CONFIG_MIPS_SF2000
+	move	a0, v0
+	jal	sf2000_syscall_mark
+	lw	v0, PT_R2(sp)
+	lw	a0, PT_R4(sp)
+	lw	a1, PT_R5(sp)
+	lw	a2, PT_R6(sp)
+	lw	a3, PT_R7(sp)
+#endif
+
 	.section __ex_table,"a"
 	PTR	load_a4, bad_stack_a4
 	PTR	load_a5, bad_stack_a5
diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
index 1bdd89323..6751c8157 100644
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -118,6 +118,7 @@ static unsigned int sf2000_screen_seq;
 
 void sf2000_progress_mark(const char *name, unsigned int kind,
 	unsigned int value);
+void sf2000_syscall_mark(unsigned int nr);
 
 struct sf2000_progress_entry {
 	unsigned int seq;
@@ -420,6 +421,19 @@ void sf2000_progress_mark(const char *name, unsigned int kind,
 }
 EXPORT_SYMBOL(sf2000_progress_mark);
 
+void sf2000_syscall_mark(unsigned int nr)
+{
+	static unsigned int count;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+	if (count >= 64)
+		return;
+
+	count++;
+	sf2000_progress_mark("user-syscall", 6, nr);
+}
+
 static void sf2000_status_led_set(int on)
 {
 	unsigned int out;
diff --git a/init/main.c b/init/main.c
index 138b32d7e..b0fd878f6 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1725,7 +1725,11 @@ static int run_init_process(const char *init_filename)
 {
 	const char *const *p;
+	int ret;
 
 	argv_init[0] = init_filename;
+#ifdef CONFIG_MIPS
+	sf2000_init_value("run-init-before", (unsigned int)init_filename);
+#endif
 	pr_info("Run %s as init process\n", init_filename);
 	pr_debug("  with arguments:\n");
 	for (p = argv_init; *p; p++)
@@ -1735,7 +1739,11 @@ static int run_init_process(const char *init_filename)
 	pr_debug("  with environment:\n");
 	for (p = envp_init; *p; p++)
 		pr_debug("    %s\n", *p);
-	return kernel_execve(init_filename, argv_init, envp_init);
+	ret = kernel_execve(init_filename, argv_init, envp_init);
+#ifdef CONFIG_MIPS
+	sf2000_init_value("run-init-ret", (unsigned int)ret);
+#endif
+	return ret;
 }
 
 static int try_to_run_init_process(const char *init_filename)
-- 
2.50.1
