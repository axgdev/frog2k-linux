From 0000000000000000000000000000000000000083 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: use uncached init stack

The physical split-init-prologue log reaches marker 0x51510021 in the copied
identity stub, then stops before marker 0x51510022. That places the failure on
the first replayed /init stack store using the KSEG0 alias of the copied stack.

Use the KSEG1 alias for the forced first-init stack when the ROM handoff is
present and add a simple stack store checkpoint before replaying the original
prologue stores. Direct QEMU keeps the existing KSEG0 stack path, while the
next hardware log can distinguish an uncached-stack store failure from a
failure in one of the original saved-register stores.
---
 fs/binfmt_elf.c | 38 +++++++++++++++++++++++++++++---------
 1 file changed, 29 insertions(+), 9 deletions(-)

--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -79,6 +79,14 @@ static void sf2000_elf_value(const char *name, unsigned int value)
 #define SF2000_IDENTITY_STACK_PAGE \
 	(SF2000_IDENTITY_STACK_TOP - PAGE_SIZE)
 #define SF2000_IDENTITY_STUB_ADDR 0x00401000UL
+#define SF2000_ROM_F_MOUNT_KSEG0 ((volatile unsigned int *)0x8101f044)
+
+static int sf2000_elf_rom_handoff_present(void)
+{
+	unsigned int word = *SF2000_ROM_F_MOUNT_KSEG0;
+
+	return word != 0 && word != 0xffffffffu;
+}
 
 static int sf2000_elf_install_entry_page(struct file *file,
 		const struct elf_phdr *phdrs, int phnum, unsigned long entry)
@@ -223,7 +231,8 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 	u32 *syscall_text = (u32 *)CKSEG1ADDR(entry - 0x1fc);
 	unsigned long target = CKSEG0ADDR(entry);
 	unsigned long syscall_target = CKSEG0ADDR(entry - 0x1fc);
-	unsigned long stack = CKSEG0ADDR(sp);
+	unsigned long stack = sf2000_elf_rom_handoff_present() ?
+		CKSEG1ADDR(sp) : CKSEG0ADDR(sp);
 	unsigned long probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
 		96 * sizeof(u32));
 	unsigned long syscall_probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
@@ -297,38 +297,45 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 	stub[119] = 0xaf5b0014; /* sw k1,20(k0) */
 	stub[120] = 0xaf450018; /* sw a1,24(k0) */
 	stub[121] = 0xaf44001c; /* sw a0,28(k0) */
-	stub[122] = entry_text[6]; /* sw ra,36(sp) */
-	stub[123] = entry_text[7]; /* sw s4,32(sp) */
-	stub[124] = entry_text[8]; /* sw s3,28(sp) */
-	stub[125] = entry_text[9]; /* sw s2,24(sp) */
-	stub[126] = entry_text[10]; /* sw s1,20(sp) */
-	stub[127] = 0x3c1aa13f; /* lui k0,0xa13f */
-	stub[128] = 0x3c1b5151; /* lui k1,0x5151 */
-	stub[129] = 0x377b0022; /* ori k1,k1,0x22 */
-	stub[130] = 0xaf5b0014; /* sw k1,20(k0) */
-	stub[131] = 0xaf5d0018; /* sw sp,24(k0) */
-	stub[132] = 0xaf5f001c; /* sw ra,28(k0) */
-	stub[133] = 0x3c1aa13f; /* lui k0,0xa13f */
-	stub[134] = 0x3c1b5151; /* lui k1,0x5151 */
-	stub[135] = 0x377b000a; /* ori k1,k1,10 */
-	stub[136] = 0xaf5b0014; /* sw k1,20(k0) */
-	stub[137] = 0xaf5d0018; /* sw sp,24(k0) */
-	stub[138] = 0xaf45001c; /* sw a1,28(k0) */
-	stub[139] = 0x0000000f; /* sync */
-	stub[140] = 0x3c1f0000 | (((target + 52) >> 16) & 0xffff);
-	stub[141] = 0x37ff0000 | ((target + 52) & 0xffff);
-	stub[142] = 0xafb00010; /* sw s0,16(sp) */
-	stub[143] = 0x3c1aa13f; /* lui k0,0xa13f */
-	stub[144] = 0x3c1b5151; /* lui k1,0x5151 */
-	stub[145] = 0x377b000e; /* ori k1,k1,14 */
-	stub[146] = 0xaf5b0014; /* sw k1,20(k0) */
-	stub[147] = 0xaf5f0018; /* sw ra,24(k0) */
-	stub[148] = 0xaf45001c; /* sw a1,28(k0) */
-	stub[149] = 0x0000000f; /* sync */
-	stub[150] = 0x3c1b0000 | ((syscall_probe >> 16) & 0xffff);
-	stub[151] = 0x377b0000 | (syscall_probe & 0xffff);
-	stub[152] = 0x03600008; /* jr k1 */
-	stub[153] = 0x00000000; /* nop */
+	stub[122] = 0xaf400000; /* sw zero,0(sp) */
+	stub[123] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[124] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[125] = 0x377b0023; /* ori k1,k1,0x23 */
+	stub[126] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[127] = 0xaf5d0018; /* sw sp,24(k0) */
+	stub[128] = 0x0000000f; /* sync */
+	stub[129] = entry_text[6]; /* sw ra,36(sp) */
+	stub[130] = entry_text[7]; /* sw s4,32(sp) */
+	stub[131] = entry_text[8]; /* sw s3,28(sp) */
+	stub[132] = entry_text[9]; /* sw s2,24(sp) */
+	stub[133] = entry_text[10]; /* sw s1,20(sp) */
+	stub[134] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[135] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[136] = 0x377b0022; /* ori k1,k1,0x22 */
+	stub[137] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[138] = 0xaf5d0018; /* sw sp,24(k0) */
+	stub[139] = 0xaf5f001c; /* sw ra,28(k0) */
+	stub[140] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[141] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[142] = 0x377b000a; /* ori k1,k1,10 */
+	stub[143] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[144] = 0xaf5d0018; /* sw sp,24(k0) */
+	stub[145] = 0xaf45001c; /* sw a1,28(k0) */
+	stub[146] = 0x0000000f; /* sync */
+	stub[147] = 0x3c1f0000 | (((target + 52) >> 16) & 0xffff);
+	stub[148] = 0x37ff0000 | ((target + 52) & 0xffff);
+	stub[149] = 0xafb00010; /* sw s0,16(sp) */
+	stub[150] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[151] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[152] = 0x377b000e; /* ori k1,k1,14 */
+	stub[153] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[154] = 0xaf5f0018; /* sw ra,24(k0) */
+	stub[155] = 0xaf45001c; /* sw a1,28(k0) */
+	stub[156] = 0x0000000f; /* sync */
+	stub[157] = 0x3c1b0000 | ((syscall_probe >> 16) & 0xffff);
+	stub[158] = 0x377b0000 | (syscall_probe & 0xffff);
+	stub[159] = 0x03600008; /* jr k1 */
+	stub[160] = 0x00000000; /* nop */
 	stub[256] = 0x3c1aa13f; /* lui k0,0xa13f */
 	stub[257] = 0x3c1b5151; /* lui k1,0x5151 */
 	stub[258] = 0x377b000b; /* ori k1,k1,11 */
@@ -457,8 +464,8 @@ static int sf2000_elf_copy_identity_stack(unsigned long *sp)
 	sf2000_elf_value("elf-id-stack-remap", (unsigned int)ret);
 	if (ret)
 		return ret;
-	*sp = low_sp;
-	sf2000_identity_init_sp = low_sp;
+	*sp = sf2000_elf_rom_handoff_present() ? CKSEG1ADDR(low_sp) : low_sp;
+	sf2000_identity_init_sp = *sp;
 	sf2000_elf_value("elf-id-stack-global",
 		(unsigned int)sf2000_identity_init_sp);
 	sf2000_elf_value("elf-id-stack-done", (unsigned int)*sp);
