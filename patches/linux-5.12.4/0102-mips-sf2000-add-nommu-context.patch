From 0000000000000000000000000000000000000102 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: add nommu mm context

MIPS has never advertised FLAT/NOMMU support here, so its mm_context_t lacks
the end_brk field used by binfmt_flat and pgtable.c assumes page tables exist.
Use a small NOMMU context matching the other FLAT-capable architectures and
compile the pgd allocator only for MMU builds.
---
 arch/mips/include/asm/mmu.h | 6 ++++++
 arch/mips/mm/pgtable.c      | 2 ++
 2 files changed, 8 insertions(+)

diff --git a/arch/mips/include/asm/mmu.h b/arch/mips/include/asm/mmu.h
index 4f86ac7..59f8c9d 100644
--- a/arch/mips/include/asm/mmu.h
+++ b/arch/mips/include/asm/mmu.h
@@ -6,6 +6,8 @@
 #include <linux/spinlock.h>
 #include <linux/wait.h>
 
+#ifdef CONFIG_MMU
+
 typedef struct {
 	union {
 		u64 asid[NR_CPUS];
@@ -21,4 +23,10 @@ typedef struct {
 	wait_queue_head_t bd_emupage_queue;
 } mm_context_t;
 
+#else
+typedef struct {
+	unsigned long end_brk;
+} mm_context_t;
+#endif
+
 #endif /* __ASM_MMU_H */
diff --git a/arch/mips/mm/pgtable.c b/arch/mips/mm/pgtable.c
index b9c319e..92b06cc 100644
--- a/arch/mips/mm/pgtable.c
+++ b/arch/mips/mm/pgtable.c
@@ -7,6 +7,7 @@
 #include <linux/string.h>
 #include <asm/pgalloc.h>
 
+#ifdef CONFIG_MMU
 pgd_t *pgd_alloc(struct mm_struct *mm)
 {
 	pgd_t *ret, *init;
@@ -22,3 +23,4 @@ pgd_t *pgd_alloc(struct mm_struct *mm)
 	return ret;
 }
 EXPORT_SYMBOL_GPL(pgd_alloc);
+#endif
-- 
