diff --git a/drivers/mmc/host/hc15_mmc.c b/drivers/mmc/host/hc15_mmc.c
index e902d4e..713dc68 100644
--- a/drivers/mmc/host/hc15_mmc.c
+++ b/drivers/mmc/host/hc15_mmc.c
@@ -58,8 +58,9 @@
 #define HC15_SD_APP_SEND_SCR	51
 #define HC15_DATA_VARIANTS	1
 #define HC15_READ_VARIANTS	1
+#define HC15_WRITE_WAIT_BEFORE_PIO 1
 #define HC15_TRACE_VERBOSE	0
-#define HC15_PROBE_TAG		0x0228
+#define HC15_PROBE_TAG		0x0229
 
 struct hc15_mmc {
 	struct mmc_host *mmc;
@@ -281,6 +282,11 @@ static bool hc15_data_wait_ready(struct hc15_mmc *host, u16 pio)
 	return !(pio & 0x0002);
 }
 
+static u8 hc15_cmd_status(struct hc15_mmc *host)
+{
+	return readb(host->base + HC15_REG_CMDSTS);
+}
+
 static void hc15_pio_cleanup(struct hc15_mmc *host)
 {
 	u8 pio;
@@ -554,19 +560,25 @@ static int hc15_pio_write(struct hc15_mmc *host, struct mmc_data *data)
 		for (pos = 0; pos < len; pos += 2) {
 			u16 value = buf[pos];
 			u16 pio;
+			u8 status;
 
 			if (pos + 1 < len)
 				value |= (u16)buf[pos + 1] << 8;
 			if (HC15_TRACE_VERBOSE && done < 8)
 				hc15_mark("hc15-pio-wword", value);
 			writew(value, host->base + HC15_REG_FIFO);
-			ret = readw_poll_timeout(host->base + HC15_REG_PIO,
-						 pio, !(pio & 0x0002),
+			ret = readw_poll_timeout(host->base + HC15_REG_PIO, pio,
+						 hc15_data_wait_ready(host, pio) ||
+						 (hc15_cmd_status(host) & 0x02),
 						 1, HC15_PIO_TIMEOUT_US);
+			status = hc15_cmd_status(host);
 			if (ret) {
 				hc15_mark("hc15-pio-write-timeout", pio);
+				hc15_rw_mark("hc15-pio-wtimeout-sts", status);
 				goto out;
 			}
+			if (status & 0x02)
+				hc15_rw_mark("hc15-pio-wstatus-done", status);
 			done += min_t(u32, 2, remaining);
 			remaining -= min_t(u32, 2, remaining);
 		}
@@ -587,6 +599,7 @@ static void hc15_run_command(struct hc15_mmc *host, struct mmc_command *cmd,
 			     struct mmc_data *data)
 {
 	bool data_read = data && (data->flags & MMC_DATA_READ);
+	bool data_write = data && (data->flags & MMC_DATA_WRITE);
 	bool read_after_wait = data_read && (host->read_variant & 0x01);
 	bool read_preclean = data_read && (host->read_variant & 0x04);
 
@@ -617,13 +630,21 @@ static void hc15_run_command(struct hc15_mmc *host, struct mmc_command *cmd,
 	hc15_set_command(host, cmd, data);
 	hc15_start_command(host);
 
-	if (data_read && !read_after_wait)
+	if (data_write && HC15_WRITE_WAIT_BEFORE_PIO) {
+		hc15_rw_mark("hc15-write-wait-first", cmd->opcode);
+		hc15_wait_irq(host, cmd, true);
+		hc15_get_response(host, cmd);
+		if (!cmd->error)
+			hc15_pio_write(host, data);
+	} else if (data_read && !read_after_wait)
 		hc15_pio_read(host, data);
 	else if (data && (data->flags & MMC_DATA_WRITE))
 		hc15_pio_write(host, data);
 
-	hc15_wait_irq(host, cmd, data);
-	hc15_get_response(host, cmd);
+	if (!data_write || !HC15_WRITE_WAIT_BEFORE_PIO) {
+		hc15_wait_irq(host, cmd, data != NULL);
+		hc15_get_response(host, cmd);
+	}
 
 	if (data_read && read_after_wait && !cmd->error)
 		hc15_pio_read(host, data);
