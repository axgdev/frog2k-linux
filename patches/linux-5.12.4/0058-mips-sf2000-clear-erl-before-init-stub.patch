From 0000000000000000000000000000000000000058 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: clear ERL before init stub jump

The physical SF2000 now executes the copied identity stub and records
reserved0=0x51510004, so the branch target and copied code fetch path are
working. It still watchdogs after the stub jumps to /init with Status.ERL set.

Keep the KSEG0 /init branch, but clear ERL inside the no-stack stub first and
record reserved0=0x51510005 plus the post-clear status. This lets the first
/init syscall take the normal Linux exception path instead of the error-level
path, while still avoiding an instruction-side user TLB dependency.
---
 fs/binfmt_elf.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/fs/binfmt_elf.c b/fs/binfmt_elf.c
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -228,11 +228,20 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry)
 	stub[3] = 0xaf5b0014; /* sw k1,20(k0) */
 	stub[4] = 0x401b6000; /* mfc0 k1,CP0_STATUS */
 	stub[5] = 0xaf5b0018; /* sw k1,24(k0) */
-	stub[6] = 0x3c1b0000 | ((target >> 16) & 0xffff);
-	stub[7] = 0x377b0000 | (target & 0xffff);
-	stub[8] = 0xaf5b001c; /* sw k1,28(k0) */
-	stub[9] = 0x03600008; /* jr k1 */
-	stub[10] = 0x00000000; /* nop */
+	stub[6] = 0x3b7b0004; /* xori k1,k1,ST0_ERL */
+	stub[7] = 0x409b6000; /* mtc0 k1,CP0_STATUS */
+	stub[8] = 0x00000000; /* nop */
+	stub[9] = 0x00000000; /* nop */
+	stub[10] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[11] = 0x377b0005; /* ori k1,k1,5 */
+	stub[12] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[13] = 0x401b6000; /* mfc0 k1,CP0_STATUS */
+	stub[14] = 0xaf5b0018; /* sw k1,24(k0) */
+	stub[15] = 0x3c1b0000 | ((target >> 16) & 0xffff);
+	stub[16] = 0x377b0000 | (target & 0xffff);
+	stub[17] = 0xaf5b001c; /* sw k1,28(k0) */
+	stub[18] = 0x03600008; /* jr k1 */
+	stub[19] = 0x00000000; /* nop */
 	flush_cache_all();
 	flush_icache_all();
 	flush_icache_range(SF2000_IDENTITY_STUB_ADDR,
-- 
