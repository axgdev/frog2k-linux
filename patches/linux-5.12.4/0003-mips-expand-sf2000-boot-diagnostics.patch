From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000_linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 04:30:00 +0000
Subject: [PATCH] mips: expand SF2000 visual boot diagnostics

Add faster counted visual stages, mirror them to the L25 status LED, and add
post-setup_arch checkpoints through the handoff to /init. Persistent SD logging
is kept in the loader where the ROM file and block I/O environment is still
known to be intact.
---
 arch/mips/kernel/setup.c | 70 ++++++++++++++++++++++++++++++++++++++---
 init/main.c              | 22 +++++++++++++
 2 files changed, 88 insertions(+), 4 deletions(-)

diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -73,14 +73,19 @@
 #endif
 
 #define SF2000_SYSIO_KSEG1 ((volatile unsigned char *)CKSEG1ADDR(0x18800000))
+#define SF2000_PINMUX_L_OFF 0x4a0
 #define SF2000_PINMUX_R_OFF 0x4e0
+#define SF2000_GPIO_L_OUT_OFF 0x54
+#define SF2000_GPIO_L_DIR_OFF 0x58
 #define SF2000_GPIO_R_OUT_OFF 0xf4
 #define SF2000_GPIO_R_DIR_OFF 0xf8
+#define SF2000_PIN_L25 25
 #define SF2000_PIN_R05 5
+#define SF2000_STATUS_L25 (1u << SF2000_PIN_L25)
 #define SF2000_BACKLIGHT_R05 (1u << SF2000_PIN_R05)
-#define SF2000_STAGE_OFF_TICKS 0x20000000u
-#define SF2000_STAGE_ON_TICKS 0x08000000u
-#define SF2000_STAGE_GAP_TICKS 0x18000000u
+#define SF2000_STAGE_OFF_TICKS 0x06000000u
+#define SF2000_STAGE_ON_TICKS 0x03000000u
+#define SF2000_STAGE_GAP_TICKS 0x20000000u
 
 static unsigned int __init sf2000_cp0_count(void)
 {
@@ -113,6 +118,23 @@
 	*(volatile unsigned char *)(SF2000_SYSIO_KSEG1 + off) = value;
 }
 
+static void __init sf2000_status_led_set(int on)
+{
+	unsigned int out;
+	unsigned int dir;
+
+	sf2000_write8(SF2000_PINMUX_L_OFF + SF2000_PIN_L25, 0);
+	dir = sf2000_read32(SF2000_GPIO_L_DIR_OFF);
+	sf2000_write32(SF2000_GPIO_L_DIR_OFF, dir | SF2000_STATUS_L25);
+
+	out = sf2000_read32(SF2000_GPIO_L_OUT_OFF);
+	if (on)
+		out |= SF2000_STATUS_L25;
+	else
+		out &= ~SF2000_STATUS_L25;
+	sf2000_write32(SF2000_GPIO_L_OUT_OFF, out);
+}
+
 static void __init sf2000_backlight_set(int on)
 {
 	unsigned int out;
@@ -130,22 +152,31 @@
 	sf2000_write32(SF2000_GPIO_R_OUT_OFF, out);
 }
 
-static void __init sf2000_visible_stage(const char *name, unsigned int pulses)
+void __init sf2000_visible_stage(const char *name, unsigned int pulses)
 {
 	unsigned int i;
 
 	pr_info("sf2000: visible stage %s pulses=%u\n", name, pulses);
 	sf2000_backlight_set(1);
+	sf2000_status_led_set(0);
 	sf2000_stage_delay(SF2000_STAGE_GAP_TICKS);
 	for (i = 0; i < pulses; i++) {
 		sf2000_backlight_set(0);
+		sf2000_status_led_set(1);
 		sf2000_stage_delay(SF2000_STAGE_OFF_TICKS);
 		sf2000_backlight_set(1);
+		sf2000_status_led_set(0);
 		sf2000_stage_delay(SF2000_STAGE_ON_TICKS);
 	}
+	sf2000_status_led_set(0);
 	sf2000_stage_delay(SF2000_STAGE_GAP_TICKS);
 }
 
+void __init sf2000_visible_stage_nolog(const char *name, unsigned int pulses)
+{
+	sf2000_visible_stage(name, pulses);
+}
+
 /*
  * mips_io_port_base is the begin of the address space to which x86 style
  * I/O ports are mapped.
diff --git a/init/main.c b/init/main.c
--- a/init/main.c
+++ b/init/main.c
@@ -115,6 +115,13 @@
 extern void init_IRQ(void);
 extern void radix_tree_init(void);
 
+#ifdef CONFIG_MIPS
+extern void __init sf2000_visible_stage(const char *name,
+		unsigned int pulses);
+extern void __init sf2000_visible_stage_nolog(const char *name,
+		unsigned int pulses);
+#endif
+
 /*
  * Debug helper: via this flag we know that we are in 'early bootup code'
  * where only the boot processor is running with IRQ disabled.  This means
@@ -872,6 +879,9 @@
 	pr_notice("%s", linux_banner);
 	early_security_init();
 	setup_arch(&command_line);
+#ifdef CONFIG_MIPS
+	sf2000_visible_stage("post-setup-arch", 5);
+#endif
 	setup_boot_config(command_line);
 	setup_command_line(command_line);
 	setup_nr_cpu_ids();
@@ -906,6 +916,9 @@
 	sort_main_extable();
 	trap_init();
 	mm_init();
+#ifdef CONFIG_MIPS
+	sf2000_visible_stage("mm-ready", 6);
+#endif
 
 	ftrace_init();
 
@@ -975,11 +988,17 @@
 	boot_init_stack_canary();
 
 	time_init();
+#ifdef CONFIG_MIPS
+	sf2000_visible_stage("time-ready", 7);
+#endif
 	perf_event_init();
 	profile_init();
 	call_function_init();
 	WARN(!irqs_disabled(), "Interrupts were enabled early\n");
 
+#ifdef CONFIG_MIPS
+	sf2000_visible_stage("before-irq-enable", 8);
+#endif
 	early_boot_irqs_disabled = false;
 	local_irq_enable();
 
@@ -1422,6 +1441,9 @@
 	int ret;
 
 	kernel_init_freeable();
+#ifdef CONFIG_MIPS
+	sf2000_visible_stage_nolog("before-run-init", 9);
+#endif
 	/* need to finish all async __init code before freeing the memory */
 	async_synchronize_full();
 	kprobe_free_init_mem();
