From 0000000000000000000000000000000000000087 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: use separate raw diag block

The raw-syscall-breadcrumbs hardware log stops around the copied /init syscall
probe, but the retained progress header itself is damaged. The raw marker area
at 0xa13f0014 shares the same cache line and structure as the progress ring
header, so late userspace/syscall diagnostics are too easy to lose.

Move copied-stub and raw syscall assembly breadcrumbs to a separate retained
block at 0xa1400000. The address can still be loaded with a single MIPS lui,
so the delicate copied stub does not need extra instructions.
---
 arch/mips/kernel/scall32-o32.S | 10 +++++-----
 fs/binfmt_elf.c                | 22 +++++++++++-----------
 2 files changed, 16 insertions(+), 16 deletions(-)

--- a/arch/mips/kernel/scall32-o32.S
+++ b/arch/mips/kernel/scall32-o32.S
@@ -27,7 +27,7 @@ NESTED(handle_sys, PT_SIZE, sp)
 	.set	noat
 	SAVE_SOME
 #ifdef CONFIG_MIPS_SF2000
-	li	k0, 0xa13f0000
+	li	k0, 0xa1400000
 	li	k1, 0x51510030
 	sw	k1, 20(k0)
 	sw	v0, 24(k0)
@@ -82,7 +82,7 @@ loads_done:
 	.set	pop
 
 #ifdef CONFIG_MIPS_SF2000
-	li	k0, 0xa13f0000
+	li	k0, 0xa1400000
 	li	k1, 0x51510031
 	sw	k1, 20(k0)
 	sw	v0, 24(k0)
@@ -93,7 +93,7 @@ loads_done:
 	move	a0, v0
 	jal	sf2000_syscall_mark
 	nop
-	li	k0, 0xa13f0000
+	li	k0, 0xa1400000
 	li	k1, 0x51510033
 	sw	k1, 20(k0)
 	sw	v0, 24(k0)
@@ -128,7 +128,7 @@ syscall_common:
 	beqz	t2, illegal_syscall
 
 #ifdef CONFIG_MIPS_SF2000
-	li	k0, 0xa13f0000
+	li	k0, 0xa1400000
 	li	k1, 0x51510034
 	sw	k1, 20(k0)
 	sw	v0, 24(k0)
@@ -137,7 +137,7 @@ syscall_common:
 	jalr	t2			# Do The Real Thing (TM)
 	nop
 #ifdef CONFIG_MIPS_SF2000
-	li	k0, 0xa13f0000
+	li	k0, 0xa1400000
 	li	k1, 0x51510035
 	sw	k1, 20(k0)
 	sw	v0, 24(k0)
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
