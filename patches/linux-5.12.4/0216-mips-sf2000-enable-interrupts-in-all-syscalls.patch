From: SF2000 Linux contributors
Subject: [PATCH] mips: sf2000: enable interrupts in every NOMMU syscall

The early KSEG0 userspace bring-up kept almost every syscall atomic because
the old ERL return path could not safely accept interrupts.  Userspace now
runs without ERL and the return path explicitly classifies the KSEG0 alias as
userspace, so that workaround is both obsolete and incorrect.  In particular,
mount(2) reaches the buffer cache with interrupts disabled and trips the
BUG_ON(irqs_disabled()) in lookup_bh_lru().

Use the normal MIPS syscall interrupt window for every syscall.  This restores
the kernel invariant expected by sleeping filesystem, block, USB and input
operations instead of adding exceptions for individual syscall numbers.

--- a/arch/mips/kernel/scall32-o32.S
+++ b/arch/mips/kernel/scall32-o32.S
@@ -33,43 +33,9 @@ NESTED(handle_sys, PT_SIZE, sp)
 	sw	v0, 24(k0)
 	mfc0	k1, CP0_EPC
 	sw	k1, 28(k0)
-	li	k0, __NR_O32_Linux + 162
-	beq	v0, k0, sf2000_syscall_irq_on
-	 nop
-	li	k0, __NR_O32_Linux + 166
-	beq	v0, k0, sf2000_syscall_irq_on
-	 nop
-	li	k0, __NR_O32_Linux + 118
-	beq	v0, k0, sf2000_syscall_irq_on
-	 nop
-	lw	k1, PT_STATUS(sp)
-	andi	k1, ST0_ERL
-	bnez	k1, sf2000_erl_syscall_irq_off
-	 nop
-	lw	k1, PT_EPC(sp)
-	li	k0, 0xe0000000
-	and	k1, k0
-	li	k0, 0x80000000
-	beq	k1, k0, sf2000_erl_syscall_irq_off
-	 nop
-sf2000_syscall_irq_on:
 #endif
 	TRACE_IRQS_ON_RELOAD
 	STI
-#ifdef CONFIG_MIPS_SF2000
-	b	sf2000_after_syscall_irq_state
-	 nop
-sf2000_erl_syscall_irq_off:
-	CLI
-	li	k0, 0xa1400000
-	li	k1, 0x51510430
-	sw	k1, 20(k0)
-	lw	k1, PT_STATUS(sp)
-	sw	k1, 24(k0)
-	mfc0	k1, CP0_STATUS
-	sw	k1, 28(k0)
-sf2000_after_syscall_irq_state:
-#endif
 	.set	at
 
 	lw	t1, PT_EPC(sp)		# skip syscall on return
