From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Wed, 13 May 2026 14:30:00 +0000
Subject: [PATCH] mips: sf2000: preserve prescanned HI16 originals

The 0099 device log reached /init and then failed while execing BusyBox at
the first startup LO16 after a HI16 relocation. BusyBox's relocation stream
contains LO16, HI16, LO16 for one LUI. The first LO16 correctly patches the
LUI; the later explicit HI16 relocation must refresh the stream-order latest
state from the prescanned original, not from the already patched instruction.

Keep the prescanned original instruction when a HI16 site is already known.
Also enlarge the cache and search all cached HI16 sites before falling back to
bounded instruction scanning. That gives distant HI/LO pairs a safe lookup path
without broadening raw memory scans past the loaded image.
---
 arch/mips/include/asm/flat.h | 38 +++++++++++++++++++++++++++++++----
 1 file changed, 34 insertions(+), 4 deletions(-)

diff --git a/arch/mips/include/asm/flat.h b/arch/mips/include/asm/flat.h
index c191e15..7205d9a 100644
--- a/arch/mips/include/asm/flat.h
+++ b/arch/mips/include/asm/flat.h
@@ -11,7 +11,7 @@
 #define FLAT_MIPS_R_LO16	0xc0000000
 #define FLAT_MIPS_R_MASK	0xc0000000
 #define FLAT_MIPS_R_ADDR	0x3fffffff
-#define FLAT_MIPS_HI16_SLOTS	4096
+#define FLAT_MIPS_HI16_SLOTS	32768
 #define FLAT_MIPS_HI16_SCAN	4096
 
 static u32 __user *flat_mips_hi16_rp;
@@ -71,7 +71,7 @@ static inline void flat_mips_store_hi16(u32 __user *rp, u32 insn, int latest)
 		flat_mips_hi16_insn = insn;
 	}
 
-	for (i = 0; i < 8; i++) {
+	for (i = 0; i < 64; i++) {
 		unsigned long idx = (slot + i) & (FLAT_MIPS_HI16_SLOTS - 1);
 
 		if (!flat_mips_hi16_rps[idx] || flat_mips_hi16_rps[idx] == rp) {
@@ -96,7 +96,7 @@ static inline int flat_mips_lookup_hi16(u32 __user *rp, u32 *insn)
 			     (FLAT_MIPS_HI16_SLOTS - 1);
 	int i;
 
-	for (i = 0; i < 8; i++) {
+	for (i = 0; i < 64; i++) {
 		unsigned long idx = (slot + i) & (FLAT_MIPS_HI16_SLOTS - 1);
 
 		if (flat_mips_hi16_rps[idx] == rp) {
@@ -116,7 +116,8 @@ static inline int flat_mips_find_hi16_for_lo16(u32 __user *rp, u32 lo,
 {
 	u32 *p = (__force u32 *)rp;
 	u32 rs = flat_mips_lo16_rs(lo);
-	int i;
+	int i, best = -1;
+	u32 *best_p = NULL;
 
 	if (flat_mips_hi16_rp && flat_mips_lui_rt(flat_mips_hi16_insn) == rs) {
 		u32 candidate = ((flat_mips_hi16_insn & 0xffff) << 16) +
@@ -130,6 +131,30 @@ static inline int flat_mips_find_hi16_for_lo16(u32 __user *rp, u32 lo,
 		}
 	}
 
+	for (i = 0; i < FLAT_MIPS_HI16_SLOTS; i++) {
+		u32 *scan = (__force u32 *)flat_mips_hi16_rps[i];
+		u32 candidate;
+
+		if (!scan || scan >= p)
+			continue;
+		if (flat_mips_lui_rt(flat_mips_hi16_insns[i]) != rs)
+			continue;
+
+		candidate = ((flat_mips_hi16_insns[i] & 0xffff) << 16) +
+			    (s16)(lo & 0xffff);
+		if (!flat_mips_addr_plausible(candidate))
+			continue;
+		if (!best_p || scan > best_p) {
+			best = i;
+			best_p = scan;
+		}
+	}
+	if (best >= 0) {
+		*hi_rp = flat_mips_hi16_rps[best];
+		*hi_insn = flat_mips_hi16_insns[best];
+		return 1;
+	}
+
 	for (i = 1; i <= FLAT_MIPS_HI16_SCAN; i++) {
 		u32 *scan = p - i;
 		u32 insn = get_unaligned(scan);
@@ -211,7 +237,12 @@ static inline int flat_put_addr_at_rp(u32 __user *rp, u32 addr, u32 relval)
 		put_unaligned(insn, p);
 		return 0;
 	case FLAT_MIPS_R_HI16:
-		flat_mips_remember_hi16(rp, get_unaligned(p));
+		if (flat_mips_lookup_hi16(rp, &insn)) {
+			flat_mips_hi16_rp = rp;
+			flat_mips_hi16_insn = insn;
+		} else {
+			flat_mips_remember_hi16(rp, get_unaligned(p));
+		}
 		return 0;
 	case FLAT_MIPS_R_LO16:
 		lo = get_unaligned(p);
-- 
