From 0000000000000000000000000000000000000027 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 11 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: trace post IRQ init calls

Physical hardware now records irq-status-after and irq-cause-after, so the
global IRQ enable itself is not the stop point. Add RAM-only progress marks
around the next early init calls to identify the following blocker without
adding more visible blink time.
---
 init/main.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

--- a/init/main.c
+++ b/init/main.c
@@ -152,6 +152,14 @@ static void sf2000_after_irq_enable(void)
 	sf2000_progress_mark("irq-status-after", 4, read_c0_status());
 	sf2000_progress_mark("irq-cause-after", 4, read_c0_cause());
 }
+
+static void sf2000_init_mark(const char *name)
+{
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	sf2000_progress_mark(name, 4, 0);
+}
 #endif
 
 /*
@@ -1083,26 +1091,50 @@ asmlinkage __visible void __init __no_sanitize_address start_kernel(void)
 	sf2000_after_irq_enable();
 #endif
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("before-kmem-cache-late");
+#endif
 	kmem_cache_init_late();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("after-kmem-cache-late");
+#endif
 
 	/*
 	 * HACK ALERT! This is early. We're enabling the console before
 	 * we've done PCI setups etc, and console_init() must be aware of
 	 * this. But we do want output early, in case something goes wrong.
 	 */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("before-console-init");
+#endif
 	console_init();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("after-console-init");
+#endif
 	if (panic_later)
 		panic("Too many boot %s vars at `%s'", panic_later,
 		      panic_param);
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("before-lockdep-init");
+#endif
 	lockdep_init();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("after-lockdep-init");
+#endif
 
 	/*
 	 * Need to run this when irqs are enabled, because it wants
 	 * to self-test [hard/soft]-irqs on/off lock inversion bugs
 	 * too:
 	 */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("before-locking-selftest");
+#endif
 	locking_selftest();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("after-locking-selftest");
+#endif
 
 	/*
 	 * This needs to be called before any devices perform DMA
@@ -1110,7 +1142,13 @@ asmlinkage __visible void __init __no_sanitize_address start_kernel(void)
 	 * mark the bounce buffers as decrypted so that their usage will
 	 * not cause "plain-text" data to be decrypted when accessed.
 	 */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("before-mem-encrypt");
+#endif
 	mem_encrypt_init();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("after-mem-encrypt");
+#endif
 
 #ifdef CONFIG_BLK_DEV_INITRD
 	if (initrd_start && !initrd_below_start_ok &&
-- 
