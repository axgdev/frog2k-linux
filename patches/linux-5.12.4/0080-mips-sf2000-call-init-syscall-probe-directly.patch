+	stub[165] = 0xaf5f001c; /* sw ra,28(k0) */
+	stub[166] = 0x00801025; /* move v0,a0 */
+	stub[167] = 0x00a02025; /* move a0,a1 */
+	stub[168] = 0x00c02825; /* move a1,a2 */
+	stub[169] = 0x00e03025; /* move a2,a3 */
+	stub[170] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[171] = 0x377b000c; /* ori k1,k1,12 */
+	stub[172] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[173] = 0xaf420018; /* sw v0,24(k0) */
+	stub[174] = 0xaf44001c; /* sw a0,28(k0) */
+	stub[175] = 0x0000000c; /* syscall */
+	stub[176] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[177] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[178] = 0x377b000d; /* ori k1,k1,13 */
+	stub[179] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[180] = 0xaf420018; /* sw v0,24(k0) */
+	stub[181] = 0xaf47001c; /* sw a3,28(k0) */
+	stub[182] = 0x3c1b0000 | (((syscall_target + 20) >> 16) & 0xffff);
+	stub[183] = 0x377b0000 | ((syscall_target + 20) & 0xffff);
+	stub[184] = 0x03600008; /* jr k1 */
+	stub[185] = 0x00000000; /* nop */
 	entry_text[0] = 0x3c1b0000 | ((probe >> 16) & 0xffff);
 	entry_text[1] = 0x377b0000 | (probe & 0xffff);
 	entry_text[2] = 0x03600008; /* jr k1 */
 	entry_text[3] = 0x00000000; /* nop */
