From 0000000000000000000000000000000000000080 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: call copied init syscall probe directly

The syscall-wrapper-probe image still stops at marker 0x5151000a and does not
reach the patched wrapper marker. Avoid another ambiguous KSEG0 instruction
cache fetch by emulating the first jal from the entry probe: set ra to the
post-call address, execute the original delay-slot stack store, then jump
directly to the syscall probe in the identity stub page.

Keep the wrapper patch installed for later calls, but move the syscall probe
farther down the stub page so the expanded entry handoff has room. Add a sync
after the 0x5151000a retained writes and a new marker 0x5151000e immediately
before the direct syscall-probe jump.
---
 fs/binfmt_elf.c | 55 ++++++++++++++++++++++++++++++------------------
 1 file changed, 35 insertions(+), 20 deletions(-)

--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -227,7 +227,7 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 	unsigned long probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
 		96 * sizeof(u32));
 	unsigned long syscall_probe = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
-		128 * sizeof(u32));
+		160 * sizeof(u32));
 	unsigned long trampoline = CKSEG0ADDR(SF2000_IDENTITY_STUB_ADDR +
 		64 * sizeof(u32));
 	unsigned int i;
@@ -287,37 +287,48 @@ static void sf2000_elf_copy_identity_stub(unsigned long entry,
 	stub[117] = 0xaf5b0014; /* sw k1,20(k0) */
 	stub[118] = 0xaf5d0018; /* sw sp,24(k0) */
 	stub[119] = 0xaf45001c; /* sw a1,28(k0) */
-	stub[120] = 0x3c1b0000 | (((target + 44) >> 16) & 0xffff);
-	stub[121] = 0x377b0000 | ((target + 44) & 0xffff);
-	stub[122] = 0x03600008; /* jr k1 */
-	stub[123] = 0x00000000; /* nop */
-	stub[128] = 0x3c1aa13f; /* lui k0,0xa13f */
-	stub[129] = 0x3c1b5151; /* lui k1,0x5151 */
-	stub[130] = 0x377b000b; /* ori k1,k1,11 */
-	stub[131] = 0xaf5b0014; /* sw k1,20(k0) */
-	stub[132] = 0xaf5d0018; /* sw sp,24(k0) */
-	stub[133] = 0xaf5f001c; /* sw ra,28(k0) */
-	stub[134] = 0x00801025; /* move v0,a0 */
-	stub[135] = 0x00a02025; /* move a0,a1 */
-	stub[136] = 0x00c02825; /* move a1,a2 */
-	stub[137] = 0x00e03025; /* move a2,a3 */
-	stub[138] = 0x3c1b5151; /* lui k1,0x5151 */
-	stub[139] = 0x377b000c; /* ori k1,k1,12 */
-	stub[140] = 0xaf5b0014; /* sw k1,20(k0) */
-	stub[141] = 0xaf420018; /* sw v0,24(k0) */
-	stub[142] = 0xaf44001c; /* sw a0,28(k0) */
-	stub[143] = 0x0000000c; /* syscall */
-	stub[144] = 0x3c1aa13f; /* lui k0,0xa13f */
-	stub[145] = 0x3c1b5151; /* lui k1,0x5151 */
-	stub[146] = 0x377b000d; /* ori k1,k1,13 */
-	stub[147] = 0xaf5b0014; /* sw k1,20(k0) */
-	stub[148] = 0xaf420018; /* sw v0,24(k0) */
-	stub[149] = 0xaf47001c; /* sw a3,28(k0) */
-	stub[150] = 0x3c1b0000 | (((syscall_target + 20) >> 16) & 0xffff);
-	stub[151] = 0x377b0000 | ((syscall_target + 20) & 0xffff);
-	stub[152] = 0x03600008; /* jr k1 */
-	stub[153] = 0x00000000; /* nop */
+	stub[120] = 0x0000000f; /* sync */
+	stub[121] = 0x3c1f0000 | (((target + 52) >> 16) & 0xffff);
+	stub[122] = 0x37ff0000 | ((target + 52) & 0xffff);
+	stub[123] = 0xafb00010; /* sw s0,16(sp) */
+	stub[124] = 0x3c1aa13f; /* lui k0,0xa13f */
+	stub[125] = 0x3c1b5151; /* lui k1,0x5151 */
+	stub[126] = 0x377b000e; /* ori k1,k1,14 */
+	stub[127] = 0xaf5b0014; /* sw k1,20(k0) */
+	stub[128] = 0xaf5f0018; /* sw ra,24(k0) */
+	stub[129] = 0xaf45001c; /* sw a1,28(k0) */
+	stub[130] = 0x0000000f; /* sync */
+	stub[131] = 0x3c1b0000 | ((syscall_probe >> 16) & 0xffff);
+	stub[132] = 0x377b0000 | (syscall_probe & 0xffff);
+	stub[133] = 0x03600008; /* jr k1 */
+	stub[134] = 0x00000000; /* nop */
