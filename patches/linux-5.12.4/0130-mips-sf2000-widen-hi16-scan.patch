From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Wed, 13 May 2026 07:10:00 +0000
Subject: [PATCH] mips: sf2000: widen HI16 scan window

BusyBox has functions where one LUI feeds repeated LO16 uses more than
32 instructions later. Keep the backward scan local, but widen it enough
to cover these normal generated sequences.
---
 arch/mips/include/asm/flat.h | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/mips/include/asm/flat.h b/arch/mips/include/asm/flat.h
index c365019..bcb21ef 100644
--- a/arch/mips/include/asm/flat.h
+++ b/arch/mips/include/asm/flat.h
@@ -10,6 +10,7 @@
 #define FLAT_MIPS_R_MASK	0xc0000000
 #define FLAT_MIPS_R_ADDR	0x3fffffff
 #define FLAT_MIPS_HI16_SLOTS	4096
+#define FLAT_MIPS_HI16_SCAN	128
 
 static u32 __user *flat_mips_hi16_rp;
 static u32 flat_mips_hi16_insn;
@@ -84,7 +85,7 @@ static inline int flat_mips_find_hi16_for_lo16(u32 __user *rp, u32 lo,
 	u32 rs = flat_mips_lo16_rs(lo);
 	int i;
 
-	for (i = 1; i <= 32; i++) {
+	for (i = 1; i <= FLAT_MIPS_HI16_SCAN; i++) {
 		u32 *scan = p - i;
 		u32 insn = get_unaligned(scan);
 
-- 
2.49.0

