From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 19:48:00 +0000
Subject: [PATCH] mips: sf2000: install init entry page directly

The physical SF2000 watchdog log stops after the first get_user_pages() based
prefault marker for the /init ELF entry. That shows the normal user fault path
is still the hardware blocker; the diagnostic prefault reproduces the same
failure before the kernel can even try to return to userspace.

Avoid taking that fault for the first instruction page. Allocate a clean page,
read the ELF page containing the entry point from the executable file, and
insert it into the executable VMA under the mmap write lock. Keep detailed RAM
markers around each step so the next physical run can tell whether the direct
install succeeds and whether the final return reaches userspace.
---
 fs/binfmt_elf.c | 77 +++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 72 insertions(+), 5 deletions(-)

diff --git a/fs/binfmt_elf.c b/fs/binfmt_elf.c
index 9bb9c4c85..ce6c4633f 100644
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -65,26 +65,81 @@ static void sf2000_elf_value(const char *name, unsigned int value)
 		sf2000_progress_mark(name, 8, value);
 }
 
-static void sf2000_elf_prefault(const char *name, unsigned long address)
+static int sf2000_elf_install_entry_page(struct file *file,
+		const struct elf_phdr *phdrs, int phnum, unsigned long entry)
 {
-	struct page *page = NULL;
-	long ret;
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	struct page *page;
+	void *kaddr;
+	unsigned long address = entry & PAGE_MASK;
+	loff_t pos = 0;
+	int i;
+	int ret = -EINVAL;
 
 	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
-		return;
+		return 0;
 
-	sf2000_elf_value(name, (unsigned int)address);
-	ret = get_user_pages(address & PAGE_MASK, 1, FOLL_FORCE, &page, NULL);
-	sf2000_elf_value("elf-prefault-ret", (unsigned int)ret);
-	if (page) {
-		sf2000_elf_value("elf-prefault-page", (unsigned int)page);
-		put_page(page);
+	sf2000_elf_value("elf-entry-install-addr", (unsigned int)address);
+	for (i = 0; i < phnum; i++) {
+		unsigned long map_start;
+		unsigned long map_end;
+
+		if (phdrs[i].p_type != PT_LOAD)
+			continue;
+		map_start = phdrs[i].p_vaddr & PAGE_MASK;
+		map_end = phdrs[i].p_vaddr + phdrs[i].p_filesz;
+		if (address >= map_start && address < map_end) {
+			pos = phdrs[i].p_offset -
+				(phdrs[i].p_vaddr & ~PAGE_MASK) +
+				(address - map_start);
+			ret = 0;
+			break;
+		}
 	}
+	sf2000_elf_value("elf-entry-install-pos", (unsigned int)pos);
+	if (ret)
+		return ret;
+
+	page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!page)
+		return -ENOMEM;
+	sf2000_elf_value("elf-entry-install-page", (unsigned int)page);
+
+	kaddr = kmap(page);
+	sf2000_elf_value("elf-entry-before-read", (unsigned int)pos);
+	ret = kernel_read(file, kaddr, PAGE_SIZE, &pos);
+	sf2000_elf_value("elf-entry-after-read", (unsigned int)ret);
+	kunmap(page);
+	if (ret < 0)
+		goto out_page;
+
+	flush_dcache_page(page);
+
+	mmap_write_lock(mm);
+	sf2000_elf_mark("elf-entry-before-vma");
+	vma = find_vma(mm, address);
+	sf2000_elf_value("elf-entry-vma", (unsigned int)vma);
+	if (!vma || address < vma->vm_start) {
+		ret = -EFAULT;
+		goto out_unlock;
+	}
+	ret = vm_insert_page(vma, address, page);
+	sf2000_elf_value("elf-entry-insert-ret", (unsigned int)ret);
+out_unlock:
+	mmap_write_unlock(mm);
+out_page:
+	put_page(page);
+	return ret;
 }
 #else
 static inline void sf2000_elf_mark(const char *name) { }
 static inline void sf2000_elf_value(const char *name, unsigned int value) { }
-static inline void sf2000_elf_prefault(const char *name, unsigned long address) { }
+static inline int sf2000_elf_install_entry_page(struct file *file,
+		const struct elf_phdr *phdrs, int phnum, unsigned long entry)
+{
+	return 0;
+}
 #endif
 
 #ifndef ELF_COMPAT
@@ -1294,8 +1349,6 @@ static int load_elf_binary(struct linux_binprm *bprm)
 		}
 	}
 
-	kfree(elf_phdata);
-
 	set_binfmt(&elf_format);
 
 #ifdef ARCH_HAS_SETUP_ADDITIONAL_PAGES
@@ -1363,13 +1416,17 @@ static int load_elf_binary(struct linux_binprm *bprm)
 
 	finalize_exec(bprm);
 	sf2000_elf_mark("elf-after-finalize");
-	sf2000_elf_prefault("elf-prefault-entry", elf_entry);
-	sf2000_elf_prefault("elf-prefault-stack", bprm->p);
+	retval = sf2000_elf_install_entry_page(bprm->file, elf_phdata,
+			elf_ex->e_phnum, elf_entry - load_bias);
+	sf2000_elf_value("elf-entry-install-ret", (unsigned int)retval);
+	if (retval)
+		goto out;
 	sf2000_elf_value("elf-before-start-thread", (unsigned int)elf_entry);
 	START_THREAD(elf_ex, regs, elf_entry, bprm->p);
 	sf2000_elf_value("elf-after-start-thread", (unsigned int)bprm->p);
 	retval = 0;
 out:
+	kfree(elf_phdata);
 	return retval;
 
 	/* error cleanup */
@@ -1381,6 +1438,7 @@ out_free_dentry:
 		fput(interpreter);
 out_free_ph:
 	kfree(elf_phdata);
+	elf_phdata = NULL;
 	goto out;
 }
 
-- 
2.50.1
