--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -456,1 +456,9 @@
+config SF2000_PANEL_SYNC
+	bool "SF2000 ST7789 RGB frame synchronizer"
+	depends on MIPS_SF2000
+	help
+	  Service the SF2000 panel's tearing-effect GPIO interrupt and perform
+	  the CASET/RASET/RAMWR transaction required by the vendor ST7789 driver
+	  for continuous parallel-RGB scanout.
+
 source "drivers/misc/c2port/Kconfig"
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -59,1 +59,2 @@
 obj-$(CONFIG_SF2000_GE)		+= sf2000-ge.o
+obj-$(CONFIG_SF2000_PANEL_SYNC)	+= sf2000-panel-sync.o
--- /dev/null
+++ b/drivers/misc/sf2000-panel-sync.c
@@ -0,0 +1,335 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Data Frog SF2000 ST7789 frame synchronizer.
+ *
+ * The recovered HCRToS st7789v2 driver handles every L08 TE rising edge by
+ * returning the shared RGB/8080 pads to GPIO, issuing CASET/RASET/RAMWR, and
+ * reconnecting RGB.  This driver reproduces that steady-state transaction
+ * after userspace has established an immutable GMA scanout descriptor.
+ */
+
+#include <linux/bitops.h>
+#include <linux/fs.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/uaccess.h>
+
+#define SF2000_PANEL_IOC_MAGIC		'p'
+#define SF2000_PANEL_SYNC_ENABLE	_IO(SF2000_PANEL_IOC_MAGIC, 0)
+#define SF2000_PANEL_SYNC_DISABLE	_IO(SF2000_PANEL_IOC_MAGIC, 1)
+#define SF2000_PANEL_SYNC_COUNT		_IOR(SF2000_PANEL_IOC_MAGIC, 2, __u32)
+#define SF2000_PANEL_SYNC_MINOR		244
+
+#define PINMUX_L			0x4a0
+#define PINMUX_T			0x500
+#define GPIO_L				0x044
+#define GPIO_T				0x344
+#define GPIO_RISE_ENABLE		0x04
+#define GPIO_FALL_ENABLE		0x08
+#define GPIO_OUTPUT			0x10
+#define GPIO_DIRECTION			0x14
+#define GPIO_STATUS			0x18
+#define VOU_MODE			0x00
+#define VOU_CONTROL			0x84
+
+#define TE_BIT				BIT(8)
+#define L_DATA_MASK			0x0000007c
+#define T_DATA_MASK			0x00007e7c
+#define L_OUTPUT_MASK			(BIT(1) | L_DATA_MASK | BIT(7) | BIT(10))
+#define T_OUTPUT_MASK			(BIT(0) | BIT(1) | GENMASK(6, 2) | \
+						 GENMASK(14, 9))
+
+#define ST7789_CASET			0x2a
+#define ST7789_RASET			0x2b
+#define ST7789_RAMWR			0x2c
+
+struct sf2000_panel_sync {
+	struct device *dev;
+	void __iomem *sys;
+	void __iomem *vou;
+	struct miscdevice misc;
+	int irq;
+	bool irq_requested;
+	bool enabled;
+	u32 edges;
+};
+
+static inline u32 ps_read(struct sf2000_panel_sync *ps, u32 off)
+{
+	return readl(ps->sys + off);
+}
+
+static inline void ps_write(struct sf2000_panel_sync *ps, u32 off, u32 value)
+{
+	writel(value, ps->sys + off);
+}
+
+static void ps_gpio_set(struct sf2000_panel_sync *ps, u32 bank, u32 bit,
+			bool high)
+{
+	u32 value = ps_read(ps, bank + GPIO_OUTPUT);
+
+	if (high)
+		value |= bit;
+	else
+		value &= ~bit;
+	ps_write(ps, bank + GPIO_OUTPUT, value);
+}
+
+static void ps_bus_value(struct sf2000_panel_sync *ps, u16 value)
+{
+	u32 l = ps_read(ps, GPIO_L + GPIO_OUTPUT);
+	u32 t = ps_read(ps, GPIO_T + GPIO_OUTPUT);
+
+	l = (l & ~L_DATA_MASK) | ((u32)(value & 0x001f) << 2);
+	t = (t & ~T_DATA_MASK) | ((u32)(value & 0x07e0) << 4) |
+	    (((u32)value >> 9) & 0x7c);
+	ps_write(ps, GPIO_L + GPIO_OUTPUT, l);
+	ps_write(ps, GPIO_T + GPIO_OUTPUT, t);
+}
+
+static void ps_write16(struct sf2000_panel_sync *ps, bool data, u16 value)
+{
+	/* RS=T01, CS=L10, WR=L07; identical to the vendor GPIO fast write. */
+	ps_gpio_set(ps, GPIO_T, BIT(1), data);
+	ps_gpio_set(ps, GPIO_L, BIT(10), false);
+	ps_bus_value(ps, value);
+	ps_gpio_set(ps, GPIO_L, BIT(7), false);
+	ps_gpio_set(ps, GPIO_L, BIT(7), true);
+	ps_gpio_set(ps, GPIO_L, BIT(10), true);
+	ps_gpio_set(ps, GPIO_T, BIT(1), true);
+}
+
+static void ps_command(struct sf2000_panel_sync *ps, u8 command)
+{
+	ps_write16(ps, false, command);
+}
+
+static void ps_data(struct sf2000_panel_sync *ps, u16 data)
+{
+	ps_write16(ps, true, data);
+}
+
+static void ps_gpio_mux(struct sf2000_panel_sync *ps)
+{
+	/*
+	 * pinmux-control from the proven SF2000 st7789v2 device-tree node.
+	 * L09/PRGB_VSYNC is deliberately preserved: it belongs to the global
+	 * RGB state and is not one of the shared LCD bus pads.
+	 */
+	ps_write(ps, PINMUX_L + 0x04, 0);
+	ps_write(ps, PINMUX_L + 0x08,
+		 ps_read(ps, PINMUX_L + 0x08) & 0xff00ffff);
+	ps_write(ps, PINMUX_L + 0x00,
+		 ps_read(ps, PINMUX_L + 0x00) & 0x0000ffff);
+	ps_write(ps, PINMUX_T + 0x08,
+		 ps_read(ps, PINMUX_T + 0x08) & 0x000000ff);
+	ps_write(ps, PINMUX_T + 0x0c,
+		 ps_read(ps, PINMUX_T + 0x0c) & 0xff000000);
+	ps_write(ps, PINMUX_T + 0x00,
+		 ps_read(ps, PINMUX_T + 0x00) & 0x0000ffff);
+	ps_write(ps, PINMUX_T + 0x04,
+		 ps_read(ps, PINMUX_T + 0x04) & 0xff000000);
+}
+
+static void ps_rgb_mux(struct sf2000_panel_sync *ps)
+{
+	/* pinmux-rgb plus lcd_pinmux_rgb(true) VOU selection. */
+	writel(readl(ps->vou + VOU_CONTROL) & ~BIT(8),
+	       ps->vou + VOU_CONTROL);
+	writel((readl(ps->vou + VOU_MODE) & ~0xff) | 0x15,
+	       ps->vou + VOU_MODE);
+	ps_write(ps, PINMUX_L + 0x04, 0xb6060606);
+	ps_write(ps, PINMUX_L + 0x00,
+		 (ps_read(ps, PINMUX_L + 0x00) & 0x0000ffff) | 0x06060000);
+	ps_write(ps, PINMUX_T + 0x08,
+		 (ps_read(ps, PINMUX_T + 0x08) & 0x000000ff) | 0x06060600);
+	ps_write(ps, PINMUX_T + 0x0c,
+		 (ps_read(ps, PINMUX_T + 0x0c) & 0xff000000) | 0x00060606);
+	ps_write(ps, PINMUX_T + 0x00,
+		 (ps_read(ps, PINMUX_T + 0x00) & 0x0000ffff) | 0x06060000);
+	ps_write(ps, PINMUX_T + 0x04,
+		 (ps_read(ps, PINMUX_T + 0x04) & 0xff000000) | 0x00060606);
+	ps_write(ps, PINMUX_L + 0x08,
+		 (ps_read(ps, PINMUX_L + 0x08) & 0xff00ffff) | 0x00060000);
+}
+
+static void ps_configure_outputs(struct sf2000_panel_sync *ps)
+{
+	u32 value;
+
+	value = ps_read(ps, GPIO_L + GPIO_DIRECTION);
+	ps_write(ps, GPIO_L + GPIO_DIRECTION,
+		 (value | L_OUTPUT_MASK) & ~TE_BIT);
+	value = ps_read(ps, GPIO_T + GPIO_DIRECTION);
+	ps_write(ps, GPIO_T + GPIO_DIRECTION, value | T_OUTPUT_MASK);
+	ps_gpio_set(ps, GPIO_L, BIT(10), true);
+	ps_gpio_set(ps, GPIO_T, BIT(1), true);
+	ps_gpio_set(ps, GPIO_L, BIT(7), true);
+	ps_gpio_set(ps, GPIO_T, BIT(0), true);
+}
+
+static void ps_restart_frame(struct sf2000_panel_sync *ps)
+{
+	ps_command(ps, ST7789_CASET);
+	ps_data(ps, 0);
+	ps_data(ps, 0);
+	ps_data(ps, 1);
+	ps_data(ps, 0x3f);
+	ps_command(ps, ST7789_RASET);
+	ps_data(ps, 0);
+	ps_data(ps, 0);
+	ps_data(ps, 0);
+	ps_data(ps, 0xef);
+	ps_command(ps, ST7789_RAMWR);
+}
+
+static irqreturn_t sf2000_panel_sync_irq(int irq, void *data)
+{
+	struct sf2000_panel_sync *ps = data;
+
+	if (!(ps_read(ps, GPIO_L + GPIO_STATUS) & TE_BIT))
+		return IRQ_NONE;
+
+	/* HC15xx GPIO pending bits are write-one-to-clear. */
+	ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
+	if (!READ_ONCE(ps->enabled))
+		return IRQ_HANDLED;
+
+	ps_gpio_mux(ps);
+	ps_configure_outputs(ps);
+	ps_restart_frame(ps);
+	ps_rgb_mux(ps);
+	WRITE_ONCE(ps->edges, READ_ONCE(ps->edges) + 1);
+	return IRQ_HANDLED;
+}
+
+static int sf2000_panel_sync_start(struct sf2000_panel_sync *ps)
+{
+	u32 value;
+	int ret;
+
+	if (!ps->irq_requested) {
+		ret = request_irq(ps->irq, sf2000_panel_sync_irq, 0,
+				  dev_name(ps->dev), ps);
+		if (ret)
+			return ret;
+		ps->irq_requested = true;
+	}
+
+	WRITE_ONCE(ps->edges, 0);
+	ps_configure_outputs(ps);
+	value = ps_read(ps, GPIO_L + GPIO_FALL_ENABLE);
+	ps_write(ps, GPIO_L + GPIO_FALL_ENABLE, value & ~TE_BIT);
+	value = ps_read(ps, GPIO_L + GPIO_RISE_ENABLE);
+	ps_write(ps, GPIO_L + GPIO_RISE_ENABLE, value | TE_BIT);
+	ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
+	WRITE_ONCE(ps->enabled, true);
+	value = ps_read(ps, GPIO_L);
+	ps_write(ps, GPIO_L, value | TE_BIT);
+	return 0;
+}
+
+static void sf2000_panel_sync_stop(struct sf2000_panel_sync *ps)
+{
+	u32 value = ps_read(ps, GPIO_L);
+
+	WRITE_ONCE(ps->enabled, false);
+	ps_write(ps, GPIO_L, value & ~TE_BIT);
+	ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
+}
+
+static long sf2000_panel_sync_ioctl(struct file *file, unsigned int cmd,
+				    unsigned long arg)
+{
+	struct miscdevice *misc = file->private_data;
+	struct sf2000_panel_sync *ps =
+		container_of(misc, struct sf2000_panel_sync, misc);
+
+	switch (cmd) {
+	case SF2000_PANEL_SYNC_ENABLE:
+		return sf2000_panel_sync_start(ps);
+	case SF2000_PANEL_SYNC_DISABLE:
+		sf2000_panel_sync_stop(ps);
+		return 0;
+	case SF2000_PANEL_SYNC_COUNT:
+		return put_user(READ_ONCE(ps->edges), (u32 __user *)arg);
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations sf2000_panel_sync_fops = {
+	.owner = THIS_MODULE,
+	.unlocked_ioctl = sf2000_panel_sync_ioctl,
+	.llseek = no_llseek,
+};
+
+static int sf2000_panel_sync_probe(struct platform_device *pdev)
+{
+	struct sf2000_panel_sync *ps;
+	u32 value;
+	int ret;
+
+	ps = devm_kzalloc(&pdev->dev, sizeof(*ps), GFP_KERNEL);
+	if (!ps)
+		return -ENOMEM;
+	ps->dev = &pdev->dev;
+	ps->sys = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ps->sys))
+		return PTR_ERR(ps->sys);
+	ps->vou = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(ps->vou))
+		return PTR_ERR(ps->vou);
+	/* Quiesce the bootloader-owned TE source before Linux requests it. */
+	value = ps_read(ps, GPIO_L);
+	ps_write(ps, GPIO_L, value & ~TE_BIT);
+	ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
+	ps->irq = platform_get_irq(pdev, 0);
+	if (ps->irq < 0)
+		return ps->irq;
+	ps->misc.minor = SF2000_PANEL_SYNC_MINOR;
+	ps->misc.name = "sf2000-panel-sync";
+	ps->misc.fops = &sf2000_panel_sync_fops;
+	ps->misc.parent = &pdev->dev;
+	ret = misc_register(&ps->misc);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, ps);
+	dev_info(&pdev->dev, "TE frame synchronizer ready\n");
+	return 0;
+}
+
+static int sf2000_panel_sync_remove(struct platform_device *pdev)
+{
+	struct sf2000_panel_sync *ps = platform_get_drvdata(pdev);
+
+	sf2000_panel_sync_stop(ps);
+	if (ps->irq_requested)
+		free_irq(ps->irq, ps);
+	misc_deregister(&ps->misc);
+	return 0;
+}
+
+static const struct of_device_id sf2000_panel_sync_of_match[] = {
+	{ .compatible = "hichip,sf2000-panel-sync" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sf2000_panel_sync_of_match);
+
+static struct platform_driver sf2000_panel_sync_driver = {
+	.probe = sf2000_panel_sync_probe,
+	.remove = sf2000_panel_sync_remove,
+	.driver = {
+		.name = "sf2000-panel-sync",
+		.of_match_table = sf2000_panel_sync_of_match,
+	},
+};
+module_platform_driver(sf2000_panel_sync_driver);
+
+MODULE_DESCRIPTION("SF2000 ST7789 TE frame synchronizer");
+MODULE_LICENSE("GPL");
