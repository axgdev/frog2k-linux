From 0000000000000000000000000000000000000096 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: track the dynamic init entry for stub handoff

The 0068 physical log showed /init entering at 0x004000b0, but the SF2000
return hook was still comparing the saved EPC against the older hard-coded
0x004002f0 address. That prevented the hook from redirecting the first init
return through the copied KSEG0 stub; hardware then tried to eret directly to
low memory with ERL set and never reached the first userspace syscall.

Remember the real first-init PC in start_thread() and compare against that
value in the final restore hook. Keep a negative marker so the next device log
shows if the final EPC no longer matches the stored init entry.
---
 arch/mips/kernel/process.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

--- a/arch/mips/kernel/process.c
+++ b/arch/mips/kernel/process.c
@@ -55,9 +55,9 @@ extern void sf2000_progress_mark(const char *name, unsigned int kind,
 extern int sf2000_rom_handoff_present(void);
 int sf2000_identity_branch_enabled;
 unsigned long sf2000_identity_init_sp;
+static unsigned long sf2000_identity_init_pc;
 static bool sf2000_identity_handoff_used;
 
-#define SF2000_INIT_ENTRY 0x004002f0UL
 #define SF2000_IDENTITY_STUB_KSEG0 0x80401000UL
 
 static bool sf2000_identity_userspace_enabled(void)
@@ -99,7 +99,7 @@ void sf2000_ret_before_restore(struct pt_regs *regs)
 
 	sf2000_progress_mark("ret-restore-errorepc-before", 9,
 		read_c0_errorepc());
-	if (regs->cp0_epc == SF2000_INIT_ENTRY) {
+	if (regs->cp0_epc == sf2000_identity_init_pc) {
 		sf2000_progress_mark("ret-restore-stub-epc", 9,
 			SF2000_IDENTITY_STUB_KSEG0);
 		regs->cp0_epc = SF2000_IDENTITY_STUB_KSEG0;
@@ -112,6 +112,8 @@ void sf2000_ret_before_restore(struct pt_regs *regs)
 			SF2000_IDENTITY_STUB_KSEG0);
 		write_c0_errorepc(SF2000_IDENTITY_STUB_KSEG0);
 	} else {
+		sf2000_progress_mark("ret-restore-non-init-pc", 9,
+			sf2000_identity_init_pc);
 		write_c0_errorepc(regs->cp0_epc);
 	}
 	sf2000_progress_mark("ret-restore-epc-after", 9, regs->cp0_epc);
@@ -138,6 +140,7 @@ void start_thread(struct pt_regs * regs, unsigned long pc, unsigned long sp)
 			goto normal_user_status;
 		sf2000_identity_handoff_used = true;
 		sf2000_identity_branch_enabled = 1;
+		sf2000_identity_init_pc = pc;
 		status |= ST0_ERL;
 		status &= ~ST0_EXL;
 		status &= ~KU_MASK;
-- 
