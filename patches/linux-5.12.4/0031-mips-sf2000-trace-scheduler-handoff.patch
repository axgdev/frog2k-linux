From 0000000000000000000000000000000000000031 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 11 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: trace scheduler handoff

Hardware now reaches rest-before-schedule with valid init and kthreadd
tasks. Add RAM progress markers in kernel_init(), kernel_init_freeable(),
and kthreadd() to identify whether the first schedule reaches PID 1 and
which setup phase stops next. Also shorten physical pulse delays now that
the RAM boot log is the primary diagnostic channel.

--- a/arch/mips/kernel/setup.c	2026-05-11 16:00:07.237855753 +0000
+++ b/arch/mips/kernel/setup.c	2026-05-11 16:30:53.931108003 +0000
@@ -85,11 +85,11 @@
 #define SF2000_PIN_R05 5
 #define SF2000_STATUS_L25 (1u << SF2000_PIN_L25)
 #define SF2000_BACKLIGHT_R05 (1u << SF2000_PIN_R05)
-#define SF2000_STAGE_OFF_TICKS 0x00400000u
-#define SF2000_STAGE_ON_TICKS 0x00200000u
-#define SF2000_STAGE_GAP_TICKS 0x00600000u
-#define SF2000_TICK_OFF_TICKS 0x00200000u
-#define SF2000_TICK_GAP_TICKS 0x00400000u
+#define SF2000_STAGE_OFF_TICKS 0x00080000u
+#define SF2000_STAGE_ON_TICKS 0x00040000u
+#define SF2000_STAGE_GAP_TICKS 0x000c0000u
+#define SF2000_TICK_OFF_TICKS 0x00040000u
+#define SF2000_TICK_GAP_TICKS 0x00080000u
 #define SF2000_QEMU_DIRECT_DELAY_SHIFT 12
 #define SF2000_GMA_KSEG1 ((volatile unsigned char *)CKSEG1ADDR(0x18808000))
 #define SF2000_GMA_DESC_KSEG1 ((volatile unsigned int *)CKSEG1ADDR(0x00f00000))
--- a/arch/mips/mm/tlb-r4k.c	2026-05-11 15:10:50.498191758 +0000
+++ b/arch/mips/mm/tlb-r4k.c	2026-05-11 16:30:53.935108003 +0000
@@ -42,8 +42,8 @@
 #define SF2000_PIN_R05 5
 #define SF2000_STATUS_L25 (1u << SF2000_PIN_L25)
 #define SF2000_BACKLIGHT_R05 (1u << SF2000_PIN_R05)
-#define SF2000_TLB_TICK_OFF_TICKS 0x03000000u
-#define SF2000_TLB_TICK_GAP_TICKS 0x08000000u
+#define SF2000_TLB_TICK_OFF_TICKS 0x00080000u
+#define SF2000_TLB_TICK_GAP_TICKS 0x000c0000u
 #define SF2000_QEMU_DIRECT_DELAY_SHIFT 12
 
 static unsigned int sf2000_tlb_cp0_count(void)
--- a/init/main.c	2026-05-11 16:31:45.690171388 +0000
+++ b/init/main.c	2026-05-11 16:31:16.111108014 +0000
@@ -1743,15 +1743,29 @@
 {
 	int ret;
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-init-entry");
+	sf2000_init_mark("kernel-init-before-freeable");
+#endif
 	kernel_init_freeable();
 #ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-init-after-freeable");
+#endif
+#ifdef CONFIG_MIPS
 	sf2000_visible_stage_nolog("before-run-init", 9);
+	sf2000_init_mark("kernel-init-before-async");
 #endif
 	/* need to finish all async __init code before freeing the memory */
 	async_synchronize_full();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-init-after-async");
+#endif
 	kprobe_free_init_mem();
 	ftrace_free_init_mem();
 	kgdb_free_init_mem();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-init-before-free-initmem");
+#endif
 	free_initmem();
 	mark_readonly();
 
@@ -1765,8 +1779,14 @@
 	numa_default_policy();
 
 	rcu_end_inkernel_boot();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-init-before-sysctl");
+#endif
 
 	do_sysctl_args();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-init-before-run-init");
+#endif
 
 	if (ramdisk_execute_command) {
 		ret = run_init_process(ramdisk_execute_command);
@@ -1826,10 +1846,16 @@
 
 static noinline void __init kernel_init_freeable(void)
 {
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-entry");
+#endif
 	/*
 	 * Wait until kthreadd is all set-up.
 	 */
 	wait_for_completion(&kthreadd_done);
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-kthreadd");
+#endif
 
 	/* Now the scheduler is fully set up and can do blocking allocations */
 	gfp_allowed_mask = __GFP_BITS_MASK;
@@ -1841,38 +1867,86 @@
 
 	cad_pid = task_pid(current);
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-smp-prepare");
+#endif
 	smp_prepare_cpus(setup_max_cpus);
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-smp-prepare");
+#endif
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-workqueue");
+#endif
 	workqueue_init();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-workqueue");
+#endif
 
 	init_mm_internals();
 
 	rcu_init_tasks_generic();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-pre-smp");
+#endif
 	do_pre_smp_initcalls();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-pre-smp");
+#endif
 	lockup_detector_init();
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-smp-init");
+#endif
 	smp_init();
 	sched_init_smp();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-sched-smp");
+#endif
 
 	padata_init();
 	page_alloc_init_late();
 	/* Initialize page ext after all struct pages are initialized. */
 	page_ext_init();
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-basic");
+#endif
 	do_basic_setup();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-basic");
+#endif
 
 	kunit_run_all_tests();
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-console");
+#endif
 	console_on_rootfs();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-console");
+#endif
 
 	/*
 	 * check if there is an early userspace init.  If yes, let it do all
 	 * the work
 	 */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-before-init-check");
+#endif
 	if (init_eaccess(ramdisk_execute_command) != 0) {
+#ifdef CONFIG_MIPS
+		sf2000_init_mark("kernel-freeable-before-namespace");
+#endif
 		ramdisk_execute_command = NULL;
 		prepare_namespace();
+#ifdef CONFIG_MIPS
+		sf2000_init_mark("kernel-freeable-after-namespace");
+#endif
 	}
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-init-check");
+#endif
 
 	/*
 	 * Ok, we have completed the initial bootup, and
@@ -1884,4 +1958,7 @@
 	 */
 
 	integrity_load_keys();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("kernel-freeable-after-integrity");
+#endif
 }
--- a/kernel/kthread.c	2021-05-14 08:53:07.000000000 +0000
+++ b/kernel/kthread.c	2026-05-11 16:31:25.251594003 +0000
@@ -30,6 +30,15 @@
 #include <linux/sched/isolation.h>
 #include <trace/events/sched.h>
 
+#ifdef CONFIG_MIPS
+extern void sf2000_progress_mark(const char *name, unsigned int kind,
+				 unsigned int value);
+
+static void sf2000_kthread_mark(const char *name)
+{
+	sf2000_progress_mark(name, 4, 0);
+}
+#endif
 
 static DEFINE_SPINLOCK(kthread_create_lock);
 static LIST_HEAD(kthread_create_list);
@@ -652,14 +661,23 @@
 {
 	struct task_struct *tsk = current;
 
+#ifdef CONFIG_MIPS
+	sf2000_kthread_mark("kthreadd-entry");
+#endif
 	/* Setup a clean context for our children to inherit. */
 	set_task_comm(tsk, "kthreadd");
 	ignore_signals(tsk);
 	set_cpus_allowed_ptr(tsk, housekeeping_cpumask(HK_FLAG_KTHREAD));
 	set_mems_allowed(node_states[N_MEMORY]);
+#ifdef CONFIG_MIPS
+	sf2000_kthread_mark("kthreadd-after-affinity");
+#endif
 
 	current->flags |= PF_NOFREEZE;
 	cgroup_init_kthreadd();
+#ifdef CONFIG_MIPS
+	sf2000_kthread_mark("kthreadd-after-cgroup");
+#endif
 
 	for (;;) {
 		set_current_state(TASK_INTERRUPTIBLE);
