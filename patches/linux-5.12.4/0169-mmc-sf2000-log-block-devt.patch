--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -2709,6 +2709,10 @@ static int mmc_add_disk(struct mmc_blk_data *md)
 	struct mmc_card *card = md->queue.card;
 
 	sf2000_mmc_blk_mark("mmcblk-add-disk-entry", md->disk->first_minor);
+	sf2000_mmc_blk_mark("mmcblk-disk-major", MAJOR(disk_devt(md->disk)));
+	sf2000_mmc_blk_mark("mmcblk-disk-minor", MINOR(disk_devt(md->disk)));
+	sf2000_mmc_blk_mark("mmcblk-disk-minors", md->disk->minors);
+	sf2000_mmc_blk_mark("mmcblk-disk-cap", (unsigned int)get_capacity(md->disk));
 	device_add_disk(md->parent, md->disk, NULL);
 	sf2000_mmc_blk_mark("mmcblk-after-devadd", md->disk->flags);
 	md->force_ro.show = force_ro_show;
@@ -3123,10 +3127,14 @@ static int __init mmc_blk_init(void)
 		pr_info("mmcblk: using %d minors per device\n", perdev_minors);
 
 	max_devices = min(MAX_DEVICES, (1 << MINORBITS) / perdev_minors);
+	sf2000_mmc_blk_mark("mmcblk-init-minors", perdev_minors);
+	sf2000_mmc_blk_mark("mmcblk-init-maxdev", max_devices);
 
 	res = register_blkdev(MMC_BLOCK_MAJOR, "mmc");
+	sf2000_mmc_blk_mark("mmcblk-regblk-ret", res);
 	if (res)
 		goto out_chrdev_unreg;
 
 	res = mmc_register_driver(&mmc_driver);
+	sf2000_mmc_blk_mark("mmcblk-regdrv-ret", res);
 	if (res)
 		goto out_blkdev_unreg;
