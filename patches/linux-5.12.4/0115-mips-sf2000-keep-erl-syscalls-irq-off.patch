From 0000000000000000000000000000000000000115 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: keep ERL syscalls irq-off

The first KSEG0/ERL bFLT init test reached the first instruction and entered
handle_sys, but the raw breadcrumbs stopped immediately after the syscall-entry
marker.  The next instructions enable interrupts, which is a bad fit for this
temporary ERL userspace path.

Skip TRACE_IRQS_ON_RELOAD/STI when the saved syscall status has ERL set, and
write an extra raw marker so the next device run can tell whether we pass the
previous stop point.
---
 arch/mips/kernel/scall32-o32.S | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/arch/mips/kernel/scall32-o32.S b/arch/mips/kernel/scall32-o32.S
index 1111111..2222222 100644
--- a/arch/mips/kernel/scall32-o32.S
+++ b/arch/mips/kernel/scall32-o32.S
@@ -33,9 +33,26 @@ NESTED(handle_sys, PT_SIZE, sp)
 	sw	v0, 24(k0)
 	mfc0	k1, CP0_EPC
 	sw	k1, 28(k0)
+	lw	k1, PT_STATUS(sp)
+	andi	k1, ST0_ERL
+	bnez	k1, sf2000_erl_syscall_irq_off
+	 nop
 #endif
 	TRACE_IRQS_ON_RELOAD
 	STI
+#ifdef CONFIG_MIPS_SF2000
+	b	sf2000_after_syscall_irq_state
+	 nop
+sf2000_erl_syscall_irq_off:
+	li	k0, 0xa1400000
+	li	k1, 0x51510430
+	sw	k1, 20(k0)
+	lw	k1, PT_STATUS(sp)
+	sw	k1, 24(k0)
+	mfc0	k1, CP0_STATUS
+	sw	k1, 28(k0)
+sf2000_after_syscall_irq_state:
+#endif
 	.set	at
 
 	lw	t1, PT_EPC(sp)		# skip syscall on return
-- 
2.45.0
