From 0000000000000000000000000000000000000077 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: branch to init stub by ErrorEPC only

The physical log for the constant-stack stub shows the C return hook setting
ErrorEPC to 0x80401000 and the copied stub being generated with the correct
KSEG0 stack, but no copied-stub marker is reached. The late assembly gate still
depends on an older restored Status/EBase mask, while the current first-init
return status is 0x00008004.

Make the direct copied-stub branch depend on ErrorEPC alone. ErrorEPC is
written only by the SF2000 first-init handoff hook, so it is the narrowest
reliable gate we have at this point. Also record marker 0x51510018 with
ErrorEPC and Cause immediately before the branch decision.
---
 arch/mips/kernel/entry.S | 27 ++++-----------------------
 1 file changed, 4 insertions(+), 23 deletions(-)

--- a/arch/mips/kernel/entry.S
+++ b/arch/mips/kernel/entry.S
@@ -140,33 +140,12 @@
 	MFC0	k1, CP0_EPC
 	sw	k1, 28(k0)
 	sync
-	mfc0	k1, CP0_STATUS
-	andi	k1, k1, 0x8007
-	lui	k0, 0xa13f
-	sw	k1, 24(k0)
-	li	k1, 0x51510014
-	sw	k1, 20(k0)
-	lw	k1, 24(k0)
-	sync
-	li	k0, 0x8002
-	bne	k1, k0, 1f
-	 nop
-	mfc0	k1, CP0_EBASE
-	srl	k1, k1, 12
-	andi	k1, k1, 0x1fff
-	lui	k0, 0xa13f
-	sw	k1, 24(k0)
-	li	k1, 0x51510012
-	sw	k1, 20(k0)
-	lw	k1, 24(k0)
-	sync
-	li	k0, 0x1002
-	bne	k1, k0, 1f
-	 nop
 	MFC0	k1, CP0_ERROREPC
 	lui	k0, 0xa13f
 	sw	k1, 24(k0)
-	li	k1, 0x51510017
+	mfc0	k1, CP0_CAUSE
+	sw	k1, 28(k0)
+	li	k1, 0x51510018
 	sw	k1, 20(k0)
 	lw	k1, 24(k0)
 	sync
-- 
