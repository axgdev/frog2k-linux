From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 23:30:00 +0000
Subject: [PATCH] mips: sf2000: trace exec stack setup

The hardware now reaches ELF setup_new_exec() and stops in setup_arg_pages().
Add retained breadcrumbs through stack alignment, mmap locking, protection
fixup, optional stack shifting, and final stack expansion.

--- a/fs/exec.c	2026-05-11 18:54:33.418757511 +0000
+++ b/fs/exec.c	2026-05-11 18:57:05.719187009 +0000
@@ -889,6 +889,9 @@
 	unsigned long stack_expand;
 	unsigned long rlim_stack;
 
+	sf2000_exec_value("arg-setup-entry", (unsigned int)stack_top);
+	sf2000_exec_value("arg-setup-vma-start", (unsigned int)vma->vm_start);
+	sf2000_exec_value("arg-setup-vma-end", (unsigned int)vma->vm_end);
 #ifdef CONFIG_STACK_GROWSUP
 	/* Limit stack size */
 	stack_base = bprm->rlim_stack.rlim_max;
@@ -909,13 +912,16 @@
 	bprm->p = vma->vm_end - stack_shift;
 #else
 	stack_top = arch_align_stack(stack_top);
+	sf2000_exec_value("arg-setup-after-align", (unsigned int)stack_top);
 	stack_top = PAGE_ALIGN(stack_top);
+	sf2000_exec_value("arg-setup-after-pagealign", (unsigned int)stack_top);
 
 	if (unlikely(stack_top < mmap_min_addr) ||
 	    unlikely(vma->vm_end - vma->vm_start >= stack_top - mmap_min_addr))
 		return -ENOMEM;
 
 	stack_shift = vma->vm_end - stack_top;
+	sf2000_exec_value("arg-setup-shift", (unsigned int)stack_shift);
 
 	bprm->p -= stack_shift;
 	mm->arg_start = bprm->p;
@@ -925,8 +931,10 @@
 		bprm->loader -= stack_shift;
 	bprm->exec -= stack_shift;
 
+	sf2000_exec_mark("arg-setup-before-lock");
 	if (mmap_write_lock_killable(mm))
 		return -EINTR;
+	sf2000_exec_mark("arg-setup-after-lock");
 
 	vm_flags = VM_STACK_FLAGS;
 
@@ -944,6 +952,7 @@
 
 	ret = mprotect_fixup(vma, &prev, vma->vm_start, vma->vm_end,
 			vm_flags);
+	sf2000_exec_value("arg-setup-after-mprotect", (unsigned int)ret);
 	if (ret)
 		goto out_unlock;
 	BUG_ON(prev != vma);
@@ -955,13 +964,16 @@
 
 	/* Move stack pages down in memory. */
 	if (stack_shift) {
+		sf2000_exec_mark("arg-setup-before-shift");
 		ret = shift_arg_pages(vma, stack_shift);
+		sf2000_exec_value("arg-setup-after-shift", (unsigned int)ret);
 		if (ret)
 			goto out_unlock;
 	}
 
 	/* mprotect_fixup is overkill to remove the temporary stack flags */
 	vma->vm_flags &= ~VM_STACK_INCOMPLETE_SETUP;
+	sf2000_exec_mark("arg-setup-flags-done");
 
 	stack_expand = 131072UL; /* randomly 32*4k (or 2*64k) pages */
 	stack_size = vma->vm_end - vma->vm_start;
@@ -982,7 +994,9 @@
 		stack_base = vma->vm_start - stack_expand;
 #endif
 	current->mm->start_stack = bprm->p;
+	sf2000_exec_value("arg-setup-before-expand", (unsigned int)stack_base);
 	ret = expand_stack(vma, stack_base);
+	sf2000_exec_value("arg-setup-after-expand", (unsigned int)ret);
 	if (ret)
 		ret = -EFAULT;
 

-- 
