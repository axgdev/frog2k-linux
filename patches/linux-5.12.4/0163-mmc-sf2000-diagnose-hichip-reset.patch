@@ -187,21 +205,42 @@
 static bool dw_mci_ctrl_reset(struct dw_mci *host, u32 reset)
 {
 	u32 ctrl;
+	bool hichip = host->dev && host->dev->of_node &&
+		of_device_is_compatible(host->dev->of_node, "hichip,dw-mshc");
 
 	ctrl = mci_readl(host, CTRL);
+	dw_mci_sf2000_mark(host, "dw-reset-before-ctrl", ctrl);
 	ctrl |= reset;
 	mci_writel(host, CTRL, ctrl);
+	dw_mci_sf2000_mark(host, "dw-reset-write-ctrl", ctrl);
 
 	/* wait till resets clear */
 	if (readl_poll_timeout_atomic(host->regs + SDMMC_CTRL, ctrl,
 				      !(ctrl & reset),
 				      1, 500 * USEC_PER_MSEC)) {
+		dw_mci_sf2000_mark(host, "dw-reset-timeout-ctrl", ctrl);
+		dw_mci_sf2000_mark(host, "dw-reset-timeout-stat",
+				    mci_readl(host, STATUS));
+		dw_mci_sf2000_mark(host, "dw-reset-timeout-hcon",
+				    mci_readl(host, HCON));
 		dev_err(host->dev,
 			"Timeout resetting block (ctrl reset %#x)\n",
 			ctrl & reset);
+		if (hichip) {
+			mci_writel(host, CTRL, ctrl & ~reset);
+			udelay(10);
+			ctrl = mci_readl(host, CTRL);
+			dw_mci_sf2000_mark(host, "dw-reset-forced-ctrl", ctrl);
+			if (!(ctrl & reset)) {
+				dev_warn(host->dev,
+					 "Hichip reset bits required forced deassert\n");
+				return true;
+			}
+		}
 		return false;
 	}
 
+	dw_mci_sf2000_mark(host, "dw-reset-ok-ctrl", ctrl);
 	return true;
 }
 
