+static void dw_mci_sf2000_mark(struct dw_mci *host, const char *name,
+			       u32 value)
+{
+	if (host->dev && host->dev->of_node &&
+	    of_device_is_compatible(host->dev->of_node, "hichip,dw-mshc"))
+		sf2000_progress_mark(name, 0x34, value);
+}
