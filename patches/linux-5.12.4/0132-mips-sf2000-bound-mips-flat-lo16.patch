From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000 linux port <sf2000@local>
Date: Wed, 13 May 2026 05:20:00 +0000
Subject: [PATCH] mips: sf2000: bound MIPS bFLT LO16 reconstruction

MIPS bFLT relocation entries only preserve the relocation kind and the
instruction offset. They do not preserve the symbol identity or the matching
HI16 instruction offset, and the relocation table is not reliably ordered by
instruction address. BusyBox has LO16 relocations where scanning by nearest
LUI is correct, and others where the explicit relocation stream is correct.

Validate reconstructed LO16 addresses against the loaded flat image size. If
the reconstructed address is outside the image but subtracting one 64 KiB
HI16 carry lands inside, use that canonical in-range address. This covers the
observed wrong-high reconstructions without hard-coding individual symbols or
instruction addresses.

Also reduce the physical watchdog timeout so failed device tests reboot and
dump retained progress faster.
---
 arch/mips/include/asm/flat.h  | 9 +++++++++
 arch/mips/kernel/setup.c      | 2 +-
 fs/binfmt_flat.c              | 9 +++++++++
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/arch/mips/include/asm/flat.h b/arch/mips/include/asm/flat.h
--- a/arch/mips/include/asm/flat.h
+++ b/arch/mips/include/asm/flat.h
@@ -186,6 +186,15 @@ static inline int flat_put_addr_at_rp(u32 __user *rp, u32 addr, u32 relval)
 	}
 }
 
+static inline u32 flat_reloc_addr_fixup(u32 relval, u32 addr, u32 limit)
+{
+	if (flat_mips_reloc_type(relval) == FLAT_MIPS_R_LO16 &&
+	    addr > limit && addr >= 0x10000 && addr - 0x10000 <= limit)
+		return addr - 0x10000;
+
+	return addr;
+}
+
 /*
  * elf2flt stores the MIPS relocation kind in the top two bits. Keep the
  * remaining 30 bits for the relocation target offset.
diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -116,7 +116,7 @@ char __initdata arcs_cmdline[COMMAND_LINE_SIZE];
 #define SF2000_PROGRESS_ENTRIES 1024u
 #define SF2000_PROGRESS_NAME_LEN 32u
 #define SF2000_WDT_COUNT_KSEG1 ((volatile u32 *)CKSEG1ADDR(0x18818500))
 #define SF2000_WDT_CONF_KSEG1 ((volatile u8 *)CKSEG1ADDR(0x18818504))
-#define SF2000_WDT_BOOT_USEC 30000000u
+#define SF2000_WDT_BOOT_USEC 8000000u
 #define SF2000_WDT_BOOT_TICKS ((SF2000_WDT_BOOT_USEC * 27u) / 128u)
 #define SF2000_WDT_BOOT_COUNT (0u - SF2000_WDT_BOOT_TICKS)
 #define SF2000_WDT_BOOT_CONF 0x26u
diff --git a/fs/binfmt_flat.c b/fs/binfmt_flat.c
--- a/fs/binfmt_flat.c
+++ b/fs/binfmt_flat.c
@@ -64,6 +64,10 @@ static inline void sf2000_flat_value(const char *name, unsigned int value) { }
 #define flat_get_relocate_addr(rel)	(rel)
 #endif
 
+#ifndef flat_reloc_addr_fixup
+#define flat_reloc_addr_fixup(rel, addr, limit)	(addr)
+#endif
+
 /****************************************************************************/
 
 /*
@@ -887,6 +891,13 @@ static int load_flat_file(struct linux_binprm *bprm,
 					}
 				}
 				raw_addr = addr;
+				addr = flat_reloc_addr_fixup(relval, addr,
+					text_len + data_len + bss_len);
+				if (addr != raw_addr) {
+					sf2000_flat_value("flat-reloc-addr-fixup", raw_addr);
+					sf2000_flat_value("flat-reloc-addr-fixed", addr);
+					raw_addr = addr;
+				}
 				addr = calc_reloc(addr, libinfo, id, 0);
 				if (addr == RELOC_FAILED) {
 					sf2000_flat_value("flat-reloc-addr-fail", relval);
-- 
