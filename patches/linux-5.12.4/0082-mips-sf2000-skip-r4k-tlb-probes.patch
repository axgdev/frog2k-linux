From 0000000000000000000000000000000000000082 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: skip R4k TLB probes after boot

The physical SF2000 log reaches the second exec attempt and then takes an RI
trap on the tlbp in local_flush_tlb_range(). Earlier boot diagnostics already
showed that indexed TLB writes are not usable on this core, so keep the SF2000
bring-up path out of all R4k software TLB probe/write helpers.

Also fault in the source stack page before copying it into the identity stack.
The first /init attempt can have a valid stack VMA without a populated PTE yet,
which made the manual page-table walk return -EFAULT before userspace was ever
entered.
---
 arch/mips/mm/tlb-r4k.c | 30 ++++++++++++++++++++++++++++++
 fs/binfmt_elf.c        | 44 ++++++--------------------------------------
 2 files changed, 36 insertions(+), 38 deletions(-)

--- a/arch/mips/mm/tlb-r4k.c
+++ b/arch/mips/mm/tlb-r4k.c
@@ -261,6 +261,12 @@ void local_flush_tlb_range(struct vm_area_struct *vma, unsigned long start,
 	struct mm_struct *mm = vma->vm_mm;
 	int cpu = smp_processor_id();
 
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		sf2000_progress_mark("tlb-range-skip", 4,
+			(unsigned int)(end - start));
+		return;
+	}
+
 	if (cpu_context(cpu, mm) != 0) {
 		unsigned long size, flags;
 
@@ -319,6 +325,12 @@ void local_flush_tlb_kernel_range(unsigned long start, unsigned long end)
 	unsigned long size, flags;
 
 	local_irq_save(flags);
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		sf2000_progress_mark("tlb-kernel-range-skip", 4,
+			(unsigned int)(end - start));
+		local_irq_restore(flags);
+		return;
+	}
 	size = (end - start + (PAGE_SIZE - 1)) >> PAGE_SHIFT;
 	size = (size + 1) >> 1;
 	if (size <= (current_cpu_data.tlbsizeftlbsets ?
@@ -363,6 +375,12 @@ void local_flush_tlb_page(struct vm_area_struct *vma, unsigned long page)
 {
 	int cpu = smp_processor_id();
 
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		sf2000_progress_mark("tlb-page-skip", 4,
+			(unsigned int)page);
+		return;
+	}
+
 	if (cpu_context(cpu, vma->vm_mm) != 0) {
 		unsigned long old_mmid;
 		unsigned long flags, old_entryhi;
@@ -413,6 +431,12 @@ void local_flush_tlb_one(unsigned long page)
 	unsigned long flags;
 	int oldpid, idx;
 
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		sf2000_progress_mark("tlb-one-skip", 4,
+			(unsigned int)page);
+		return;
+	}
+
 	local_irq_save(flags);
 	oldpid = read_c0_entryhi();
 	htw_stop();
@@ -461,6 +485,12 @@ void __update_tlb(struct vm_area_struct * vma, unsigned long address, pte_t pte)
 	if (current->active_mm != vma->vm_mm)
 		return;
 
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		sf2000_progress_mark("tlb-update-skip", 4,
+			(unsigned int)address);
+		return;
+	}
+
 	local_irq_save(flags);
 
 	htw_stop();
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -402,11 +402,7 @@ static int sf2000_elf_copy_identity_stack(unsigned long *sp)
 	struct mm_struct *mm = current->mm;
 	struct vm_area_struct *vma;
 	struct page *page = NULL;
-	pgd_t *pgd;
-	p4d_t *p4d;
-	pud_t *pud;
-	pmd_t *pmd;
-	pte_t *pte;
+	long pinned;
 	void *src;
 	void *dst;
 	unsigned long mapped;
@@ -420,44 +416,17 @@ static int sf2000_elf_copy_identity_stack(unsigned long *sp)
 
 	sf2000_elf_value("elf-id-stack-src", (unsigned int)*sp);
 	sf2000_elf_value("elf-id-stack-low", (unsigned int)low_sp);
+
 	mmap_read_lock(mm);
-	pgd = pgd_offset(mm, src_addr);
-	if (pgd_none(*pgd) || pgd_bad(*pgd)) {
-		ret = -EFAULT;
-		goto out_unlock;
-	}
-	p4d = p4d_offset(pgd, src_addr);
-	if (p4d_none(*p4d) || p4d_bad(*p4d)) {
-		ret = -EFAULT;
-		goto out_unlock;
-	}
-	pud = pud_offset(p4d, src_addr);
-	if (pud_none(*pud) || pud_bad(*pud)) {
-		ret = -EFAULT;
-		goto out_unlock;
-	}
-	pmd = pmd_offset(pud, src_addr);
-	if (pmd_none(*pmd) || pmd_bad(*pmd)) {
-		ret = -EFAULT;
-		goto out_unlock;
-	}
-	pte = pte_offset_map(pmd, src_addr);
-	if (!pte) {
-		ret = -EFAULT;
-		goto out_unlock;
-	}
-	if (!pte_present(*pte)) {
-		ret = -EFAULT;
-		goto out_pte;
+	pinned = get_user_pages(src_addr, 1, FOLL_FORCE, &page, NULL);
+	mmap_read_unlock(mm);
+	sf2000_elf_value("elf-id-stack-gup", (unsigned int)pinned);
+	if (pinned < 0)
+		return (int)pinned;
+	if (pinned != 1) {
+		if (page)
+			put_page(page);
+		return -EFAULT;
 	}
-	sf2000_elf_value("elf-id-stack-pte", (unsigned int)pte_val(*pte));
-	page = pte_page(*pte);
-	get_page(page);
-out_pte:
-	pte_unmap(pte);
-out_unlock:
-	mmap_read_unlock(mm);
-	if (ret)
-		return ret;
 
 	src = kmap(page);
 	dst = (void *)CKSEG1ADDR(SF2000_IDENTITY_STACK_BASE);
