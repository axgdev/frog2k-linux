From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 19:56:00 +0000
Subject: [PATCH] mips: sf2000: prime init entry tlb

The physical SF2000 now installs the /init entry page successfully and reaches
the final syscall_exit marker, then watchdog-resets before the first userspace
syscall. That leaves the first userspace instruction fetch as the next likely
blocker, and that fetch would normally depend on the MIPS TLB refill path.

After directly inserting the entry page PTE, walk back to that PTE and call
update_mmu_cache() while the mm is still active. This primes the hardware TLB
for the /init entry address before ret_from_kernel_thread restores the user
registers and executes eret. Keep RAM markers around the PTE walk and TLB
update to identify whether hardware accepts this path.
---
 fs/binfmt_elf.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/fs/binfmt_elf.c b/fs/binfmt_elf.c
index ce6c4633f..b3546c926 100644
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -71,6 +71,11 @@ static int sf2000_elf_install_entry_page(struct file *file,
 	struct mm_struct *mm = current->mm;
 	struct vm_area_struct *vma;
 	struct page *page;
+	pgd_t *pgd;
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
 	void *kaddr;
 	unsigned long address = entry & PAGE_MASK;
 	loff_t pos = 0;
@@ -126,6 +131,19 @@ static int sf2000_elf_install_entry_page(struct file *file,
 	}
 	ret = vm_insert_page(vma, address, page);
 	sf2000_elf_value("elf-entry-insert-ret", (unsigned int)ret);
+	if (!ret) {
+		sf2000_elf_mark("elf-entry-before-pte");
+		pgd = pgd_offset(mm, address);
+		p4d = p4d_offset(pgd, address);
+		pud = pud_offset(p4d, address);
+		pmd = pmd_offset(pud, address);
+		pte = pte_offset_map(pmd, address);
+		sf2000_elf_value("elf-entry-pte", (unsigned int)pte_val(*pte));
+		sf2000_elf_mark("elf-entry-before-update-tlb");
+		update_mmu_cache(vma, address, pte);
+		sf2000_elf_mark("elf-entry-after-update-tlb");
+		pte_unmap(pte);
+	}
 out_unlock:
 	mmap_write_unlock(mm);
 out_page:
-- 
2.50.1
