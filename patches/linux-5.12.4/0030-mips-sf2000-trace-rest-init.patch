From 0000000000000000000000000000000000000030 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Mon, 11 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: trace rest_init

Hardware now reaches before-rest-init, so start_kernel() makes it to
arch_call_rest_init(). Add RAM-only progress markers inside rest_init() to
locate whether the stop is task creation, kthreadd handoff, the first
schedule, or entering the idle loop.
---
 init/main.c | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

--- a/init/main.c
+++ b/init/main.c
@@ -725,28 +725,57 @@ noinline void __ref rest_init(void)
 	struct task_struct *tsk;
 	int pid;
 
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-init-entry");
+#endif
 	rcu_scheduler_starting();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-after-rcu-start");
+	sf2000_init_mark("rest-before-kernel-thread");
+#endif
 	/*
 	 * We need to spawn init first so that it obtains pid 1, however
 	 * the init task will end up wanting to create kthreads, which, if
 	 * we schedule it before we create kthreadd, will OOPS.
 	 */
 	pid = kernel_thread(kernel_init, NULL, CLONE_FS);
+#ifdef CONFIG_MIPS
+	sf2000_progress_mark("rest-kernel-thread-pid", 4, pid);
+#endif
 	/*
 	 * Pin init on the boot CPU. Task migration is not properly working
 	 * until sched_init_smp() has been run. It will set the allowed
 	 * CPUs for init to the non isolated CPUs.
 	 */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-before-find-init");
+#endif
 	rcu_read_lock();
 	tsk = find_task_by_pid_ns(pid, &init_pid_ns);
+#ifdef CONFIG_MIPS
+	sf2000_progress_mark("rest-init-task", 4, (unsigned int)tsk);
+#endif
 	set_cpus_allowed_ptr(tsk, cpumask_of(smp_processor_id()));
 	rcu_read_unlock();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-after-pin-init");
+#endif
 
 	numa_default_policy();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-before-kthreadd");
+#endif
 	pid = kernel_thread(kthreadd, NULL, CLONE_FS | CLONE_FILES);
+#ifdef CONFIG_MIPS
+	sf2000_progress_mark("rest-kthreadd-pid", 4, pid);
+#endif
 	rcu_read_lock();
 	kthreadd_task = find_task_by_pid_ns(pid, &init_pid_ns);
 	rcu_read_unlock();
+#ifdef CONFIG_MIPS
+	sf2000_progress_mark("rest-kthreadd-task", 4,
+		(unsigned int)kthreadd_task);
+#endif
 
 	/*
 	 * Enable might_sleep() and smp_processor_id() checks.
@@ -756,15 +785,30 @@ noinline void __ref rest_init(void)
 	 * already, but it's stuck on the kthreadd_done completion.
 	 */
 	system_state = SYSTEM_SCHEDULING;
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-before-complete");
+#endif
 
 	complete(&kthreadd_done);
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-after-complete");
+#endif
 
 	/*
 	 * The boot idle thread must execute schedule()
 	 * at least once to get things moving:
 	 */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-before-schedule");
+#endif
 	schedule_preempt_disabled();
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-after-schedule");
+#endif
 	/* Call into cpu_idle with preempt disabled */
+#ifdef CONFIG_MIPS
+	sf2000_init_mark("rest-before-cpu-startup");
+#endif
 	cpu_startup_entry(CPUHP_ONLINE);
 }
 
-- 
