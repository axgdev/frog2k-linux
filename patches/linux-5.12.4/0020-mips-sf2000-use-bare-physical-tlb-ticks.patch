From 0000000000000000000000000000000000000020 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Mon, 11 May 2026 13:35:00 +0000
Subject: [PATCH] mips: sf2000: use bare physical TLB ticks

The physical unit still appears to stop at the "wired skip/read" marker even
though the next generated instructions are just another diagnostic call. That
means the heavy visible tick path itself is suspect in this early TLB window:
it prints, redraws the diagnostic GMA framebuffer, and then toggles GPIO.

Keep the full printk/GMA markers for direct QEMU boots where the ROM helper
RAM is absent, but use a tiny GPIO-only tick when a stock ROM handoff is
detected. The TLB diagnostics still produce the same counted physical pulses,
but they no longer call printk or touch the display engine while CP0 TLB setup
is in progress.
---
 arch/mips/mm/tlb-r4k.c | 110 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 109 insertions(+), 1 deletion(-)

diff --git a/arch/mips/mm/tlb-r4k.c b/arch/mips/mm/tlb-r4k.c
index d742f1b62c39..be2a375cc5dc 100644
--- a/arch/mips/mm/tlb-r4k.c
+++ b/arch/mips/mm/tlb-r4k.c
@@ -17,6 +17,7 @@
 #include <linux/hugetlb.h>
 #include <linux/export.h>
 
+#include <asm/addrspace.h>
 #include <asm/cpu.h>
 #include <asm/cpu-type.h>
 #include <asm/bootinfo.h>
@@ -27,9 +28,117 @@
 extern void build_tlb_refill_handler(void);
 extern void sf2000_visible_tick(const char *name);
 
+#define SF2000_SYSIO_KSEG1 ((volatile unsigned char *)CKSEG1ADDR(0x18800000))
+#define SF2000_ROM_F_MOUNT_KSEG0 ((volatile unsigned int *)0x8101f044)
+#define SF2000_PINMUX_L_OFF 0x4a0
+#define SF2000_PINMUX_R_OFF 0x4e0
+#define SF2000_GPIO_L_OUT_OFF 0x54
+#define SF2000_GPIO_L_DIR_OFF 0x58
+#define SF2000_GPIO_R_OUT_OFF 0xf4
+#define SF2000_GPIO_R_DIR_OFF 0xf8
+#define SF2000_PIN_L25 25
+#define SF2000_PIN_R05 5
+#define SF2000_STATUS_L25 (1u << SF2000_PIN_L25)
+#define SF2000_BACKLIGHT_R05 (1u << SF2000_PIN_R05)
+#define SF2000_TLB_TICK_OFF_TICKS 0x03000000u
+#define SF2000_TLB_TICK_GAP_TICKS 0x08000000u
+#define SF2000_QEMU_DIRECT_DELAY_SHIFT 12
+
+static unsigned int sf2000_tlb_cp0_count(void)
+{
+	unsigned int count;
+
+	asm volatile("mfc0 %0, $9" : "=r"(count));
+	return count;
+}
+
+static int sf2000_tlb_rom_handoff_present(void)
+{
+	unsigned int word = *SF2000_ROM_F_MOUNT_KSEG0;
+
+	return word != 0 && word != 0xffffffffu;
+}
+
+static void sf2000_tlb_delay(unsigned int ticks)
+{
+	unsigned int start = sf2000_tlb_cp0_count();
+
+	if (!sf2000_tlb_rom_handoff_present())
+		ticks >>= SF2000_QEMU_DIRECT_DELAY_SHIFT;
+
+	while ((unsigned int)(sf2000_tlb_cp0_count() - start) < ticks)
+		asm volatile("nop");
+}
+
+static unsigned int sf2000_tlb_read32(unsigned int off)
+{
+	return *(volatile unsigned int *)(SF2000_SYSIO_KSEG1 + off);
+}
+
+static void sf2000_tlb_write32(unsigned int off, unsigned int value)
+{
+	*(volatile unsigned int *)(SF2000_SYSIO_KSEG1 + off) = value;
+}
+
+static void sf2000_tlb_write8(unsigned int off, unsigned char value)
+{
+	*(volatile unsigned char *)(SF2000_SYSIO_KSEG1 + off) = value;
+}
+
+static void sf2000_tlb_status_led_set(int on)
+{
+	unsigned int out;
+	unsigned int dir;
+
+	sf2000_tlb_write8(SF2000_PINMUX_L_OFF + SF2000_PIN_L25, 0);
+	dir = sf2000_tlb_read32(SF2000_GPIO_L_DIR_OFF);
+	sf2000_tlb_write32(SF2000_GPIO_L_DIR_OFF, dir | SF2000_STATUS_L25);
+
+	out = sf2000_tlb_read32(SF2000_GPIO_L_OUT_OFF);
+	if (on)
+		out |= SF2000_STATUS_L25;
+	else
+		out &= ~SF2000_STATUS_L25;
+	sf2000_tlb_write32(SF2000_GPIO_L_OUT_OFF, out);
+}
+
+static void sf2000_tlb_backlight_set(int on)
+{
+	unsigned int out;
+	unsigned int dir;
+
+	sf2000_tlb_write8(SF2000_PINMUX_R_OFF + SF2000_PIN_R05, 0);
+	dir = sf2000_tlb_read32(SF2000_GPIO_R_DIR_OFF);
+	sf2000_tlb_write32(SF2000_GPIO_R_DIR_OFF, dir | SF2000_BACKLIGHT_R05);
+
+	out = sf2000_tlb_read32(SF2000_GPIO_R_OUT_OFF);
+	if (on)
+		out &= ~SF2000_BACKLIGHT_R05;
+	else
+		out |= SF2000_BACKLIGHT_R05;
+	sf2000_tlb_write32(SF2000_GPIO_R_OUT_OFF, out);
+}
+
+static void sf2000_tlb_bare_tick(void)
+{
+	sf2000_tlb_backlight_set(1);
+	sf2000_tlb_status_led_set(0);
+	sf2000_tlb_delay(SF2000_TLB_TICK_GAP_TICKS);
+	sf2000_tlb_backlight_set(0);
+	sf2000_tlb_status_led_set(1);
+	sf2000_tlb_delay(SF2000_TLB_TICK_OFF_TICKS);
+	sf2000_tlb_backlight_set(1);
+	sf2000_tlb_status_led_set(0);
+	sf2000_tlb_delay(SF2000_TLB_TICK_GAP_TICKS);
+}
+
 static void sf2000_tlb_tick(const char *name)
 {
-	if (IS_ENABLED(CONFIG_MIPS_SF2000))
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+	if (sf2000_tlb_rom_handoff_present())
+		sf2000_tlb_bare_tick();
+	else
 		sf2000_visible_tick(name);
 }
 
-- 
2.50.1
