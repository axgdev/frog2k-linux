From 0000000000000000000000000000000000000106 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: skip mmap object for nommu

The generic NOMMU mm code provides arch_get_unmapped_area. Do not also link
the MIPS MMU mmap implementation when CONFIG_MMU is disabled.
---
 arch/mips/mm/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/mips/mm/Makefile b/arch/mips/mm/Makefile
index 50e1b36..fa1f2e9 100644
--- a/arch/mips/mm/Makefile
+++ b/arch/mips/mm/Makefile
@@ -8,7 +8,7 @@ obj-y				+= context.o
 obj-y				+= extable.o
 obj-y				+= fault.o
 obj-y				+= init.o
-obj-y				+= mmap.o
+obj-$(CONFIG_MMU)		+= mmap.o
 obj-y				+= page.o
 obj-y				+= page-funcs.o
 obj-y				+= pgtable.o
-- 
2.45.0

