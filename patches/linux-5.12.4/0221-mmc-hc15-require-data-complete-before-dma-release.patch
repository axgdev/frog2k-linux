From: SF2000 Linux project
Subject: [PATCH] mmc: hc15: require data completion before DMA release

CMDCTL.start clearing means that the HC15 controller accepted a command.  It
does not mean that a data transfer is complete.  The source vendor driver
keeps data_transferring set and retains the DMA mapping until raw IRQ bit 6 is
reported as a data completion.

The Linux polling path allowed the cleared command-start latch to complete a
DMA request.  It could therefore unmap or reuse the buffer and program the
next SD command while a physical memory-to-card transfer was still active.
QEMU's synchronous SDIO implementation concealed this race.  On hardware it
can redirect outstanding write data into a later request, including FAT boot
and metadata sectors.

Require raw data-complete IRQ status for every DMA request.  Once that IRQ has
been observed and acknowledged, record the full byte count directly rather
than polling the now-cleared mixed DMA/status register.  A missing completion
now returns a timeout to the block layer and leaves the filesystem write
failed rather than falsely reporting unsafe media data as durable.

--- a/drivers/mmc/host/hc15_mmc.c
+++ b/drivers/mmc/host/hc15_mmc.c
@@ -66,7 +66,7 @@
 #define HC15_WRITE_WAIT_BEFORE_PIO 1
 #define HC15_WRITE_LOCK_VARIANT	2
 #define HC15_TRACE_VERBOSE	0
-#define HC15_PROBE_TAG		0x0241
+#define HC15_PROBE_TAG		0x0242
 
 /* The vendor host requires 32-byte aligned DMA buffers (unifrog
  * hc_src_sg_needs_bounce, HC_MMC_DMA_ALIGN). */
@@ -547,26 +547,18 @@
 	}
 }
 
-static int hc15_wait_dma(struct hc15_mmc *host, struct mmc_data *data)
+static void hc15_complete_dma(struct hc15_mmc *host, struct mmc_data *data)
 {
-	u32 ctl = 0;
-	int ret;
+	u32 status = readl(host->base + HC15_REG_IRQSTS);
 
-	ret = readl_poll_timeout(host->base + HC15_REG_IRQSTS, ctl,
-				 (ctl & 0x0c) == 0x0c || !(ctl & 0x01),
-				 10, HC15_PIO_TIMEOUT_US);
-
-	hc15_rw_mark("hc15-dma-ctl1", ctl);
-	if (ret) {
-		data->error = -ETIMEDOUT;
-		hc15_rw_mark("hc15-dma-timeout", ctl);
-		return ret;
-	}
-
-	writel(0x40, host->base + HC15_REG_IRQSTS);
+	/*
+	 * hc15_wait_irq() has already observed and acknowledged the controller's
+	 * data-complete bit.  CMDCTL.start clearing is only command acceptance and
+	 * must never release a DMA mapping: the engine can still be accessing it.
+	 */
+	hc15_rw_mark("hc15-dma-ctl1", status);
 	data->bytes_xfered = data->blksz * data->blocks;
 	data->error = 0;
-	return 0;
 }
 
 static int hc15_pio_read(struct hc15_mmc *host, struct mmc_data *data)
@@ -855,10 +847,11 @@
 	hc15_start_command(host);
 
 	if (dma_xfer) {
-		hc15_wait_irq(host, cmd, true);
+		/* DMA buffers remain owned until the real data-complete IRQ. */
+		hc15_wait_irq(host, cmd, false);
 		hc15_get_response(host, cmd);
 		if (!cmd->error)
-			hc15_wait_dma(host, data);
+			hc15_complete_dma(host, data);
 	} else if (write_wait_first) {
 		hc15_rw_mark("hc15-write-wait-first", cmd->opcode);
 		hc15_wait_irq(host, cmd, true);
