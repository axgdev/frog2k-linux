--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -103,7 +103,18 @@
 #define SF2000_GMA_FB_PHYS 0x00f10000u
 #define SF2000_GMA_RESERVE_PHYS 0x00f00000u
-#define SF2000_GMA_RESERVE_SIZE 0x00040000u
+/*
+ * sf2000-screen uses one contiguous uncached DMA arena:
+ *
+ *   0x00f00000..0x00f00500  alternating GMA descriptors
+ *   0x00f10000..0x00fa6000  640x480 RGB565 scanout
+ *   0x00fa8000..0x00fcd800  320x240 RGB565 GE render source
+ *
+ * Reserving only 0x40000 left most of the scanout and all of the render
+ * source in the normal page allocator. Anonymous/user and initramfs pages
+ * then appeared as moving groups of pixels even though GMA/VOU was healthy.
+ */
+#define SF2000_GMA_RESERVE_SIZE 0x00100000u
 #define SF2000_SCREEN_W 320
 #define SF2000_SCREEN_H 240
 #define SF2000_SCREEN_PITCH (SF2000_SCREEN_W * 2)
