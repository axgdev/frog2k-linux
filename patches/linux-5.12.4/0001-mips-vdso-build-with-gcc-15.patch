From: UniFrog contributors <unifrog@example.invalid>
Date: Sun, 10 May 2026 22:30:00 +0000
Subject: [PATCH] mips: vdso: build with GCC 15

GCC 15 defaults are stricter than the Linux 5.12 MIPS VDSO build expects:
PIC code now requires abicalls, and the compiler default language mode treats
bool/false as C23 keywords. Keep the old-kernel VDSO build on gnu89 and pass
abicalls explicitly so the project toolchain can build an unmodified 5.12
kernel tree with one small carried patch.
---
 arch/mips/vdso/Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/mips/vdso/Makefile b/arch/mips/vdso/Makefile
index e0592ec77391..91b09a44321b 100644
--- a/arch/mips/vdso/Makefile
+++ b/arch/mips/vdso/Makefile
@@ -29,8 +29,9 @@ endif
 # jump tables but does not prevent the compiler from emitting absolute
 # offsets.
 cflags-vdso := $(ccflags-vdso) \
 	$(filter -W%,$(filter-out -Wa$(comma)%,$(KBUILD_CFLAGS))) \
-	-O3 -g -fPIC -fno-strict-aliasing -fno-common -fno-builtin -G 0 \
+	-O3 -g -std=gnu89 -fPIC -fno-strict-aliasing -fno-common -fno-builtin -G 0 \
+	$(call cc-option, -mabicalls) \
 	-mrelax-pic-calls $(call cc-option, -mexplicit-relocs) \
 	-fno-stack-protector -fno-jump-tables -DDISABLE_BRANCH_PROFILING \
 	$(call cc-option, -fno-asynchronous-unwind-tables)
