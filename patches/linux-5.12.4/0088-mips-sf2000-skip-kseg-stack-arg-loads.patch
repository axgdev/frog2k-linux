From 0000000000000000000000000000000000000088 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: skip kseg stack arg loads

The raw diagnostic block shows the first /init syscall enters handle_sys with
syscall number 4005, but never reaches the marker after the o32 stack argument
loads. The forced /init stack is an uncached KSEG1 alias, so the generic
user_lw() loads for arguments 5-8 are not safe there.

When the saved user stack pointer is in KSEG1, skip those optional stack
argument loads and pass zeros for arguments 5-8. The first syscall is open()
and only uses the register arguments, so this should let syscall dispatch
advance without disturbing the uncached stack used by the copied /init stub.
---
 arch/mips/kernel/scall32-o32.S | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

--- a/arch/mips/kernel/scall32-o32.S
+++ b/arch/mips/kernel/scall32-o32.S
@@ -52,6 +52,14 @@ NESTED(handle_sys, PT_SIZE, sp)
 	 */
 	lw	t0, PT_R29(sp)		# get old user stack pointer
 
+#ifdef CONFIG_MIPS_SF2000
+	li	t5, 0xe0000000
+	and	t4, t0, t5
+	li	t5, 0xa0000000
+	beq	t4, t5, sf2000_kseg_stack_args
+	nop
+#endif
+
 	/*
 	 * We intentionally keep the kernel stack a little below the top of
 	 * userspace so we don't have to do a slower byte accurate check here.
@@ -75,6 +83,17 @@ load_a6: user_lw(t7, 24(t0))		# argument #7 from usp
 load_a7: user_lw(t8, 28(t0))		# argument #8 from usp
 loads_done:
 
+#ifdef CONFIG_MIPS_SF2000
+	b	sf2000_stack_args_ready
+	nop
+sf2000_kseg_stack_args:
+	move	t5, zero
+	move	t6, zero
+	move	t7, zero
+	move	t8, zero
+sf2000_stack_args_ready:
+#endif
+
 	sw	t5, 16(sp)		# argument #5 to ksp
 	sw	t6, 20(sp)		# argument #6 to ksp
 	sw	t7, 24(sp)		# argument #7 to ksp
