 };
 
+/*
+ * HC15xx USB integration registers, recovered from the vendor libusbdrv.
+ * The two MUSB cores share a PHY control block at 0x18845000 and have
+ * separate reset bits in the main system-control block.
+ */
+#define SF2000_SYSCON_SIZE		0x100
+#define SF2000_USB_PHY_BASE		0x18845000
+#define SF2000_USB_PHY_SIZE		0x200
+#define SF2000_SYS_RESET		0x64
+#define SF2000_SYS_USB_RESET0		0x80
+#define SF2000_SYS_USB_LATCH		0x7c
+#define SF2000_USB_UTMI_CTRL		0x380
+#define SF2000_USB0_PHY_TRIM		0x004
+#define SF2000_USB1_PHY_TRIM		0x104
+#define SF2000_USB0_HOST_TRIM		0x020
+
+static void sf2000_update32(void __iomem *addr, u32 clear, u32 set)
+{
+	u32 value = readl(addr);
+
+	value &= ~clear;
+	value |= set;
+	writel(value, addr);
+}
+
 static struct musb_fifo_cfg sf2000_fifo_cfg[] = {
 	{ .hw_ep_num = 1, .style = FIFO_TX, .maxpacket = 512 },
 	{ .hw_ep_num = 1, .style = FIFO_RX, .maxpacket = 512 },
@@ -60,8 +92,73 @@
 	return ret;
 }
 
+static void sf2000_hc15_reset(struct sf2000_glue *glue, struct musb *musb)
+{
+	u32 reset_gate = BIT(24 + glue->index);
+	u32 reset_pulse = BIT(28 + glue->index);
+	u32 trim = glue->index ? SF2000_USB1_PHY_TRIM :
+				 SF2000_USB0_PHY_TRIM;
+	u8 value;
+
+	/* Ungate the controller, then pulse its dedicated PHY/controller reset. */
+	sf2000_update32(glue->syscon + SF2000_SYS_RESET, reset_gate, 0);
+	udelay(900);
+	sf2000_update32(glue->syscon + SF2000_SYS_USB_RESET0 +
+			(glue->index * sizeof(u32)), 0, reset_pulse);
+	udelay(900);
+	sf2000_update32(glue->syscon + SF2000_SYS_USB_RESET0 +
+			(glue->index * sizeof(u32)), reset_pulse, 0);
+
+	/* Vendor reset leaves the high nibble at 0xd and preserves trim[3:0]. */
+	value = readb(glue->phy + trim);
+	writeb((value & 0x0f) | 0xd0, glue->phy + trim);
+
+	/* A read/write of this register is part of the HC15xx clock latch. */
+	writel(readl(glue->syscon + SF2000_SYS_USB_LATCH),
+	       glue->syscon + SF2000_SYS_USB_LATCH);
+
+	/*
+	 * Host-mode PHY power sequence.  0x9c is the vendor's host value;
+	 * bit zero is a strobe and must be removed after the settle delay.
+	 */
+	sf2000_update32(musb->mregs + SF2000_USB_UTMI_CTRL, 0x90, 0x9d);
+	udelay(900);
+	sf2000_update32(musb->mregs + SF2000_USB_UTMI_CTRL, BIT(0), 0);
+}
+
+static void sf2000_hc15_set_host(struct sf2000_glue *glue,
+				 struct musb *musb)
+{
+	u8 value;
+
+	if (!glue->index) {
+		value = readb(musb->mregs + SF2000_USB_UTMI_CTRL);
+		writeb(value & ~BIT(7), musb->mregs + SF2000_USB_UTMI_CTRL);
+		writew(0x10c0, glue->phy + SF2000_USB0_HOST_TRIM);
+	} else {
+		value = readb(musb->mregs + SF2000_USB_UTMI_CTRL);
+		writeb(value | BIT(6), musb->mregs + SF2000_USB_UTMI_CTRL);
+	}
+
+	/* Force a clean A-device session edge, as required by HC15xx. */
+	value = musb_readb(musb->mregs, MUSB_DEVCTL);
+	musb_writeb(musb->mregs, MUSB_DEVCTL, value & ~MUSB_DEVCTL_SESSION);
+	udelay(1000);
+	value = musb_readb(musb->mregs, MUSB_DEVCTL);
+	musb_writeb(musb->mregs, MUSB_DEVCTL, value | MUSB_DEVCTL_SESSION);
+
+	value = musb_readb(musb->mregs, MUSB_POWER);
+	musb_writeb(musb->mregs, MUSB_POWER, value | MUSB_POWER_HSENAB);
+	udelay(1000);
+}
+
 static int sf2000_musb_init(struct musb *musb)
 {
+	struct sf2000_glue *glue = dev_get_drvdata(musb->controller->parent);
+
+	if (!glue)
+		return -ENODEV;
+
 	musb->xceiv = devm_usb_get_phy(musb->controller->parent,
 					 USB_PHY_TYPE_USB2);
 	if (IS_ERR(musb->xceiv))
@@ -69,6 +166,15 @@
 
 	musb->dyn_fifo = true;
 	musb->isr = sf2000_musb_interrupt;
+	sf2000_hc15_reset(glue, musb);
+	sf2000_hc15_set_host(glue, musb);
+
+	dev_info(glue->dev,
+		 "HC15xx host%u ready: power=%02x devctl=%02x utmi=%08x\n",
+		 glue->index, musb_readb(musb->mregs, MUSB_POWER),
+		 musb_readb(musb->mregs, MUSB_DEVCTL),
+		 readl(musb->mregs + SF2000_USB_UTMI_CTRL));
+
 	return 0;
 }
 
