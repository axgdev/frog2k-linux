From 0000000000000000000000000000000000000116 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: allow KSEG0 NOMMU uaccess

The temporary SF2000 bFLT execution path enters the first NOMMU init from
KSEG0 while ERL is set.  The code runs far enough to issue syscalls, but
pathnames and write buffers are KSEG0 pointers and the generic MIPS uaccess
assembly treats them as faulting user addresses.

Accept KSEG0 user pointers for this SF2000/NOMMU bring-up path in the copy
and string helpers.  This is intentionally guarded to the local platform and
NOMMU configuration so the normal MIPS MMU path keeps the existing uaccess
semantics.
---
 arch/mips/include/asm/uaccess.h | 48 ++++++++++++++++++++++++++++++++-
 1 file changed, 47 insertions(+), 1 deletion(-)

diff --git a/arch/mips/include/asm/uaccess.h b/arch/mips/include/asm/uaccess.h
index 1111111..2222222 100644
--- a/arch/mips/include/asm/uaccess.h
+++ b/arch/mips/include/asm/uaccess.h
@@ -14,6 +14,7 @@
 #include <linux/kernel.h>
 #include <linux/string.h>
 #include <asm/asm-eva.h>
+#include <asm/addrspace.h>
 #include <asm/extable.h>
 
 /*
@@ -71,6 +72,20 @@
 
 #define uaccess_kernel()	(get_fs().seg == KERNEL_DS.seg)
 
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU) && defined(CONFIG_32BIT)
+static inline bool sf2000_nommu_kseg0_user_addr(const void *addr)
+{
+	unsigned long value = (unsigned long)addr;
+
+	return value >= KSEG0 && value < KSEG1;
+}
+#else
+static inline bool sf2000_nommu_kseg0_user_addr(const void *addr)
+{
+	return false;
+}
+#endif
+
 /*
  * eva_kernel_access() - determine whether kernel memory access on an EVA system
  *
@@ -606,7 +621,12 @@ static inline unsigned long
 raw_copy_to_user(void __user *to, const void *from, unsigned long n)
 {
+	if (sf2000_nommu_kseg0_user_addr(to)) {
+		memcpy((void *)to, from, n);
+		return 0;
+	}
+
 	if (eva_kernel_access())
 		return __invoke_copy_to_kernel(to, from, n);
 	else
 		return __invoke_copy_to_user(to, from, n);
 }
@@ -616,7 +637,12 @@ static inline unsigned long
 raw_copy_from_user(void *to, const void __user *from, unsigned long n)
 {
+	if (sf2000_nommu_kseg0_user_addr(from)) {
+		memcpy(to, (const void *)from, n);
+		return 0;
+	}
+
 	if (eva_kernel_access())
 		return __invoke_copy_from_kernel(to, from, n);
 	else
 		return __invoke_copy_from_user(to, from, n);
 }
@@ -712,5 +739,19 @@ strncpy_from_user(char *__to, const char __user *__from, long __len)
 {
 	long res;
 
+	if (sf2000_nommu_kseg0_user_addr(__from)) {
+		long i;
+
+		for (i = 0; i < __len; i++) {
+			char c = ((const char *)__from)[i];
+
+			__to[i] = c;
+			if (!c)
+				return i;
+		}
+
+		return __len;
+	}
+
 	if (eva_kernel_access()) {
 		__asm__ __volatile__(
 			"move\t$4, %1\n\t"
@@ -769,7 +810,22 @@ extern long __strnlen_user_asm(const char __user *s, long n);
 static inline long strnlen_user(const char __user *s, long n)
 {
 	long res;
 
+	if (sf2000_nommu_kseg0_user_addr(s)) {
+		long i;
+
+		for (i = 0; i < n; i++) {
+			if (!((const char *)s)[i])
+				return i + 1;
+		}
+
+		return n + 1;
+	}
+
 	might_fault();
 	if (eva_kernel_access()) {
 		__asm__ __volatile__(
-- 
2.45.0
