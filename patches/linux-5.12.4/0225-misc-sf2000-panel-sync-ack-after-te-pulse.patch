 static inline u32 ps_read(struct sf2000_panel_sync *ps, u32 off)
@@ -193,19 +197,40 @@ static void ps_restart_frame(struct sf2000_panel_sync *ps)
 static irqreturn_t sf2000_panel_sync_irq(int irq, void *data)
 {
 	struct sf2000_panel_sync *ps = data;
+	u32 input;
+	u32 ier;
+	int ret;
 
-	if (!(ps_read(ps, GPIO_L + GPIO_STATUS) & TE_BIT))
-		return IRQ_NONE;
-
-	/* HC15xx GPIO pending bits are write-one-to-clear. */
-	ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
-	if (!READ_ONCE(ps->enabled))
+	/*
+	 * The GPIO child is edge-latched but the SoC parent is level-sensitive.
+	 * Acknowledging the child while L08 is still asserted makes the parent
+	 * immediately dispatch the same panel pulse again.  Log77 exposed that
+	 * bug as roughly two IRQs per frame and a repeatedly disconnected raster.
+	 * Mask L08 locally, service it once, then acknowledge only after the
+	 * electrical pulse has returned low.  IRQF_ONESHOT keeps the aggregate
+	 * parent masked while this threaded handler waits.  Some HC15 revisions
+	 * consume the child edge when the aggregate status is read, so this
+	 * dedicated handler deliberately does not require GPIO_STATUS to remain set.
+	 */
+	ier = ps_read(ps, GPIO_L);
+	ps_write(ps, GPIO_L, ier & ~TE_BIT);
+	if (!READ_ONCE(ps->enabled)) {
+		ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
 		return IRQ_HANDLED;
+	}
 
 	ps_gpio_mux(ps);
 	ps_configure_outputs(ps);
 	ps_restart_frame(ps);
 	ps_rgb_mux(ps);
+	ret = readl_poll_timeout(ps->sys + GPIO_L + GPIO_INPUT, input,
+				 !(input & TE_BIT), 10, 20000);
+	if (ret)
+		WRITE_ONCE(ps->pulse_timeouts,
+			   READ_ONCE(ps->pulse_timeouts) + 1);
+	ps_write(ps, GPIO_L + GPIO_STATUS, TE_BIT);
+	if (READ_ONCE(ps->enabled))
+		ps_write(ps, GPIO_L, ier | TE_BIT);
 	WRITE_ONCE(ps->edges, READ_ONCE(ps->edges) + 1);
 	return IRQ_HANDLED;
 }
