From 0000000000000000000000000000000000000071 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: use stub page branch latch

The one-shot-init-stub physical log reaches the late assembly gate and records
the expected SF2000 EBase page, but stops before the direct branch marker. That
means the separate retained one-shot word is not visible at the final restore
decision point.

Move the one-shot latch into the copied identity stub page itself. The ELF
loader already writes and cache-flushes that page immediately before the
handoff, and the assembly path can consume the latch from the same physical
page it will branch to. Put the latch immediately after the copied stub words
so it stays in the tiny text area we already intentionally overwrite. Record
marker 0x51510015 with the observed latch value so the next physical log can
distinguish a missing latch from a later stub failure.
---
 arch/mips/kernel/entry.S   | 10 +++++++---
 arch/mips/kernel/process.c |  3 ---
 fs/binfmt_elf.c            |  4 ++++
 3 files changed, 11 insertions(+), 6 deletions(-)

--- a/arch/mips/kernel/entry.S
+++ b/arch/mips/kernel/entry.S
@@ -163,13 +163,19 @@
 	li	k0, 0x1002
 	bne	k1, k0, 1f
 	 nop
-	li	k0, 0xa13ff000
+	li	k0, 0x80401068
 	lw	k1, 0(k0)
-	li	k0, 0x5151b001
+	lui	k0, 0xa13f
+	sw	k1, 24(k0)
+	li	k1, 0x51510015
+	sw	k1, 20(k0)
+	lw	k1, 24(k0)
+	sync
+	li	k0, 0x5151b002
 	bne	k1, k0, 1f
 	 nop
 	li	k1, 0
-	li	k0, 0xa13ff000
+	li	k0, 0x80401068
 	sw	k1, 0(k0)
 	lui	k0, 0xa13f
 	li	k1, 0x51510007
--- a/arch/mips/kernel/process.c
+++ b/arch/mips/kernel/process.c
@@ -40,9 +40,7 @@
 #include <asm/stacktrace.h>
 
 #define SF2000_IDENTITY_USER_STACK 0x013e0000UL
-#define SF2000_IDENTITY_BRANCH_FLAG_KSEG1 ((volatile unsigned int *)0xa13ff000UL)
-#define SF2000_IDENTITY_BRANCH_MAGIC 0x5151b001UL
 
 #ifdef CONFIG_HOTPLUG_CPU
 void arch_cpu_idle_dead(void)
 {
@@ -132,7 +130,6 @@
 			goto normal_user_status;
 		sf2000_identity_handoff_used = true;
 		sf2000_identity_branch_enabled = 1;
-		*SF2000_IDENTITY_BRANCH_FLAG_KSEG1 = SF2000_IDENTITY_BRANCH_MAGIC;
 		status |= ST0_ERL;
 		status &= ~ST0_EXL;
 		status &= ~KU_MASK;
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -78,6 +78,9 @@
 #define SF2000_IDENTITY_STACK_PAGE \
 	(SF2000_IDENTITY_STACK_TOP - PAGE_SIZE)
 #define SF2000_IDENTITY_STUB_ADDR 0x00401000UL
+#define SF2000_IDENTITY_STUB_FLAG_ADDR \
+	(SF2000_IDENTITY_STUB_ADDR + 26 * sizeof(u32))
+#define SF2000_IDENTITY_STUB_FLAG_MAGIC 0x5151b002UL
 
 static int sf2000_elf_install_entry_page(struct file *file,
 		const struct elf_phdr *phdrs, int phnum, unsigned long entry)
@@ -248,6 +250,8 @@
 	stub[23] = 0xaf5b001c; /* sw k1,28(k0) */
 	stub[24] = 0x03600008; /* jr k1 */
 	stub[25] = 0x00000000; /* nop */
+	*(u32 *)CKSEG1ADDR(SF2000_IDENTITY_STUB_FLAG_ADDR) =
+		SF2000_IDENTITY_STUB_FLAG_MAGIC;
 	flush_cache_all();
 	flush_icache_all();
 	flush_icache_range(SF2000_IDENTITY_STUB_ADDR,
-- 
2.45.0
