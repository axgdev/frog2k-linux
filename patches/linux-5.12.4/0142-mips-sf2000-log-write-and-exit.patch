From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Wed, 13 May 2026 06:20:00 +0000
Subject: [PATCH] mips: sf2000: log userspace write and exit details

The 0104 device log shows the first BusyBox exec succeeds and then userspace
quickly performs ioctl, prctl, getuid, write, and exit. That means the current
failure is no longer the bFLT exec path; BusyBox is printing a diagnostic or
status text and terminating.

Add narrow diagnostics for write(2) and exit(2). For KSEG0 NOMMU buffers,
capture the write file descriptor, buffer address, byte count, first 32 bytes
of payload, write return value, and final exit status. This keeps the next
device run focused on the actual userspace reason without requiring visible
LCD output.
---
 fs/read_write.c | 79 +++++++++++++++++++++++++++++++++++++++++++++++++
 kernel/exit.c   | 15 ++++++++++
 2 files changed, 94 insertions(+)

--- a/fs/read_write.c
+++ b/fs/read_write.c
@@ -25,6 +25,83 @@
 #include <linux/uaccess.h>
 #include <asm/unistd.h>
 
+#ifdef CONFIG_MIPS
+extern void sf2000_progress_mark(const char *name, unsigned int kind,
+		unsigned int value);
+
+static void sf2000_rw_value(const char *name, unsigned int value)
+{
+	if (IS_ENABLED(CONFIG_MIPS_SF2000))
+		sf2000_progress_mark(name, 17, value);
+}
+
+static void sf2000_rw_word(unsigned int index, unsigned int value)
+{
+	switch (index) {
+	case 0:
+		sf2000_rw_value("write-w0", value);
+		break;
+	case 1:
+		sf2000_rw_value("write-w1", value);
+		break;
+	case 2:
+		sf2000_rw_value("write-w2", value);
+		break;
+	case 3:
+		sf2000_rw_value("write-w3", value);
+		break;
+	case 4:
+		sf2000_rw_value("write-w4", value);
+		break;
+	case 5:
+		sf2000_rw_value("write-w5", value);
+		break;
+	case 6:
+		sf2000_rw_value("write-w6", value);
+		break;
+	case 7:
+		sf2000_rw_value("write-w7", value);
+		break;
+	}
+}
+
+static void sf2000_rw_log_write(unsigned int fd, const char __user *buf,
+		size_t count)
+{
+	const char *raw = (const char *)buf;
+	unsigned int i;
+	unsigned int limit;
+	unsigned int word = 0;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	sf2000_rw_value("write-fd", fd);
+	sf2000_rw_value("write-buf", (unsigned int)buf);
+	sf2000_rw_value("write-count", (unsigned int)count);
+
+	if (!sf2000_nommu_kseg0_user_addr(buf)) {
+		sf2000_rw_value("write-not-kseg0", (unsigned int)buf);
+		return;
+	}
+
+	limit = count < 32 ? count : 32;
+	for (i = 0; i < limit; i++) {
+		word |= (unsigned int)(unsigned char)raw[i] << ((i & 3) * 8);
+		if ((i & 3) == 3) {
+			sf2000_rw_word(i >> 2, word);
+			word = 0;
+		}
+	}
+	if (limit & 3)
+		sf2000_rw_word(limit >> 2, word);
+}
+#else
+static void sf2000_rw_value(const char *name, unsigned int value) {}
+static void sf2000_rw_log_write(unsigned int fd, const char __user *buf,
+		size_t count) {}
+#endif
+
 const struct file_operations generic_ro_fops = {
 	.llseek		= generic_file_llseek,
 	.read_iter	= generic_file_read_iter,
@@ -649,6 +726,7 @@ ssize_t ksys_write(unsigned int fd, const char __user *buf, size_t count)
 	struct fd f = fdget_pos(fd);
 	ssize_t ret = -EBADF;
 
+	sf2000_rw_log_write(fd, buf, count);
 	if (f.file) {
 		loff_t pos, *ppos = file_ppos(f.file);
 		if (ppos) {
@@ -661,6 +739,7 @@ ssize_t ksys_write(unsigned int fd, const char __user *buf, size_t count)
 		fdput_pos(f);
 	}
 
+	sf2000_rw_value("write-ret", (unsigned int)ret);
 	return ret;
 }
 
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -69,6 +69,19 @@
 #include <asm/unistd.h>
 #include <asm/mmu_context.h>
 
+#ifdef CONFIG_MIPS
+extern void sf2000_progress_mark(const char *name, unsigned int kind,
+		unsigned int value);
+
+static void sf2000_exit_value(const char *name, unsigned int value)
+{
+	if (IS_ENABLED(CONFIG_MIPS_SF2000))
+		sf2000_progress_mark(name, 18, value);
+}
+#else
+static void sf2000_exit_value(const char *name, unsigned int value) {}
+#endif
+
 static void __unhash_process(struct task_struct *p, bool group_dead)
 {
 	nr_threads--;
@@ -888,6 +901,7 @@ EXPORT_SYMBOL(complete_and_exit);
 
 SYSCALL_DEFINE1(exit, int, error_code)
 {
+	sf2000_exit_value("exit-code", (unsigned int)error_code);
 	do_exit((error_code&0xff)<<8);
 }
 
@@ -930,6 +944,7 @@ do_group_exit(int exit_code)
  */
 SYSCALL_DEFINE1(exit_group, int, error_code)
 {
+	sf2000_exit_value("exit-group-code", (unsigned int)error_code);
 	do_group_exit((error_code & 0xff) << 8);
 	/* NOTREACHED */
 	return 0;
