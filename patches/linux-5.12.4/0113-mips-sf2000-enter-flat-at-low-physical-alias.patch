From 0000000000000000000000000000000000000113 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: enter NOMMU FLAT at low physical aliases

On SF2000 NOMMU the FLAT image is loaded through kernel KSEG0 aliases, but
user mode cannot execute KSEG0 addresses.  Convert the final process entry
point and initial stack pointer to their low physical aliases immediately
before start_thread().

This keeps the loader using normal kernel aliases while copying and clearing
memory, and only changes the addresses exposed to user mode.
---
 fs/binfmt_flat.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/fs/binfmt_flat.c b/fs/binfmt_flat.c
index 333333333333..444444444444 100644
--- a/fs/binfmt_flat.c
+++ b/fs/binfmt_flat.c
@@ -40,6 +40,9 @@
 #include <asm/cacheflush.h>
 #include <asm/page.h>
 #include <asm/flat.h>
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+#include <asm/addrspace.h>
+#endif
 
 #ifndef flat_get_relocate_addr
 #define flat_get_relocate_addr(rel)	(rel)
@@ -1033,6 +1036,13 @@ static int load_flat_binary(struct linux_binprm *bprm)
 #ifdef FLAT_PLAT_INIT
 	FLAT_PLAT_INIT(regs);
 #endif
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+	pr_info("SF2000 NOMMU FLAT entry %lx->%lx stack %lx->%lx\n",
+		start_addr, CPHYSADDR(start_addr), current->mm->start_stack,
+		CPHYSADDR(current->mm->start_stack));
+	start_addr = CPHYSADDR(start_addr);
+	current->mm->start_stack = CPHYSADDR(current->mm->start_stack);
+#endif
 
 	finalize_exec(bprm);
 	pr_debug("start_thread(regs=0x%p, entry=0x%lx, start_stack=0x%lx)\n",
-- 
