From 0000000000000000000000000000000000000070 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Tue, 12 May 2026 00:00:00 +0000
Subject: [PATCH] mips: sf2000: make init stub branch one-shot

The restored-status image reaches and executes the copied KSEG0 init stub, but
after /init starts executing the same status mask also matches later user
returns. The assembly path then keeps forcing every return through the original
stub instead of returning to the current user EPC, filling the retained log
with sequential KSEG0 EPCs until the watchdog resets the board.

Use a fixed retained one-shot flag for the direct stub branch. start_thread()
arms it only for the first SF2000 identity handoff, and the assembly branch
clears it before jumping to the stub. Also stop recording non-ERL user returns
in sf2000_ret_before_restore(), since that flood hides the useful userspace
markers in the retained ring.
---
 arch/mips/kernel/entry.S   | 8 ++++++++
 arch/mips/kernel/process.c | 8 +++++---
 2 files changed, 13 insertions(+), 3 deletions(-)

--- a/arch/mips/kernel/entry.S
+++ b/arch/mips/kernel/entry.S
@@ -163,6 +163,14 @@ restore_partial:		# restore partial frame
 	li	k0, 0x1002
 	bne	k1, k0, 1f
 	 nop
+	li	k0, 0xa13ff000
+	lw	k1, 0(k0)
+	li	k0, 0x5151b001
+	bne	k1, k0, 1f
+	 nop
+	li	k1, 0
+	li	k0, 0xa13ff000
+	sw	k1, 0(k0)
 	lui	k0, 0xa13f
 	li	k1, 0x51510007
 	sw	k1, 20(k0)
--- a/arch/mips/kernel/process.c
+++ b/arch/mips/kernel/process.c
@@ -39,6 +39,8 @@
 #include <asm/stacktrace.h>
 
 #define SF2000_IDENTITY_USER_STACK 0x013e0000UL
+#define SF2000_IDENTITY_BRANCH_FLAG_KSEG1 ((volatile unsigned int *)0xa13ff000UL)
+#define SF2000_IDENTITY_BRANCH_MAGIC 0x5151b001UL
 
 #ifdef CONFIG_HOTPLUG_CPU
 void arch_cpu_idle_dead(void)
@@ -86,10 +88,10 @@ void sf2000_ret_before_restore(struct pt_regs *regs)
 	if (!sf2000_identity_userspace_enabled())
 		return;
 
-	sf2000_progress_mark("ret-restore-status", 9, regs->cp0_status);
-	sf2000_progress_mark("ret-restore-epc", 9, regs->cp0_epc);
 	if (!(regs->cp0_status & ST0_ERL))
 		return;
+	sf2000_progress_mark("ret-restore-status", 9, regs->cp0_status);
+	sf2000_progress_mark("ret-restore-epc", 9, regs->cp0_epc);
 	if (regs->cp0_status & ST0_EXL) {
 		regs->cp0_status &= ~ST0_EXL;
 		sf2000_progress_mark("ret-restore-status-fixed", 9,
@@ -132,6 +134,7 @@ void start_thread(struct pt_regs * regs, unsigned long pc, unsigned long sp)
 			goto normal_user_status;
 		sf2000_identity_handoff_used = true;
 		sf2000_identity_branch_enabled = 1;
+		*SF2000_IDENTITY_BRANCH_FLAG_KSEG1 = SF2000_IDENTITY_BRANCH_MAGIC;
 		status |= ST0_ERL;
 		status &= ~ST0_EXL;
 		status &= ~KU_MASK;
-- 
