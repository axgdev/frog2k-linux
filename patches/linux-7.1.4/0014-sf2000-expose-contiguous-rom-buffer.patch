diff --git a/drivers/misc/sf2000-rombuf.c b/drivers/misc/sf2000-rombuf.c
new file mode 100644
index 000000000..ce5277a0d
--- /dev/null
+++ b/drivers/misc/sf2000-rombuf.c
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Cached, contiguous cartridge buffer for the NOMMU Data Frog SF2000.
+ *
+ * The firmware handoff keeps 0x01000000..0x03ffffff reserved.  Firmware code,
+ * retained diagnostics, and the live-log handoff occupy the lower portion;
+ * no post-handoff service uses 0x02000000..0x03ffffff.  Keep that upper range
+ * reserved and provide a narrow mapping instead of weakening /dev/mem policy.
+ */
+
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/miscdevice.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+
+#include <asm/addrspace.h>
+
+#define SF2000_ROMBUF_PHYS	0x02000000UL
+#define SF2000_ROMBUF_SIZE	0x02000000UL
+#define SF2000_ROMBUF_VIRT	CKSEG0ADDR(SF2000_ROMBUF_PHYS)
+#define SF2000_ROMBUF_MINOR	242
+
+static unsigned long sf2000_rombuf_get_unmapped_area(struct file *file,
+		unsigned long addr, unsigned long len, unsigned long pgoff,
+		unsigned long flags)
+{
+	(void)file;
+	(void)addr;
+	(void)flags;
+
+	if (pgoff || !len || len > SF2000_ROMBUF_SIZE)
+		return -EINVAL;
+
+	return SF2000_ROMBUF_VIRT;
+}
+
+static int sf2000_rombuf_mmap(struct file *file,
+		struct vm_area_struct *vma)
+{
+	unsigned long size = vma->vm_end - vma->vm_start;
+
+	(void)file;
+	if (vma->vm_pgoff || !size || size > SF2000_ROMBUF_SIZE)
+		return -EINVAL;
+	if (vma->vm_start != SF2000_ROMBUF_VIRT)
+		return -EINVAL;
+
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	return remap_pfn_range(vma, vma->vm_start,
+			       SF2000_ROMBUF_PHYS >> PAGE_SHIFT, size,
+			       vma->vm_page_prot);
+}
+
+static unsigned int sf2000_rombuf_mmap_capabilities(struct file *file)
+{
+	(void)file;
+	return NOMMU_MAP_DIRECT | NOMMU_MAP_READ | NOMMU_MAP_WRITE |
+	       NOMMU_MAP_EXEC;
+}
+
+static const struct file_operations sf2000_rombuf_fops = {
+	.owner = THIS_MODULE,
+	.get_unmapped_area = sf2000_rombuf_get_unmapped_area,
+	.mmap_capabilities = sf2000_rombuf_mmap_capabilities,
+	.mmap = sf2000_rombuf_mmap,
+	.llseek = noop_llseek,
+};
+
+static struct miscdevice sf2000_rombuf_misc = {
+	.minor = SF2000_ROMBUF_MINOR,
+	.name = "sf2000-rombuf",
+	.fops = &sf2000_rombuf_fops,
+	.mode = 0600,
+};
+
+static int __init sf2000_rombuf_init(void)
+{
+	int ret;
+
+	ret = misc_register(&sf2000_rombuf_misc);
+	if (ret)
+		return ret;
+
+	pr_info("sf2000-rombuf: cached 32 MiB mapping at %08lx (phys %08lx)\n",
+		(unsigned long)SF2000_ROMBUF_VIRT,
+		(unsigned long)SF2000_ROMBUF_PHYS);
+	return 0;
+}
+device_initcall(sf2000_rombuf_init);
