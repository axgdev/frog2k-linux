diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index b78568f7a..7ac470d29 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -614,5 +614,15 @@ config SF2000_GE
 	  command-buffer query and completion operations on /dev/ge.
 
+config SF2000_ROM_BUFFER
+	bool "SF2000 contiguous ROM buffer"
+	depends on MIPS_SF2000 && !MMU
+	help
+	  Expose the otherwise unused upper 32 MiB of the ROM/bootloader
+	  reserved-memory window through /dev/sf2000-rombuf.  NOMMU emulators
+	  can map this cached, physically contiguous area and keep a maximum-size
+	  cartridge resident without high-order allocations or per-access page
+	  indirection.  The range remains excluded from the normal page allocator.
+
 source "drivers/misc/c2port/Kconfig"
 source "drivers/misc/eeprom/Kconfig"
 source "drivers/misc/cb710/Kconfig"
