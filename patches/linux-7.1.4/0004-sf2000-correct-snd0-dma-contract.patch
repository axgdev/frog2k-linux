@@ -91,13 +110,31 @@
 {
 	struct sf2000_pcm *chip = snd_pcm_substream_chip(substream);
 	struct snd_pcm_runtime *runtime = substream->runtime;
-	size_t pos = (readl(chip->snd + SF2000_SND_DMA_POS) & 0xffff) << 4;
+	size_t pos = readw(chip->snd + SF2000_SND_DMA_POS + 2) << 4;
 
 	if (pos >= frames_to_bytes(runtime, runtime->buffer_size))
 		pos = 0;
 	return bytes_to_frames(runtime, pos);
 }
 
+static int sf2000_pcm_ack(struct snd_pcm_substream *substream)
+{
+	struct sf2000_pcm *chip = snd_pcm_substream_chip(substream);
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	snd_pcm_uframes_t appl_ptr = READ_ONCE(runtime->control->appl_ptr);
+	size_t pos;
+
+	/*
+	 * SND0 packs two 16-byte DMA cursors into offset 0x38.  Software
+	 * publishes the producer in the low halfword while hardware reports
+	 * its consumer in the high halfword.  A 16-bit write is important:
+	 * a 32-bit read/modify/write can race the live consumer cursor.
+	 */
+	pos = frames_to_bytes(runtime, appl_ptr % runtime->buffer_size);
+	writew(pos >> 4, chip->snd + SF2000_SND_DMA_POS);
+	return 0;
+}
+
 static void sf2000_pcm_timer(struct timer_list *timer)
 {
 	struct sf2000_pcm *chip = timer_container_of(chip, timer, timer);
@@ -168,17 +205,35 @@
 	size_t bytes = frames_to_bytes(runtime, runtime->buffer_size);
 
 	if (!runtime->dma_area || !bytes || bytes > SF2000_BUFFER_MAX ||
-	    bytes & 0xf || upper_32_bits(runtime->dma_addr))
+	    bytes & 0xf || bytes >> 4 > U16_MAX ||
+	    runtime->period_size > U16_MAX ||
+	    upper_32_bits(runtime->dma_addr))
 		return -EINVAL;
 
 	writel(0x4200039e, chip->dac + SF2000_DAC_CTL);
+	/* 294.912 MHz / 24 = 12.288 MHz; / (32 kHz * 32) = 288. */
+	writel(SF2000_AUDIO_PLL_32K, chip->sys + SF2000_SYS_AUDIO_PLL);
+	sf2000_update_bits(chip->sys + SF2000_SYS_AUDIO_GATE,
+		BIT(14), BIT(14));
+	sf2000_update_bits(chip->snd + SF2000_SND_CTL50,
+		GENMASK(5, 4) | BIT(10) | BIT(11), 0);
+	sf2000_update_bits(chip->snd + SF2000_SND_CTL04,
+		BIT(0) | BIT(8), BIT(0) | BIT(8));
 	writel(0x0000ff41, chip->snd + SF2000_SND_I2S_CTL);
-	writel(0x008f0000, chip->snd + SF2000_SND_FADE);
+	writeb(SF2000_VOLUME_90, chip->snd + SF2000_SND_FADE + 2);
 	writel(lower_32_bits(runtime->dma_addr),
 		chip->snd + SF2000_SND_DMA_BASE);
-	writel(bytes >> 4, chip->snd + SF2000_SND_DMA_SIZE);
-	writel(0, chip->snd + SF2000_SND_DMA_POS);
+	sf2000_update_bits(chip->snd + SF2000_SND_DMA_SIZE,
+		SF2000_DMA_CONFIG_MASK, SF2000_DMA_MONO_S16_LE);
+	writew(bytes >> 4, chip->snd + SF2000_SND_DMA_SIZE);
+	writew(runtime->period_size, chip->snd + SF2000_SND_PERIOD);
+	writew(0, chip->snd + SF2000_SND_DMA_POS);
 	chip->last_period = 0;
+	dev_info(chip->dev,
+		"DMA base=%pad bytes=%zu period=%lu config=%08x pll=%08x\n",
+		&runtime->dma_addr, bytes, runtime->period_size,
+		readl(chip->snd + SF2000_SND_DMA_SIZE),
+		readl(chip->sys + SF2000_SYS_AUDIO_PLL));
 	return 0;
 }
 
