+#define SF2000_SND_CTL04	0x04
 #define SF2000_SND_CTL08	0x08
 #define SF2000_SND_CTL0C	0x0c
 #define SF2000_SND_DMA_BASE	0x30
@@ -21,13 +22,31 @@
 #define SF2000_SND_DMA_POS	0x38
 #define SF2000_SND_I2S_CTL	0x3c
 #define SF2000_SND_CTL50	0x50
+#define SF2000_SND_PERIOD	0x5c
 #define SF2000_SND_FADE		0x90
 
 #define SF2000_DAC_CTL		0x00
+#define SF2000_SYS_AUDIO_PLL	0x148
+#define SF2000_SYS_AUDIO_GATE	0x154
 #define SF2000_GPIO_R_OUT	0xf4
 #define SF2000_GPIO_R_DIR	0xf8
 #define SF2000_PINMUX_R07	0x4e7
 #define SF2000_AMP_R07		BIT(7)
+#define SF2000_DMA_CHANNEL_MASK	GENMASK(17, 16)
+#define SF2000_DMA_FORMAT_MASK	GENMASK(21, 20)
+#define SF2000_DMA_MONO_PACK	BIT(24)
+#define SF2000_DMA_LEFT_ALIGN	BIT(25)
+#define SF2000_DMA_BIT26		BIT(26)
+#define SF2000_DMA_ENABLE	BIT(27)
+#define SF2000_DMA_PAUSE	BIT(28)
+#define SF2000_DMA_CONFIG_MASK	(SF2000_DMA_CHANNEL_MASK | \
+	SF2000_DMA_FORMAT_MASK | SF2000_DMA_MONO_PACK | \
+	SF2000_DMA_LEFT_ALIGN | SF2000_DMA_BIT26 | SF2000_DMA_ENABLE | \
+	SF2000_DMA_PAUSE)
+#define SF2000_DMA_MONO_S16_LE	(SF2000_DMA_MONO_PACK | \
+	SF2000_DMA_LEFT_ALIGN | BIT(20) | SF2000_DMA_ENABLE)
+#define SF2000_AUDIO_PLL_32K	0x0c000120
+#define SF2000_VOLUME_90		0xcb
 #define SF2000_RATE		32000
 #define SF2000_BUFFER_MAX	(128 * 1024)
 #define SF2000_PERIOD_MIN	256
@@ -50,7 +69,7 @@
 static const struct snd_pcm_hardware sf2000_pcm_hardware = {
 	.info = SNDRV_PCM_INFO_INTERLEAVED | SNDRV_PCM_INFO_BLOCK_TRANSFER |
 		SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_MMAP_VALID |
