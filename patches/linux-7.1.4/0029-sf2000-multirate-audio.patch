[PATCH] sf2000: use the correct per-chip 44.1 kHz I2S divisors

The vendor libauddrv (verified against the linked copy in the UniFrog
firmware) branches on the chip ID for the I2S M/N divisors: HC1512
(SF2000) uses M=284/N=13 for the 48 kHz family and M=281/N=14 for the
44.1 kHz family with only SYS+0x470 control bits 16 and 21 set; the
non-1512 chip (GB300) uses M=344/N=7 with 0x474=0x00106000 for 48 kHz
and M=316/N=7 with 0x474=0x001b6000 for 44.1 kHz, both clearing
SYS+0x470 bit 3.

The previous table applied the GB300 44.1 kHz divisors (M=316/N=7) to
the SF2000, which clocks the I2S bit stream ~2.25x fast and makes
native 44.1/22.05 kHz playback sound high-pitched (kid voice).  Restore
M=281/N=14 for the SF2000 and move M=316/N=7 to the GB300 row where the
firmware puts it.
---
 sound/drivers/sf2000-pcm.c | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

--- a/sound/drivers/sf2000-pcm.c
+++ b/sound/drivers/sf2000-pcm.c
@@ -107,13 +107,13 @@
  * The I2S M/N divisors at SYS+0x478/0x47a and the SYS+0x470/0x474 control
  * words are per clock family AND per chip.  libauddrv branches on the chip
  * ID (high 16 bits of SYS+0x00): HC1512 (SF2000) uses M=284/N=13 for the
- * 48 kHz family and M=316/N=7 with SYS+0x470 bit 3 cleared and
- * SYS+0x474 = 0x001b6000 for the 44.1 kHz family; the non-1512 chip (GB300)
+ * 48 kHz family and M=281/N=14 for the 44.1 kHz family, with SYS+0x470
+ * control bits 16 and 21 set and nothing else; the non-1512 chip (GB300)
  * uses M=344/N=7 with 0x470 bit 3 cleared and 0x474 = 0x00106000 for 48 kHz
- * and M=281/N=14 for 44.1 kHz.  SYS+0x470 control bits 16 and 21 are set for
- * every family.  The previous table used the GB300 44.1 kHz divisors
- * (M=281/N=14) on the SF2000, which clocks the I2S bit stream ~0.6x off and
- * makes native 44.1 kHz/22.05 kHz playback sound pitched-down and dull.
+ * and M=316/N=7 with 0x474 = 0x001b6000 for 44.1 kHz.  Values verified
+ * against the linked libauddrv in the UniFrog firmware.  Applying the GB300
+ * 44.1 kHz divisors (M=316/N=7) to the SF2000 clocks the bit stream ~2.25x
+ * fast (kid voice); M=281/N=14 is the correct SF2000 value.
  */
 struct sf2000_pcm_rate {
 	unsigned int rate;
@@ -143,9 +143,7 @@
 	.div = 0x011c000d,	/* M=284 N=13 */
 };
 static const struct sf2000_i2s_config sf2000_i2s_sf2000_44k = {
-	.div = 0x013c0007,	/* M=316 N=7 */
-	.clear_div_ctl_bit3 = true,
-	.div_ctl2 = 0x001b6000,
+	.div = 0x0119000e,	/* M=281 N=14 */
 };
 static const struct sf2000_i2s_config sf2000_i2s_gb300_48k = {
 	.div = 0x01580007,	/* M=344 N=7 */
@@ -153,7 +151,9 @@
 	.div_ctl2 = 0x00106000,
 };
 static const struct sf2000_i2s_config sf2000_i2s_gb300_44k = {
-	.div = 0x0119000e,	/* M=281 N=14 */
+	.div = 0x013c0007,	/* M=316 N=7 */
+	.clear_div_ctl_bit3 = true,
+	.div_ctl2 = 0x001b6000,
 };
 
 static const struct sf2000_i2s_config *
