+}
+
+void sf2000_ret_before_restore(struct pt_regs *regs)
+{
+	if (!sf2000_identity_userspace_enabled())
+		return;
+
+	if (!(regs->cp0_status & ST0_ERL))
+		return;
+	sf2000_progress_mark("ret-restore-status", 9, regs->cp0_status);
+	sf2000_progress_mark("ret-restore-epc", 9, regs->cp0_epc);
+	if (regs->cp0_status & ST0_EXL) {
+		regs->cp0_status &= ~ST0_EXL;
+		sf2000_progress_mark("ret-restore-status-fixed", 9,
+			regs->cp0_status);
+	}
+
+	sf2000_progress_mark("ret-restore-errorepc-before", 9,
+		read_c0_errorepc());
+	if (regs->cp0_epc == sf2000_identity_init_pc) {
+		sf2000_progress_mark("ret-restore-stub-epc", 9,
+			SF2000_IDENTITY_STUB_KSEG0);
+		regs->cp0_epc = SF2000_IDENTITY_STUB_KSEG0;
+		sf2000_progress_mark("ret-restore-stub-errorepc", 9,
+			SF2000_IDENTITY_STUB_KSEG0);
+		write_c0_errorepc(SF2000_IDENTITY_STUB_KSEG0);
+	} else {
+		sf2000_progress_mark("ret-restore-non-init-pc", 9,
+			sf2000_identity_init_pc);
+		write_c0_errorepc(regs->cp0_epc);
+	}
+	sf2000_progress_mark("ret-restore-epc-after", 9, regs->cp0_epc);
+	sf2000_progress_mark("ret-restore-errorepc-after", 9,
+		read_c0_errorepc());
+}
+
+static bool sf2000_nommu_flat_kseg0_handoff(unsigned long *pc,
+		unsigned long *sp, unsigned long *status)
+{
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000) || IS_ENABLED(CONFIG_MMU))
+		return false;
+
+	if (*pc >= KSEG0)
+		return false;
+
+	sf2000_identity_init_pc = CKSEG0ADDR(*pc);
+	sf2000_identity_init_sp = CKSEG0ADDR(*sp);
+	*pc = sf2000_identity_init_pc;
+	*sp = sf2000_identity_init_sp;
+	*status |= ST0_IE;
+	*status &= ~(ST0_ERL | ST0_EXL | KU_MASK);
+	sf2000_progress_mark("mips-start-thread-kseg0-pc", 9, *pc);
+	sf2000_progress_mark("mips-start-thread-kseg0-sp", 9, *sp);
+	sf2000_progress_mark("mips-start-thread-kseg0-status", 9, *status);
+	write_c0_errorepc(*pc);
+	return true;
+}
+
 void start_thread(struct pt_regs * regs, unsigned long pc, unsigned long sp)
 {
 	unsigned long status;
 
+	if (IS_ENABLED(CONFIG_MIPS_SF2000)) {
+		sf2000_progress_mark("mips-start-thread-pc", 9, pc);
+		sf2000_progress_mark("mips-start-thread-sp", 9, sp);
+		sf2000_progress_mark("mips-start-thread-status-before", 9,
+			regs->cp0_status);
+	}
+
 	/* New thread loses kernel privileges. */
 	status = regs->cp0_status & ~(ST0_CU0|ST0_CU1|ST0_CU2|ST0_FR|KU_MASK);
 	status |= KU_USER;
+	if (sf2000_identity_userspace_enabled()) {
+		if (sf2000_identity_handoff_used)
+			goto normal_user_status;
+		sf2000_identity_handoff_used = true;
+		sf2000_identity_branch_enabled = 1;
+		sf2000_identity_init_pc = pc;
+		status |= ST0_ERL;
+		status &= ~ST0_EXL;
+		status &= ~KU_MASK;
+		/*
+		 * Avoid an interrupt between RESTORE_SP and the final eret.
+		 */
+		status &= ~ST0_IE;
+		sf2000_progress_mark("mips-start-thread-ebase", 9,
+			read_c0_ebase());
+		sf2000_progress_mark("mips-start-thread-errorepc-before", 9,
+			read_c0_errorepc());
+		write_c0_errorepc(pc);
+		sf2000_progress_mark("mips-start-thread-errorepc-after", 9,
+			read_c0_errorepc());
+		sf2000_progress_mark("mips-start-thread-erl-status", 9,
+			status);
+		sf2000_progress_mark("mips-start-thread-erl-sp", 9, sp);
+	} else if (sf2000_nommu_flat_kseg0_handoff(&pc, &sp, &status)) {
+		sf2000_progress_mark("mips-start-thread-errorepc-before", 9,
+			read_c0_errorepc());
+		write_c0_errorepc(pc);
+		sf2000_progress_mark("mips-start-thread-errorepc-after", 9,
+			read_c0_errorepc());
+		sf2000_progress_mark("mips-start-thread-nommu-kseg0-pc", 9, pc);
+		sf2000_progress_mark("mips-start-thread-nommu-kseg0-sp", 9, sp);
+	}
+normal_user_status:
 	regs->cp0_status = status;
 	lose_fpu(0);
 	clear_thread_flag(TIF_MSA_CTX_LIVE);
