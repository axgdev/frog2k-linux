diff --git a/drivers/usb/musb/sf2000.c b/drivers/usb/musb/sf2000.c
new file mode 100644
index 000000000..edea0d990
--- /dev/null
+++ b/drivers/usb/musb/sf2000.c
@@ -0,0 +1,388 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * SF2000 Hichip MUSB glue
+ */
+
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/usb/phy.h>
+#include <linux/usb/usb_phy_generic.h>
+
+#include "musb_core.h"
+
+struct sf2000_glue {
+	struct device *dev;
+	struct platform_device *musb;
+	struct platform_device *usb_phy;
+	void __iomem *syscon;
+	void __iomem *phy;
+	u32 index;
+};
+
+/*
+ * HC15xx USB integration registers, recovered from the vendor libusbdrv.
+ * The two MUSB cores share a PHY control block at 0x18845000 and have
+ * separate reset bits in the main system-control block.
+ */
+#define SF2000_SYSCON_SIZE		0x100
+#define SF2000_USB_PHY_BASE		0x18845000
+#define SF2000_USB_PHY_SIZE		0x200
+#define SF2000_SYS_RESET		0x64
+#define SF2000_SYS_USB_RESET0		0x80
+#define SF2000_SYS_USB_LATCH		0x7c
+#define SF2000_SYS_IRQ_STATUS1		0x34
+#define SF2000_SYS_IRQ_ENABLE1		0x3c
+#define SF2000_SYS_USB_IRQS		GENMASK(21, 18)
+#define SF2000_USB_UTMI_CTRL		0x380
+#define SF2000_USB_UTMI_STATUS		0x384
+#define SF2000_USB0_PHY_TRIM		0x004
+#define SF2000_USB1_PHY_TRIM		0x104
+
+static void sf2000_update32(void __iomem *addr, u32 clear, u32 set)
+{
+	u32 value = readl(addr);
+
+	value &= ~clear;
+	value |= set;
+	writel(value, addr);
+}
+
+static struct musb_fifo_cfg sf2000_fifo_cfg[] = {
+	{ .hw_ep_num = 1, .style = FIFO_TX, .maxpacket = 512 },
+	{ .hw_ep_num = 1, .style = FIFO_RX, .maxpacket = 512 },
+	{ .hw_ep_num = 2, .style = FIFO_TX, .maxpacket = 512 },
+	{ .hw_ep_num = 2, .style = FIFO_RX, .maxpacket = 512 },
+	{ .hw_ep_num = 3, .style = FIFO_TX, .maxpacket = 512 },
+	{ .hw_ep_num = 3, .style = FIFO_RX, .maxpacket = 512 },
+	{ .hw_ep_num = 4, .style = FIFO_TX, .maxpacket = 512 },
+	{ .hw_ep_num = 4, .style = FIFO_RX, .maxpacket = 512 },
+	{ .hw_ep_num = 5, .style = FIFO_TX, .maxpacket = 512 },
+	{ .hw_ep_num = 5, .style = FIFO_RX, .maxpacket = 512 },
+};
+
+static const struct musb_hdrc_config sf2000_musb_config = {
+	.fifo_cfg = sf2000_fifo_cfg,
+	.fifo_cfg_size = ARRAY_SIZE(sf2000_fifo_cfg),
+	.multipoint = 1,
+	.dyn_fifo = 1,
+	.num_eps = 7,
+	.ram_bits = 12,
+};
+
+static irqreturn_t sf2000_musb_interrupt(int irq, void *data)
+{
+	struct musb *musb = data;
+	irqreturn_t ret = IRQ_NONE;
+	unsigned long flags;
+
+	spin_lock_irqsave(&musb->lock, flags);
+	musb->int_rx = musb_readw(musb->mregs, MUSB_INTRRX) &
+		musb_readw(musb->mregs, MUSB_INTRRXE);
+	musb->int_tx = musb_readw(musb->mregs, MUSB_INTRTX) &
+		musb_readw(musb->mregs, MUSB_INTRTXE);
+	musb->int_usb = musb_readb(musb->mregs, MUSB_INTRUSB) &
+		musb_readb(musb->mregs, MUSB_INTRUSBE);
+	if (musb->int_rx || musb->int_tx || musb->int_usb)
+		ret = musb_interrupt(musb);
+	spin_unlock_irqrestore(&musb->lock, flags);
+
+	return ret;
+}
+
+static void sf2000_hc15_reset(struct sf2000_glue *glue, struct musb *musb)
+{
+	u32 reset_gate = BIT(24 + glue->index);
+	u32 reset_pulse = BIT(28 + glue->index);
+	u32 trim = glue->index ? SF2000_USB1_PHY_TRIM :
+				 SF2000_USB0_PHY_TRIM;
+	u8 value;
+
+	/* Ungate the controller, then pulse its dedicated PHY/controller reset. */
+	sf2000_update32(glue->syscon + SF2000_SYS_RESET, reset_gate, 0);
+	udelay(900);
+	sf2000_update32(glue->syscon + SF2000_SYS_USB_RESET0 +
+			(glue->index * sizeof(u32)), 0, reset_pulse);
+	udelay(900);
+	sf2000_update32(glue->syscon + SF2000_SYS_USB_RESET0 +
+			(glue->index * sizeof(u32)), reset_pulse, 0);
+
+	/* Vendor reset leaves the high nibble at 0xd and preserves trim[3:0]. */
+	value = readb(glue->phy + trim);
+	writeb((value & 0x0f) | 0xd0, glue->phy + trim);
+
+	/* A read/write of this register is part of the HC15xx clock latch. */
+	writel(readl(glue->syscon + SF2000_SYS_USB_LATCH),
+	       glue->syscon + SF2000_SYS_USB_LATCH);
+
+	/*
+	 * PHY power sequence.  0x8c is the vendor's enabled value;
+	 * bit zero is a strobe and must be removed after the settle delay.
+	 */
+	sf2000_update32(musb->mregs + SF2000_USB_UTMI_CTRL, 0x90, 0x8d);
+	udelay(900);
+	sf2000_update32(musb->mregs + SF2000_USB_UTMI_CTRL, BIT(0), 0);
+}
+
+static void sf2000_hc15_set_host(struct sf2000_glue *glue,
+				 struct musb *musb)
+{
+	u8 value;
+
+	/* Exact __hcmusb_15xx_set_mode(..., USB_DR_MODE_HOST=1) branch. */
+	if (!glue->index) {
+		value = readb(musb->mregs + SF2000_USB_UTMI_CTRL);
+		writeb(value | BIT(7), musb->mregs + SF2000_USB_UTMI_CTRL);
+	} else {
+		value = readb(musb->mregs + SF2000_USB_UTMI_CTRL);
+		writeb(value & ~BIT(6), musb->mregs + SF2000_USB_UTMI_CTRL);
+	}
+
+	/* Force a clean A-device session edge, as required by HC15xx. */
+	value = musb_readb(musb->mregs, MUSB_DEVCTL);
+	musb_writeb(musb->mregs, MUSB_DEVCTL, value & ~MUSB_DEVCTL_SESSION);
+	udelay(1000);
+	value = musb_readb(musb->mregs, MUSB_DEVCTL);
+	musb_writeb(musb->mregs, MUSB_DEVCTL, value | MUSB_DEVCTL_SESSION);
+
+	value = musb_readb(musb->mregs, MUSB_POWER);
+	musb_writeb(musb->mregs, MUSB_POWER, value | MUSB_POWER_HSENAB);
+	udelay(1000);
+}
+
+static int sf2000_musb_set_mode(struct musb *musb, u8 mode)
+{
+	struct sf2000_glue *glue = dev_get_drvdata(musb->controller->parent);
+
+	if (!glue)
+		return -ENODEV;
+	if (mode != MUSB_HOST)
+		return -EINVAL;
+
+	/*
+	 * MUSB core clears POWER and DEVCTL after platform init.  Apply the
+	 * HC15xx ID override and SESSION edge here, from its set_mode callback,
+	 * exactly where the vendor driver does it: after host setup is complete.
+	 */
+	sf2000_hc15_set_host(glue, musb);
+	dev_info(glue->dev,
+		 "HC15xx host%u active: power=%02x devctl=%02x utmi=%08x\n",
+		 glue->index, musb_readb(musb->mregs, MUSB_POWER),
+		 musb_readb(musb->mregs, MUSB_DEVCTL),
+		 readl(musb->mregs + SF2000_USB_UTMI_CTRL));
+	return 0;
+}
+
+static int sf2000_musb_init(struct musb *musb)
+{
+	struct sf2000_glue *glue = dev_get_drvdata(musb->controller->parent);
+
+	if (!glue)
+		return -ENODEV;
+
+	musb->xceiv = devm_usb_get_phy(musb->controller->parent,
+					 USB_PHY_TYPE_USB2);
+	if (IS_ERR(musb->xceiv))
+		return PTR_ERR(musb->xceiv);
+
+	musb->dyn_fifo = true;
+	musb->isr = sf2000_musb_interrupt;
+	sf2000_hc15_reset(glue, musb);
+
+	dev_info(glue->dev,
+		 "HC15xx host%u reset: power=%02x devctl=%02x utmi=%08x\n",
+		 glue->index, musb_readb(musb->mregs, MUSB_POWER),
+		 musb_readb(musb->mregs, MUSB_DEVCTL),
+		 readl(musb->mregs + SF2000_USB_UTMI_CTRL));
+
+	return 0;
+}
+
+static void sf2000_musb_enable(struct musb *musb)
+{
+	struct sf2000_glue *glue = dev_get_drvdata(musb->controller->parent);
+
+	if (!glue)
+		return;
+
+	/*
+	 * Exact hc16xx_musb_enable() contract used by the HC15xx vendor
+	 * integration too: enable USB0/1 MC and DMA sources in SYSIRQ bank 1.
+	 * The generic irqchip enables the requested MC line, but the hardware
+	 * block is brought out of its platform-level mask as one four-bit unit.
+	 */
+	sf2000_update32(glue->syscon + SF2000_SYS_IRQ_ENABLE1, 0,
+			SF2000_SYS_USB_IRQS);
+	dev_info(glue->dev,
+		 "HC15xx host%u enable: irqstat=%08x irqen=%08x intr=%04x/%04x/%02x en=%04x/%04x/%02x phy=%08x\n",
+		 glue->index,
+		 readl(glue->syscon + SF2000_SYS_IRQ_STATUS1),
+		 readl(glue->syscon + SF2000_SYS_IRQ_ENABLE1),
+		 musb_readw(musb->mregs, MUSB_INTRTX),
+		 musb_readw(musb->mregs, MUSB_INTRRX),
+		 musb_readb(musb->mregs, MUSB_INTRUSB),
+		 musb_readw(musb->mregs, MUSB_INTRTXE),
+		 musb_readw(musb->mregs, MUSB_INTRRXE),
+		 musb_readb(musb->mregs, MUSB_INTRUSBE),
+		 readl(musb->mregs + SF2000_USB_UTMI_STATUS));
+}
+
+static void sf2000_musb_disable(struct musb *musb)
+{
+	struct sf2000_glue *glue = dev_get_drvdata(musb->controller->parent);
+
+	if (glue)
+		sf2000_update32(glue->syscon + SF2000_SYS_IRQ_ENABLE1,
+				SF2000_SYS_USB_IRQS, 0);
+}
+
+static int sf2000_musb_exit(struct musb *musb)
+{
+	return 0;
+}
+
+static const struct musb_platform_ops sf2000_musb_ops = {
+	.quirks = MUSB_DMA_INVENTRA | MUSB_INDEXED_EP,
+	.init = sf2000_musb_init,
+	.exit = sf2000_musb_exit,
+	.set_mode = sf2000_musb_set_mode,
+	.enable = sf2000_musb_enable,
+	.disable = sf2000_musb_disable,
+};
+
+static int sf2000_usb_probe(struct platform_device *pdev)
+{
+	const struct musb_hdrc_platform_data pdata = {
+		.mode = MUSB_HOST,
+		.power = 250,
+		.config = &sf2000_musb_config,
+		.platform_ops = &sf2000_musb_ops,
+	};
+	struct sf2000_glue *glue;
+	struct platform_device *musb;
+	struct resource resources[3];
+	struct resource *memory;
+	u32 ctrl_base;
+	int irq_mc;
+	int irq_dma;
+	int ret;
+
+	glue = devm_kzalloc(&pdev->dev, sizeof(*glue), GFP_KERNEL);
+	if (!glue)
+		return -ENOMEM;
+	glue->dev = &pdev->dev;
+
+	glue->usb_phy = usb_phy_generic_register();
+	if (IS_ERR(glue->usb_phy))
+		return PTR_ERR(glue->usb_phy);
+	if (!glue->usb_phy)
+		return -ENODEV;
+
+	ret = of_property_read_u32(pdev->dev.of_node, "index_num",
+				   &glue->index);
+	if (ret || glue->index > 1) {
+		dev_err(&pdev->dev, "missing or invalid index_num\n");
+		ret = ret ? ret : -EINVAL;
+		goto err_phy;
+	}
+	ret = of_property_read_u32(pdev->dev.of_node, "ctrl_base", &ctrl_base);
+	if (ret)
+		goto err_phy;
+	glue->syscon = devm_ioremap(&pdev->dev, ctrl_base,
+				    SF2000_SYSCON_SIZE);
+	if (!glue->syscon) {
+		ret = -ENOMEM;
+		goto err_phy;
+	}
+	glue->phy = devm_ioremap(&pdev->dev, SF2000_USB_PHY_BASE,
+				 SF2000_USB_PHY_SIZE);
+	if (!glue->phy) {
+		ret = -ENOMEM;
+		goto err_phy;
+	}
+
+	musb = platform_device_alloc("musb-hdrc", PLATFORM_DEVID_AUTO);
+	if (!musb) {
+		ret = -ENOMEM;
+		goto err_phy;
+	}
+
+	musb->dev.parent = &pdev->dev;
+	musb->dev.dma_mask = &musb->dev.coherent_dma_mask;
+	musb->dev.coherent_dma_mask = DMA_BIT_MASK(32);
+
+	memory = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	irq_mc = platform_get_irq_byname(pdev, "mc");
+	irq_dma = platform_get_irq_byname(pdev, "dma");
+	if (!memory || irq_mc < 0 || irq_dma < 0) {
+		ret = !memory ? -ENODEV : (irq_mc < 0 ? irq_mc : irq_dma);
+		goto err_put;
+	}
+	resources[0] = *memory;
+	resources[1] = (struct resource) {
+		.start = irq_mc, .end = irq_mc, .flags = IORESOURCE_IRQ,
+		.name = "mc",
+	};
+	resources[2] = (struct resource) {
+		.start = irq_dma, .end = irq_dma, .flags = IORESOURCE_IRQ,
+		.name = "dma",
+	};
+	ret = platform_device_add_resources(musb, resources,
+					    ARRAY_SIZE(resources));
+	if (ret)
+		goto err_put;
+
+	ret = platform_device_add_data(musb, &pdata, sizeof(pdata));
+	if (ret)
+		goto err_put;
+
+	platform_set_drvdata(pdev, glue);
+	ret = platform_device_add(musb);
+	if (ret)
+		goto err_put;
+
+	glue->musb = musb;
+
+	dev_info(&pdev->dev, "registered SF2000 musb-hdrc glue\n");
+	return 0;
+
+err_put:
+	platform_device_put(musb);
+err_phy:
+	usb_phy_generic_unregister(glue->usb_phy);
+	return ret;
+}
+
+static void sf2000_usb_remove(struct platform_device *pdev)
+{
+	struct sf2000_glue *glue = platform_get_drvdata(pdev);
+
+	platform_device_unregister(glue->musb);
+	usb_phy_generic_unregister(glue->usb_phy);
+}
+
+static const struct of_device_id sf2000_usb_of_match[] = {
+	{ .compatible = "hichip,hc15xx-musb" },
+	{ .compatible = "hichip,hc16xx-musb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sf2000_usb_of_match);
+
+static struct platform_driver sf2000_usb_driver = {
+	.probe = sf2000_usb_probe,
+	.remove = sf2000_usb_remove,
+	.driver = {
+		.name = "sf2000-usb",
+		.of_match_table = sf2000_usb_of_match,
+	},
+};
+module_platform_driver(sf2000_usb_driver);
+
+MODULE_DESCRIPTION("SF2000 Hichip MUSB glue");
+MODULE_AUTHOR("Codex");
+MODULE_LICENSE("GPL");
diff --git a/fs/binfmt_elf.c b/fs/binfmt_elf.c
index 16a56b6b3..f6cd3887b 100644
--- a/fs/binfmt_elf.c
+++ b/fs/binfmt_elf.c
@@ -852,6 +852,7 @@ static int load_elf_binary(struct linux_binprm *bprm)
 	struct mm_struct *mm;
 	struct pt_regs *regs;
 
+	sf2000_elf_value("elf-entry", (unsigned int)elf_ex->e_entry);
 	retval = -ENOEXEC;
 	/* First of all, some simple consistency checks */
 	if (memcmp(elf_ex->e_ident, ELFMAG, SELFMAG) != 0)
@@ -867,6 +868,8 @@ static int load_elf_binary(struct linux_binprm *bprm)
 		goto out;
 
 	elf_phdata = load_elf_phdrs(elf_ex, bprm->file);
+	sf2000_elf_value("elf-after-phdrs", elf_phdata ?
+		(unsigned int)elf_phdata : (unsigned int)-ENOMEM);
 	if (!elf_phdata)
 		goto out;
 
@@ -992,6 +995,7 @@ static int load_elf_binary(struct linux_binprm *bprm)
 
 	retval = parse_elf_properties(interpreter ?: bprm->file,
 				      elf_property_phdata, &arch_state);
+	sf2000_elf_value("elf-after-properties", (unsigned int)retval);
 	if (retval)
 		goto out_free_dentry;
 
@@ -1003,11 +1007,14 @@ static int load_elf_binary(struct linux_binprm *bprm)
 	retval = arch_check_elf(elf_ex,
 				!!interpreter, interp_elf_ex,
 				&arch_state);
+	sf2000_elf_value("elf-after-arch-check", (unsigned int)retval);
 	if (retval)
 		goto out_free_dentry;
 
 	/* Flush all traces of the currently running executable */
+	sf2000_elf_mark("elf-before-begin-new");
 	retval = begin_new_exec(bprm);
+	sf2000_elf_value("elf-after-begin-new", (unsigned int)retval);
 	if (retval)
 		goto out_free_dentry;
 
@@ -1022,11 +1029,13 @@ static int load_elf_binary(struct linux_binprm *bprm)
 		current->flags |= PF_RANDOMIZE;
 
 	setup_new_exec(bprm);
+	sf2000_elf_mark("elf-after-setup-new");
 
