+static void __maybe_unused sf2000_rw_word(unsigned int index, unsigned int value)
+{
+	switch (index) {
+	case 0:
+		sf2000_rw_value("write-w0", value);
+		break;
+	case 1:
+		sf2000_rw_value("write-w1", value);
+		break;
+	case 2:
+		sf2000_rw_value("write-w2", value);
+		break;
