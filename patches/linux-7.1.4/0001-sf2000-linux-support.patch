+		break;
+	case 6:
+		sf2000_rw_value("write-w6", value);
+		break;
+	case 7:
+		sf2000_rw_value("write-w7", value);
+		break;
+	}
+}
+
+static void __maybe_unused sf2000_rw_log_write(unsigned int fd, const char __user *buf,
+		size_t count)
+{
+	const char *raw = (const char *)buf;
+	unsigned int i;
+	unsigned int limit;
+	unsigned int word = 0;
+
+	if (!IS_ENABLED(CONFIG_MIPS_SF2000))
+		return;
+
+	sf2000_rw_value("write-fd", fd);
+	sf2000_rw_value("write-buf", (unsigned int)buf);
+	sf2000_rw_value("write-count", (unsigned int)count);
+
+	if (!sf2000_nommu_kseg0_user_addr(buf)) {
+		sf2000_rw_value("write-not-kseg0", (unsigned int)buf);
+		return;
+	}
+
+	limit = count < 32 ? count : 32;
+	for (i = 0; i < limit; i++) {
+		word |= (unsigned int)(unsigned char)raw[i] << ((i & 3) * 8);
+		if ((i & 3) == 3) {
+			sf2000_rw_word(i >> 2, word);
+			word = 0;
+		}
+	}
+	if (limit & 3)
+		sf2000_rw_word(limit >> 2, word);
+}
+#else
+static void sf2000_rw_value(const char *name, unsigned int value) {}
+static void sf2000_rw_log_write(unsigned int fd, const char __user *buf,
+		size_t count) {}
