+static void sf2000_ge_free_buffers(struct sf2000_ge *ge)
+{
+	u32 i;
+
+	for (i = 0; i < HCGE_BUFFER_SLOTS; ++i) {
+		if (!ge->buffers[i].address)
+			continue;
+		free_pages_exact(ge->buffers[i].address, ge->buffers[i].bytes);
+		ge->buffers[i].address = NULL;
+		ge->buffers[i].bytes = 0;
+	}
