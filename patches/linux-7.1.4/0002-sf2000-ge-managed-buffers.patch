+	case HCGE_ALLOC_BUFFER: {
+		struct hcge_buffer_info info;
+		void *address;
+		u32 slot;
+
+		if (copy_from_user(&info, (void __user *)arg, sizeof(info)))
+			return -EFAULT;
+		if (!info.bytes || info.bytes > SZ_1M)
+			return -EINVAL;
+		for (slot = 0; slot < HCGE_BUFFER_SLOTS; ++slot)
+			if (!ge->buffers[slot].address)
+				break;
+		if (slot == HCGE_BUFFER_SLOTS)
+			return -ENOSPC;
+		info.bytes = PAGE_ALIGN(info.bytes);
+		address = alloc_pages_exact(info.bytes, GFP_KERNEL | __GFP_ZERO);
+		if (!address)
+			return -ENOMEM;
+		ge->buffers[slot].address = address;
+		ge->buffers[slot].bytes = info.bytes;
+		info.address = (u32)(unsigned long)address;
+		info.phys = (u32)virt_to_phys(address);
+		info.handle = slot + 1;
+		if (copy_to_user((void __user *)arg, &info, sizeof(info))) {
+			free_pages_exact(address, info.bytes);
+			ge->buffers[slot].address = NULL;
+			ge->buffers[slot].bytes = 0;
+			return -EFAULT;
+		}
+		return 0;
+	}
+	case HCGE_FREE_BUFFER: {
+		u32 slot = (u32)arg;
+
+		if (!slot || slot > HCGE_BUFFER_SLOTS)
+			return -EINVAL;
+		--slot;
+		if (!ge->buffers[slot].address)
+			return -ENOENT;
+		free_pages_exact(ge->buffers[slot].address,
+				 ge->buffers[slot].bytes);
+		ge->buffers[slot].address = NULL;
+		ge->buffers[slot].bytes = 0;
+		return 0;
+	}
 	default:
 		return -ENOTTY;
