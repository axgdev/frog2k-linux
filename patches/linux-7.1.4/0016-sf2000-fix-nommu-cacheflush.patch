diff --git a/arch/mips/mm/cache.c b/arch/mips/mm/cache.c
index b3b10015e8ab..84900f613bd0 100644
--- a/arch/mips/mm/cache.c
+++ b/arch/mips/mm/cache.c
@@ -86,5 +86,30 @@ void (*_dma_cache_inv)(unsigned long start, unsigned long size);
  * that seems very atypical use ...
  */
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+static bool sf2000_nommu_cache_range_ok(unsigned long addr,
+				       unsigned long bytes)
+{
+	struct vm_area_struct *vma;
+	unsigned long end;
+	bool valid;
+
+	if (!current->mm || check_add_overflow(addr, bytes, &end))
+		return false;
+
+	/*
+	 * NOMMU executable mappings on the SF2000 are cached KSEG0 addresses.
+	 * access_ok() rejects those addresses even though they belong to the
+	 * calling process.  Accept only a range wholly contained in one of the
+	 * caller's VMAs; never grant generic access to KSEG0.
+	 */
+	mmap_read_lock(current->mm);
+	vma = find_vma(current->mm, addr);
+	valid = vma && addr >= vma->vm_start && end <= vma->vm_end;
+	mmap_read_unlock(current->mm);
+	return valid;
+}
+#endif
+
 SYSCALL_DEFINE3(cacheflush, unsigned long, addr, unsigned long, bytes,
 	unsigned int, cache)
 {
@@ -92,6 +117,11 @@ SYSCALL_DEFINE3(cacheflush, unsigned long, addr, unsigned long, bytes,
 		return 0;
-	if (!access_ok((void __user *) addr, bytes))
+#if defined(CONFIG_MIPS_SF2000) && !defined(CONFIG_MMU)
+	if (!sf2000_nommu_cache_range_ok(addr, bytes))
+		return -EFAULT;
+#else
+	if (!access_ok((void __user *)addr, bytes))
 		return -EFAULT;
+#endif
 
 	__flush_icache_user_range(addr, addr + bytes);
 
