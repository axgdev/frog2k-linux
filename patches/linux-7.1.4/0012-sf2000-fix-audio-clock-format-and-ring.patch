+static void sf2000_pcm_service_guard(struct sf2000_pcm *chip)
+{
+	u16 consumer;
+
+	/*
+	 * SND0 has no full flag; equal cursors always mean empty.  libauddrv
+	 * reserves 64 bytes and publishes the deferred tail after the consumer
+	 * moves.  Without this guard a full ALSA write stops DMA permanently.
+	 */
+	consumer = readw(chip->snd + SF2000_SND_DMA_POS + 2);
+	if (chip->published_producer != chip->target_producer &&
+	    consumer != chip->target_producer) {
+		chip->published_producer = chip->target_producer;
+		dma_wmb();
+		writew(chip->published_producer,
+			chip->snd + SF2000_SND_DMA_POS);
+	}
+	if (chip->published_producer != consumer)
+		(void)sf2000_pcm_arm_if_pending(chip);
+}
