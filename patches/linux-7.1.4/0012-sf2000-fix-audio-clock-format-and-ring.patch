+static void sf2000_dac_init(struct sf2000_pcm *chip)
+{
+	u32 value = readl(chip->dac + SF2000_DAC_CTL);
+
+	/* Exact pwm_dai_init sequence recovered from the vendor libauddrv. */
+	value &= ~BIT(10);
+	value |= BIT(9) | BIT(8);
+	value &= ~(BIT(14) | BIT(15));
+	value &= ~BIT(22);
+	value |= BIT(23);
+	value &= ~BIT(17);
+	value |= BIT(18);
+	value &= ~BIT(20);
+	value &= ~(GENMASK(27, 24));
+	value |= BIT(25);
+	value &= ~GENMASK(30, 28);
+	value |= BIT(30);
+	value &= ~BIT(23);
+	value &= ~BIT(18);
+	writel(value, chip->dac + SF2000_DAC_CTL);
+}
+
+static void sf2000_apll_reset(struct sf2000_pcm *chip)
+{
+	sf2000_update_bits(chip->sys + SF2000_SYS_APLL_RESET,
+		BIT(5), BIT(5));
+	usleep_range(1000, 1500);
+	sf2000_update_bits(chip->sys + SF2000_SYS_APLL_RESET, BIT(5), 0);
+}
