[PATCH] sf2000: make GE queue polling independent of IRQ delivery

Treat the completion IRQ as an accelerator only. Require BUSY clear and HQ_FIRST consumption, then return directly from HCGE_SYNC_TIMEOUT.

--- a/drivers/misc/sf2000-ge.c
+++ b/drivers/misc/sf2000-ge.c
@@ -332,36 +332,39 @@
 		return 0;
 	case HCGE_SYNC_TIMEOUT: {
 		unsigned long timeout = msecs_to_jiffies(arg ? arg : 1000);
-		long waited;
 		int idle;
-		u32 first = readl(ge->regs + SF2000_GE_HQ_FIRST);
 		u32 status = readl(ge->regs + SF2000_GE_STATUS);
 
+		/*
+		 * The completion IRQ is only an accelerator.  The physical HC15xx
+		 * sysint cascade can be silent, so a successful poll must complete
+		 * the ioctl without waiting on the IRQ.  A latched DONE bit alone
+		 * can describe an inherited or previous transaction; require BUSY
+		 * clear and HQ_FIRST to consume the published producer.
+		 */
 		if (ctx->is_finish) {
 			idle = readl_poll_timeout(ge->regs + SF2000_GE_STATUS,
 				status, !(status & SF2000_GE_STATUS_BUSY),
 				10, jiffies_to_usecs(timeout));
-			if (!idle)
-				return 0;
-		} else if (!(status & SF2000_GE_STATUS_BUSY) &&
-			   first == (ctx->phy_addr_start & ~1u))
-			return 0;
-		waited = wait_for_completion_interruptible_timeout(&ge->done,
-								   timeout);
-		if (waited < 0)
-			return -EINTR;
-		if (waited > 0) {
+		} else {
 			idle = readl_poll_timeout(ge->regs + SF2000_GE_STATUS,
-				status, !(status & SF2000_GE_STATUS_BUSY),
-				10, jiffies_to_usecs(waited));
-			if (!idle)
-				return 0;
+				status,
+				!(status & SF2000_GE_STATUS_BUSY) &&
+				(readl(ge->regs + SF2000_GE_HQ_FIRST) ==
+					(ctx->phy_addr_start & ~1u) ||
+				 (SF2000_GE_NODE_WRAP(ctx->phy_addr_start) &&
+				  readl(ge->regs + SF2000_GE_HQ_FIRST) ==
+					ctx->phy_addr_min)),
+				10, jiffies_to_usecs(timeout));
+		}
+		if (idle) {
+			dev_err_ratelimited(ge->dev,
+				"sync timeout status=%08x first=%08x producer=%08x finish=%u\n",
+				status, readl(ge->regs + SF2000_GE_HQ_FIRST),
+				ctx->phy_addr_start, ctx->is_finish);
+			return -ETIMEDOUT;
 		}
-		dev_err_ratelimited(ge->dev,
-			"sync timeout status=%08x first=%08x producer=%08x finish=%u\n",
-			status, readl(ge->regs + SF2000_GE_HQ_FIRST),
-			ctx->phy_addr_start, ctx->is_finish);
-		return -ETIMEDOUT;
+		return 0;
 	}
 	case HCGE_GET_CMDQ_BUFINFO: {
 		struct hcge_cmdq_buf_info info = {
@@ -402,6 +405,35 @@
 			return -EINVAL;
 		mutex_lock(&ge->submit_lock);
 		/*
+		 * Drain the previous node before publishing.  The completion IRQ
+		 * (which normally clears the latched STATUS) is not delivered on
+		 * every HC15xx boot, so a stale BUSY bit would make the busy gate
+		 * below skip the doorbell and wedge the queue.  The engine sets
+		 * DONE and advances HQ_FIRST to the producer when it consumes a
+		 * node (vendor/NuttX poll contract); clear the latched status the
+		 * way the IRQ handler would once that has happened.
+		 */
+		{
+			u32 drain;
+
+			if (readl_poll_timeout(ge->regs + SF2000_GE_STATUS,
+					drain,
+					(!(drain & SF2000_GE_STATUS_BUSY) &&
+					 (readl(ge->regs + SF2000_GE_HQ_FIRST) ==
+						(ctx->phy_addr_start & ~1u) ||
+					  (SF2000_GE_NODE_WRAP(ctx->phy_addr_start) &&
+					   readl(ge->regs + SF2000_GE_HQ_FIRST) ==
+						ctx->phy_addr_min))),
+					10, 250 * USEC_PER_MSEC)) {
+				mutex_unlock(&ge->submit_lock);
+				return -EBUSY;
+			}
+			/* STATUS is write-one-to-clear on HC15xx. */
+			drain = readl(ge->regs + SF2000_GE_STATUS);
+			if (drain)
+				writel(drain, ge->regs + SF2000_GE_STATUS);
+		}
+		/*
 		 * Follow the vendor ring contract.  The producer's low bit records a
 		 * wrap, point_wrap_addr terminates the old tail, and the IRQ moves
 		 * HQ_FIRST back to phy_addr_min only after that tail is consumed.
