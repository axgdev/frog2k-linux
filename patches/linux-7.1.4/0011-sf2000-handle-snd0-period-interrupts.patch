+static bool sf2000_pcm_ack_events(struct sf2000_pcm *chip)
+{
+	u32 ctl08 = readl(chip->snd + SF2000_SND_CTL08);
+	u32 ctl0c = readl(chip->snd + SF2000_SND_CTL0C);
+	u32 status08 = ctl08 & SF2000_SND08_STATUS_MASK;
+	u32 status0c = ctl0c & SF2000_SND0C_STATUS_MASK;
+	bool period = ((ctl08 & (BIT(16) | BIT(0))) ==
+			(BIT(16) | BIT(0))) ||
+		((ctl0c & (BIT(8) | BIT(0))) == (BIT(8) | BIT(0)));
+
+	/*
+	 * The upper bits are W1C event latches while their corresponding low
+	 * bits are enables.  Match libauddrv's masks so an unacknowledged
+	 * period event cannot hold the DMA consumer at the ring boundary.
+	 */
+	if (status08)
+		writel((ctl08 & GENMASK(15, 0)) | status08,
+			chip->snd + SF2000_SND_CTL08);
+	if (status0c)
+		writel((ctl0c & 0x00ff00ff) | status0c,
+			chip->snd + SF2000_SND_CTL0C);
+	return period;
+}
+
+static irqreturn_t sf2000_pcm_irq(int irq, void *data)
+{
+	struct sf2000_pcm *chip = data;
+	struct snd_pcm_substream *substream = READ_ONCE(chip->substream);
+
+	(void)irq;
+	if (!sf2000_pcm_ack_events(chip))
+		return IRQ_NONE;
+	if (READ_ONCE(chip->running) && substream)
+		snd_pcm_period_elapsed(substream);
+	return IRQ_HANDLED;
+}
