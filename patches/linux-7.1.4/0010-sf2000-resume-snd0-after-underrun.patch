+/*
+ * HC1512 clears SND0+0x04 bit 16 when the cyclic producer runs dry.
+ * libauddrv tests and restores this bit after every producer publication.
+ * Do the same, and also call this from the poll timer to close the race where
+ * hardware observes an empty ring immediately after software publishes data.
+ */
+static bool sf2000_pcm_arm_if_pending(struct sf2000_pcm *chip)
+{
+	u16 producer;
+	u16 consumer;
+
+	if (!READ_ONCE(chip->running))
+		return false;
+
+	producer = readw(chip->snd + SF2000_SND_DMA_POS);
+	consumer = readw(chip->snd + SF2000_SND_DMA_POS + 2);
+	if (producer == consumer ||
+	    readl(chip->snd + SF2000_SND_CTL04) & BIT(16))
+		return false;
+
+	sf2000_update_bits(chip->snd + SF2000_SND_CTL04, BIT(16), BIT(16));
+	return true;
+}
