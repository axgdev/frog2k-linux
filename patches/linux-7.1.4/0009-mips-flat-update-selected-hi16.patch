diff --git a/arch/mips/include/asm/flat.h b/arch/mips/include/asm/flat.h
index 283a879b7..7bd445ef3 100644
--- a/arch/mips/include/asm/flat.h
+++ b/arch/mips/include/asm/flat.h
@@ -295,7 +295,20 @@ static inline int flat_put_addr_at_rp(u32 __user *rp, u32 addr, u32 relval)
 		lo = get_unaligned(p);
 		if (flat_mips_find_hi16_for_lo16(rp, lo, &hi_rp, &hi)) {
 			u32 original = ((hi & 0xffff) << 16) +
 				       (s16)(lo & 0xffff);
+			u32 relocated_hi;
+
+			/*
+			 * Always update the exact LUI selected for this LO16.
+			 * The hash walk below also fixes duplicated HI16
+			 * relocations, but it must not be the only update:
+			 * overwritten hash slots otherwise lose the carry
+			 * from a relocated low half >= 0x8000.
+			 */
+			relocated_hi = get_unaligned((__force u32 *)hi_rp);
+			relocated_hi = (relocated_hi & 0xffff0000) |
+				(((addr + 0x8000) >> 16) & 0xffff);
+			put_unaligned(relocated_hi, (__force u32 *)hi_rp);
 
 			flat_mips_update_hi16_for_lo16(rp, lo, original, addr);
 		}
