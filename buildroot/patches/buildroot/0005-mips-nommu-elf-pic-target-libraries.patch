From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Subject: [PATCH] gcc: build MIPS no-MMU ELF target libraries as PIC

Static-PIE applications can only link archives whose objects use the MIPS PIC
ABI. Buildroot's normal target optimization flags are injected by the compiler
wrapper, but GCC builds libgcc and libstdc++ with its private xgcc and therefore
does not see those wrapper flags.

Apply the PIC ABI directly to GCC target libraries for the MIPS no-MMU ELF
combination. Also omit Buildroot's redundant global `-static`: `-static-pie`
already selects static libraries, while passing both options makes GCC choose
fixed-address startup objects. Fixed-address ET_EXEC programs remain explicitly
non-PIC at their own compile sites.

--- a/package/Makefile.in
+++ b/package/Makefile.in
@@ -445,10 +445,12 @@ endif
 
 ifeq ($(BR2_STATIC_LIBS),y)
 SHARED_STATIC_LIBS_OPTS = --enable-static --disable-shared
+ifneq ($(BR2_mipsel)$(BR2_BINFMT_ELF)$(BR2_USE_MMU),yy)
 TARGET_CFLAGS += -static
 TARGET_CXXFLAGS += -static
 TARGET_FCFLAGS += -static
 TARGET_LDFLAGS += -static
+endif
 else ifeq ($(BR2_SHARED_LIBS),y)
 SHARED_STATIC_LIBS_OPTS = --disable-static --enable-shared
 else ifeq ($(BR2_SHARED_STATIC_LIBS),y)
--- a/package/gcc/gcc.mk
+++ b/package/gcc/gcc.mk
@@ -106,6 +106,13 @@ GCC_COMMON_TARGET_CFLAGS = $(TARGET_CFLAGS) $(ARCH_TOOLCHAIN_WRAPPER_OPTS)
 GCC_COMMON_TARGET_CXXFLAGS = $(TARGET_CXXFLAGS) $(ARCH_TOOLCHAIN_WRAPPER_OPTS)
 GCC_COMMON_TARGET_LDFLAGS = $(TARGET_LDFLAGS) $(ARCH_TOOLCHAIN_WRAPPER_OPTS)
 
+ifeq ($(BR2_mipsel),y)
+ifeq ($(BR2_BINFMT_ELF)$(BR2_USE_MMU),y)
+GCC_COMMON_TARGET_CFLAGS += -fPIC -mabicalls -G0
+GCC_COMMON_TARGET_CXXFLAGS += -fPIC -mabicalls -G0
+endif
+endif
+
 # used to fix ../../../../libsanitizer/libbacktrace/../../libbacktrace/elf.c:772:21: error: 'st.st_mode' may be used uninitialized in this function [-Werror=maybe-uninitialized]
 ifeq ($(BR2_ENABLE_DEBUG),y)
 GCC_COMMON_TARGET_CFLAGS += -Wno-error
