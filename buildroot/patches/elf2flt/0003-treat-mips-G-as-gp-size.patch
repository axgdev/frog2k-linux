From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Sun, 19 Jul 2026 06:20:00 +0000
Subject: [PATCH] ld-elf2flt: treat MIPS -G as the small-data size

GCC passes "-G 0" to the MIPS linker to disable the small-data area.
ld-elf2flt historically treats every bare -G as the System V spelling of
--shared, so current MIPS GCC links abort because no shared-library ID was
provided.  MIPS ld defines -G as --gpsize and requires its numeric argument;
preserve both arguments for ld.real instead of changing the bFLT link mode.

---
 ld-elf2flt.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/ld-elf2flt.c b/ld-elf2flt.c
index 6d80b67..9a516c9 100644
--- a/ld-elf2flt.c
+++ b/ld-elf2flt.c
@@ -434,6 +434,11 @@ static void parse_args(int argc, char **argv)
 		} else if (streq(arg, "-shared-lib-id")) {
 			shared_lib_id = argv[++argno];
-		} else if (streq(arg, "-shared") || streq(arg, "-G")) {
+#if defined(TARGET_mips) || defined(TARGET_mipsel)
+		} else if (streq(arg, "-G")) {
+			append_option(&other_options, arg);
+			append_option(&other_options, argv[++argno]);
+#endif
+		} else if (streq(arg, "-shared") || streq(arg, "-G")) {
 			want_shared = 1;
 		} else if (streqn(arg, "-o")) {
 			output_file = arg[2] ? &arg[2] : argv[++argno];
-- 
