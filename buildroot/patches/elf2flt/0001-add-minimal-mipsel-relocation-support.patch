From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@example.invalid>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] elf2flt: add MIPS/MIPSEL relocation support

Buildroot can be made to select a uClinux target tuple for SF2000, but
elf2flt rejects TARGET_mipsel. Add the baseline architecture wiring and
handle the absolute relocations produced by non-PIC MIPS uClinux binaries.

MIPS call targets and split high/low address loads live inside instructions,
so tag those relocation table entries for the kernel FLAT loader instead of
treating them as ordinary 32-bit words.
---
 elf2flt.c     | 81 ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
 elf2flt.ld.in |  6 +++++
 2 files changed, 87 insertions(+)

diff --git a/elf2flt.c b/elf2flt.c
index 0655375..aaaaaaaa 100644
--- a/elf2flt.c
+++ b/elf2flt.c
@@ -65,6 +65,14 @@ const char *elf2flt_progname;
 #include <elf/m68k.h>
 #elif defined(TARGET_microblaze)
 #include <elf/microblaze.h>
+#elif defined(TARGET_mips) || defined(TARGET_mipsel)
+#include <elf/mips.h>
+#define FLAT_MIPS_R_32		0x00000000
+#define FLAT_MIPS_R_26		0x40000000
+#define FLAT_MIPS_R_HI16	0x80000000
+#define FLAT_MIPS_R_LO16	0xc0000000
+#define FLAT_MIPS_R_MASK	0xc0000000
+#define FLAT_MIPS_R_ADDR	0x3fffffff
 #elif defined(TARGET_nios) || defined(TARGET_nios2)
 /* Altera NIOS specific definitions.  */
 #define FLAT_NIOS2_R_32			0 /* Normal 32-bit reloc */
@@ -120,6 +129,8 @@ const char *elf2flt_progname;
 #define ARCH	"bfin"
 #elif defined(TARGET_nios)
 #define ARCH	"nios"
+#elif defined(TARGET_mips) || defined(TARGET_mipsel)
+#define ARCH	"mips"
 #elif defined(TARGET_nios2)
 #define ARCH	"nios2"
 #elif defined(TARGET_xtensa)
@@ -706,1 +715,23 @@ output_relocs (
+#elif defined(TARGET_mips) || defined(TARGET_mipsel)
+				case R_MIPS_32:
+					goto good_32bit_resolved_reloc;
+				case R_MIPS_26:
+					pflags = FLAT_MIPS_R_26;
+					relocation_needed = 1;
+					update_text = 0;
+					break;
+				case R_MIPS_HI16:
+					pflags = FLAT_MIPS_R_HI16;
+					relocation_needed = 1;
+					update_text = 0;
+					break;
+				case R_MIPS_LO16:
+					pflags = FLAT_MIPS_R_LO16;
+					relocation_needed = 1;
+					update_text = 0;
+					break;
+				case R_MIPS_NONE:
+					continue;
+				default:
+					goto bad_resolved_reloc;
 #elif defined TARGET_bfin
@@ -930,6 +961,54 @@ output_relocs (
 					sym_addr -= q->address;
 					break;
 #endif
+#if defined(TARGET_mips) || defined(TARGET_mipsel)
+				case R_MIPS_32:
+					relocation_needed = 1;
+					sym_vma = elf2flt_bfd_section_vma(sym_section);
+					sym_addr += sym_vma + q->addend;
+					break;
+				case R_MIPS_26:
+				{
+					uint32_t insn = bfd_getl32(r_mem);
+
+					pflags = FLAT_MIPS_R_26;
+					relocation_needed = 1;
+					update_text = 0;
+					sym_vma = elf2flt_bfd_section_vma(sym_section);
+					sym_addr += sym_vma + q->addend;
+					insn = (insn & 0xfc000000) |
+						((sym_addr >> 2) & 0x03ffffff);
+					bfd_putl32(insn, r_mem);
+					break;
+				}
+				case R_MIPS_HI16:
+				{
+					uint32_t insn = bfd_getl32(r_mem);
+
+					pflags = FLAT_MIPS_R_HI16;
+					relocation_needed = 1;
+					update_text = 0;
+					sym_vma = elf2flt_bfd_section_vma(sym_section);
+					sym_addr += sym_vma + q->addend;
+					insn = (insn & 0xffff0000) |
+						(((sym_addr + 0x8000) >> 16) & 0xffff);
+					bfd_putl32(insn, r_mem);
+					break;
+				}
+				case R_MIPS_LO16:
+				{
+					uint32_t insn = bfd_getl32(r_mem);
+
+					pflags = FLAT_MIPS_R_LO16;
+					relocation_needed = 1;
+					update_text = 0;
+					sym_vma = elf2flt_bfd_section_vma(sym_section);
+					sym_addr += sym_vma + q->addend;
+					insn = (insn & 0xffff0000) | (sym_addr & 0xffff);
+					bfd_putl32(insn, r_mem);
+					break;
+				}
+#endif
 
 #if defined(TARGET_arm)
 				case R_ARM_ABS32:
 					relocation_needed = 1;
@@ -1604,6 +1672,17 @@ output_relocs (
 					break;
 #endif
 
+#if defined(TARGET_mips) || defined(TARGET_mipsel)
+				case R_MIPS_26:
+				case R_MIPS_HI16:
+				case R_MIPS_LO16:
+					/*
+					 * The instruction bits were produced above or by the
+					 * resolved ELF link. The tagged FLAT relocation tells
+					 * the kernel how to adjust them at load time.
+					 */
+					break;
+#endif
+
 				default:
 					/* The alignment of the build host
 					   might be stricter than that of the
diff --git a/elf2flt.ld.in b/elf2flt.ld.in
index 49a6f3c..1fed6d8 100644
--- a/elf2flt.ld.in
+++ b/elf2flt.ld.in
@@ -188,6 +188,12 @@ TOR:		@SYMBOL_PREFIX@__DTOR_END__ = .;
 		KEEP (*(.fini_array))
 		KEEP (*(SORT(.fini_array.*)))
 		PROVIDE (@SYMBOL_PREFIX@__fini_array_end = .);
+
+		/* MIPS ELF metadata is allocatable, so place it explicitly. */
+		*(.MIPS.abiflags)
+		*(.MIPS.options)
+		*(.reginfo)
+		*(.pdr)
 	} > flatmem :data
 
 	.note.ABI-tag : { *(.note.ABI-tag) } > flatmem
-- 
2.45.0
