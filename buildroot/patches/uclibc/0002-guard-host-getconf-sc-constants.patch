From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sf2000-linux <sf2000-linux@local>
Date: Wed, 13 May 2026 00:00:00 +0000
Subject: [PATCH] guard host getconf sc constants

The getconf host utility is built against the host C library.  Alpine's
musl headers do not define a few glibc/uClibc _SC_* names referenced by
the table and unsigned-result special case.  Guard the optional table
entry and provide private sentinel values for the comparison-only names.
---
 utils/getconf.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/utils/getconf.c b/utils/getconf.c
index e302d2d7b..8a2d9cc61 100644
--- a/utils/getconf.c
+++ b/utils/getconf.c
@@ -27,6 +27,14 @@
 #define error(status, errnum, fmt, ...) \
 	{fprintf(stderr, fmt "\n", ## __VA_ARGS__); exit(status);}
 
+#ifndef _SC_UINT_MAX
+# define _SC_UINT_MAX (-1000001)
+#endif
+
+#ifndef _SC_ULONG_MAX
+# define _SC_ULONG_MAX (-1000002)
+#endif
+
 
 struct conf
   {
@@ -436,7 +444,9 @@ static const struct conf vars[] =
 #ifdef _SC_BC_STRING_MAX
     { "BC_STRING_MAX", _SC_BC_STRING_MAX, SYSCONF },
 #endif
+#ifdef _SC_CHARCLASS_NAME_MAX
     { "CHARCLASS_NAME_MAX", _SC_CHARCLASS_NAME_MAX, SYSCONF },
+#endif
 #ifdef _SC_COLL_WEIGHTS_MAX
     { "COLL_WEIGHTS_MAX", _SC_COLL_WEIGHTS_MAX, SYSCONF },
 #endif
-- 
