// SPDX-License-Identifier: MIT
/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "frog,sf2000", "hichip,hc15xx";
	model = "Data Frog SF2000";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		rng-seed = /bits/ 8 <
			0x73 0x66 0x32 0x30 0x30 0x30 0x5f 0x6c
			0x69 0x6e 0x75 0x78 0x5f 0x62 0x72 0x69
			0x6e 0x67 0x75 0x70 0x5f 0x73 0x65 0x65
			0x64 0x5f 0x30 0x30 0x30 0x30 0x30 0x31
		>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "mips,mips24Kc", "img,mips";
			reg = <0>;
			clocks = <&cpu_clk>;
		};
	};

	cpu_clk: cpu-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <918000000>;
	};

	uart_clk: uart-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x08000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gma_scratch: framebuffer@f00000 {
			reg = <0x00f00000 0x00100000>;
			no-map;
		};
	};

	cpuintc: interrupt-controller {
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
		compatible = "mti,cpu-interrupt-controller";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		uart1: serial@18818600 {
			compatible = "ns16550a";
			reg = <0x18818600 0x8>;
			reg-shift = <0>;
			reg-io-width = <1>;
			current-speed = <115200>;
			clocks = <&uart_clk>;
			interrupt-parent = <&cpuintc>;
			interrupts = <3>;
			no-loopback-test;
			status = "okay";
		};
	};
};
